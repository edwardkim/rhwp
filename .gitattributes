# SVG 골든 스냅샷 — 렌더러 생성물(LF)과 바이트 비교하므로 CRLF 변환 금지 (#1786)
tests/golden_svg/**/*.svg text eol=lf

# Lawful HML corpus — preserve provenance bytes (BOM/CRLF/trailing spaces) and verify by SHA
samples/hml/*.hml -text -diff

# Fuzz seeds are raw parser inputs. CRLF/smudge would change coverage hashes.
fuzz/corpus/** -text -diff

# POC TSV는 마지막 빈 열을 tab으로 표현한다. 이 필드는 데이터 스키마의 일부이므로
# trailing-whitespace 오류로 취급하지 않는다.
output/poc/**/*.tsv -whitespace

# [#5795] 스킬 마크다운은 계약이 바이트로 검사된다 (frontmatter 를 개행까지 포함해 본다).
# 체크아웃 개행이 플랫폼마다 갈리면 같은 커밋이 Windows 에서만 빨개진다.
.claude/skills/**/*.md text eol=lf
.agents/skills/**/*.md text eol=lf

# Agent skill fixture TSV/CSV는 끝 빈 열 또는 CRLF 입력 자체가 계약이다.
.claude/skills/rhwp-fde/fixtures/tsv/*.tsv -whitespace
.claude/skills/rhwp-table-exchange/fixtures/csv/table0_control_lf.csv -whitespace
.claude/skills/rhwp-visual-regression/fixtures/tsv/*.tsv -whitespace
.claude/skills/rhwp-visual-regression/references/_gen_pack.py -whitespace

# 이 파일은 재현용 unified diff 자체다. 내부 hunk의 공백 문맥은 패치 문법이므로
# Git의 일반 source-whitespace 검사를 적용하지 않는다.
mydocs/report/task3798/trimcap_experiment.patch -whitespace

# [#4659] 운동장 리더보드 — 해시 정합이 생명인 파일들. CRLF 변환은 원장에
# 박힌 줄-바이트 해시를 깨뜨려 검증을 실패시킨다. LF 고정(-text).
gym/leaderboard/**/*.json    -text
gym/leaderboard/**/*.ndjson  -text
gym/leaderboard/*.ndjson     -text

# [#5447] 한컴 판정 자산 — 한컴 2022 가 실제로 연 바이트이고, 그 SHA-256 이
# samples/issue5447/MANIFEST.json 에 박혀 있다. 자동 감지에 맡기지 않고 못박는다.
samples/issue5447/*.hwp   -text -diff
samples/issue5447/*.hwpx  -text -diff
pdf/issue5447/*.pdf       -text -diff

# #5057/#6202 회귀 입력은 한컴 원본 바이트다. 텍스트 변환이나 diff 정규화가
# manifest의 SHA-256과 parser 재현성을 바꾸면 안 된다.
samples/issue5057/*.hwp -text -diff
samples/issue6202/*.hwp -text -diff

# Issue #5941 canonical HWP fixture
samples/issue5941/1480000-201900698-native-neartop-reset.hwp -text -diff

# #6697/#6718 회귀 입력은 원본 한컴 바이트다. 텍스트 변환이나 diff 정규화가
# manifest의 SHA-256과 renderer 재현성을 바꾸면 안 된다.
samples/issue6697/*.hwpx -text -diff
samples/issue6718/*.hwp -text -diff
