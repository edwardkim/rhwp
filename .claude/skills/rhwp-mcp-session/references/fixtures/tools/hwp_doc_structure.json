{
  "name": "hwp_doc_structure",
  "kind": "session",
  "in_capabilities_mcp": false,
  "in_tools_list": true,
  "family": "query",
  "required": [
    "docId"
  ],
  "optional": [
    "mode"
  ],
  "envelope_fields": [
    "schemaVersion",
    "source",
    "mode",
    "nodeCount",
    "structure"
  ],
  "writes_ir": false,
  "writes_disk": false,
  "idempotentHint": true,
  "destructiveHint": false,
  "stateless_twin": "hwp_export_structure",
  "when": "법령·규정 조문 계층을 세션 안에서 반복 인용할 때.",
