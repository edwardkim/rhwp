  "recovery": "nextCall 로 hwp_open.",
  "sample_call": {
    "method": "tools/call",
    "params": {
      "name": "hwp_doc_structure",
      "arguments": {
        "docId": "<docId>"
      }
    }
  },
  "closed_handle_signal": {
    "isError": true,
    "needle": "열려 있지 않은 핸들",
