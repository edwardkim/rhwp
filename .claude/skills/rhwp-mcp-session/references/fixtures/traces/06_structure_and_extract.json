{
  "id": "06_structure_and_extract",
  "title": "조문 계층과 날짜·금액을 한 핸들에서 반복 조회한다.",
  "kind": "session",
  "lifecycle": "hwp_open → doc_* → hwp_close",
  "absolute_paths": true,
  "single_write_point": "hwp_doc_save",
  "steps": [
    {
      "seq": 1,
      "tool": "hwp_open",
      "arguments": {
        "path": "C:/abs/규정.hwp"
      },
      "expect_layer": "ok",
      "read_fields": [
        "docId"
      ],
      "notes": ""
    },
    {
      "seq": 2,
      "tool": "hwp_doc_structure",
      "arguments": {
        "docId": "doc-1",
        "mode": "clause"
      },
      "expect_layer": "ok",
      "read_fields": [
        "structure"
      ],
      "notes": ""
    },
    {
      "seq": 3,
      "tool": "hwp_doc_extract_data",
      "arguments": {
        "docId": "doc-1",
        "kind": "amount",
        "limit": 20
      },
      "expect_layer": "ok",
      "read_fields": [
        "items",
        "totalItemCount"
      ],
      "notes": ""
    },
    {
      "seq": 4,
      "tool": "hwp_close",
      "arguments": {
        "docId": "doc-1"
      },
      "expect_layer": "ok",
      "read_fields": [
        "closed"
      ],
      "notes": ""
    }
  ]
}
