{
  "id": "03_fill_render_save_close",
  "title": "서식 채움 — 조사→채움→눈검증→저장. 디스크는 save 한 번.",
  "kind": "session",
  "lifecycle": "hwp_open → doc_* → hwp_close",
  "absolute_paths": true,
  "single_write_point": "hwp_doc_save",
  "steps": [
    {
      "seq": 1,
      "tool": "hwp_open",
      "arguments": {
        "path": "C:/abs/서식.hwp"
      },
      "expect_layer": "ok",
      "read_fields": [
        "docId"
      ],
      "notes": ""
    },
    {
      "seq": 2,
      "tool": "hwp_doc_fields",
      "arguments": {
        "docId": "doc-1"
      },
      "expect_layer": "ok",
      "read_fields": [
        "fields"
      ],
      "notes": ""
    },
    {
      "seq": 3,
      "tool": "hwp_doc_fill_fields",
      "arguments": {
        "docId": "doc-1",
        "data": {
          "회사명": "페타플로"
        }
      },
      "expect_layer": "envelope",
      "read_fields": [
        "filledCount",
        "notFound",
        "changedPages"
      ],
      "notes": ""
    },
    {
      "seq": 4,
      "tool": "hwp_doc_render_page",
      "arguments": {
        "docId": "doc-1",
        "page": 0,
        "output": "C:/abs/out/p0.svg"
      },
      "expect_layer": "ok",
      "read_fields": [
        "output"
      ],
      "notes": ""
    },
    {
      "seq": 5,
      "tool": "hwp_doc_save",
      "arguments": {
        "docId": "doc-1",
        "output": "C:/abs/out/저장본.hwp",
        "verify": true
      },
      "expect_layer": "ok",
      "read_fields": [
        "output",
        "verify"
      ],
      "notes": ""
    },
    {
      "seq": 6,
      "tool": "hwp_close",
      "arguments": {
        "docId": "doc-1"
      },
      "expect_layer": "ok",
      "read_fields": [
        "closed"
      ],
      "notes": ""
    }
  ]
}
