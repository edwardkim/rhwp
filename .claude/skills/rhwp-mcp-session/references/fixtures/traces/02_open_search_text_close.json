{
  "id": "02_open_search_text_close",
  "title": "대형 문서 반복 조회 — 검색으로 쪽을 좁힌 뒤 본문을 읽는다.",
  "kind": "session",
  "lifecycle": "hwp_open → doc_* → hwp_close",
  "absolute_paths": true,
  "single_write_point": "hwp_doc_save",
  "steps": [
    {
      "seq": 1,
      "tool": "hwp_open",
      "arguments": {
        "path": "C:/abs/편람.hwp"
      },
      "expect_layer": "ok",
      "read_fields": [
        "docId"
      ],
      "notes": ""
    },
    {
      "seq": 2,
      "tool": "hwp_doc_search",
      "arguments": {
        "docId": "doc-1",
        "query": "위임전결"
      },
      "expect_layer": "ok",
      "read_fields": [
        "matches"
      ],
      "notes": ""
    },
    {
      "seq": 3,
      "tool": "hwp_doc_text",
      "arguments": {
        "docId": "doc-1",
        "page": 41
      },
      "expect_layer": "ok",
      "read_fields": [
        "pages"
      ],
      "notes": ""
    },
    {
      "seq": 4,
      "tool": "hwp_close",
      "arguments": {
        "docId": "doc-1"
      },
      "expect_layer": "ok",
      "read_fields": [
        "closed"
      ],
      "notes": ""
    }
  ]
}
