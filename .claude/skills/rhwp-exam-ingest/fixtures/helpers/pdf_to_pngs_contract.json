{
  "schemaVersion": "1.0",
  "helper": "pdf_to_pngs.sh",
  "usage": "pdf_to_pngs.sh [--json] [--dry-run] <input.pdf> <out_dir> [<dpi>]",
  "dpiDefault": 300,
  "dpiRange": [
    72,
    600
  ],
  "pagePattern": "page_%03d.png",
  "engines": [
    "pdftoppm",
    "magick",
    "convert"
  ],
  "codes": [
    "PDF_OK",
    "PDF_ARGS",
    "PDF_SRC_MISSING",
    "PDF_MISS_TOOLS",
    "PDF_DPI_RANGE"
  ]
}
