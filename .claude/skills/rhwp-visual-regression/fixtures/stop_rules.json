{
  "schemaVersion": "1.0",
  "issue": 5312,
  "rules": [
    {
      "id": "F01",
      "when": "status PASS",
      "action": "끝. 다음 단 금지"
    },
    {
      "id": "F02",
      "when": "A==A 가 PASS 아님",
      "action": "도구 비결정성. 중단"
    },
    {
      "id": "F03",
      "when": "STRUCT + 경로가 편집 위치",
      "action": "정상. 실패로 읽지 않음"
    },
    {
      "id": "F04",
      "when": "STRUCT + 경로가 무관",
      "action": "진짜 회귀"
    },
    {
      "id": "F05",
      "when": "PAGE_MISMATCH",
      "action": "dump-pages 로 좁힘"
    },
    {
      "id": "F06",
      "when": "OVER",
      "action": "worst_page 로 좁힘"
    },
    {
      "id": "F07",
      "when": "LOAD_FAIL",
      "action": "info 로 그 파일만"
    },
    {
      "id": "F08",
      "when": "ir-diff --json exit 3",
      "action": "차이 검출은 데이터"
    },
    {
      "id": "F09",
      "when": "눈 검증 필요",
      "action": "export-png. thumbnail 은 저장본"
    },
    {
      "id": "F10",
      "when": "배치 TSV 혼합",
      "action": "행별 status 로 격리"
    },
    {
      "id": "F11",
      "when": "질문이 이미 답",
      "action": "다음 단 금지"
    },
    {
      "id": "F12",
      "when": "WARN_TEXTRUN",
      "action": "하드 실패 아님"
    }
  ]
}
