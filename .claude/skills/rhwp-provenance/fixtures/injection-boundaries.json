{
  "schemaVersion": "1.0",
  "issue": 5295,
  "boundaries": [
    {
      "id": "B1",
      "name": "읽기 턴 쓰기 도구 제거",
      "modelIndependent": true,
      "must": "문서를 읽은 턴의 tools/list 에 edit/run/fill/replace/set-cell/네트워크가 없다.",
      "failIf": "같은 턴에 쓰기 도구가 남아 있다."
    },
    {
      "id": "B2",
      "name": "산출 경로 선확정",
      "modelIndependent": true,
      "must": "출력 경로 문자열이 어떤 D 필드에서도 오지 않는다.",
      "failIf": "title/캡션/셀 텍스트로 파일 이름을 만든다."
    },
    {
      "id": "B3",
      "name": "전송 사람 승인",
      "modelIndependent": true,
      "must": "메일·HTTP·메신저 전송에 사람 승인 기록이 있다.",
      "failIf": "findings[].detail 을 목적지 URL 로 연다."
    },
    {
      "id": "B4",
      "name": "계획은 코드 또는 사람",
      "modelIndependent": false,
      "must": "run 계획서의 steps 뼈대가 문서에서 오지 않는다.",
      "failIf": "fields[].command 나 본문을 steps 로 파싱한다."
    },
    {
      "id": "B5",
      "name": "신호 후 정지",
      "modelIndependent": true,
      "must": "inspect/textSecurity 신호 이후 같은 source 를 반복 호출하지 않는다.",
      "failIf": "clean:false 를 로그하고 export-text 를 계속한다."
    }
  ],
  "commandGroups": {
    "본문-반출": {
      "commands": [
        "export-text",
        "export-structure",
        "digest",
        "search",
        "export-tables",
        "table-to-csv",
        "dump-pages",
        "header-footer"
      ],
      "required": ["B1", "B2", "B3"]
    },
    "서식-메타": {
      "commands": ["fields", "form-value", "explain", "bookmarks", "info"],
      "required": ["B1", "B2", "B3", "B4"]
    },
    "보안-발췌": {
      "commands": ["inspect", "armor", "threat-scan", "scan"],
      "required": ["B1", "B3", "B5"]
    },
    "편집-저널": {
      "commands": ["edit", "run", "csv-to-table", "csv-to-chart", "verify"],
      "required": ["B2", "B3", "B4", "B5"]
    },
    "특수-표면": {
      "commands": ["thumbnail", "ir-diff", "chart-to-csv", "extract-data", "batch"],
      "required": ["B1", "B2", "B3"]
    },
    "엔진-전용": {
      "commands": [
        "capabilities",
        "export-provenance-map",
        "export-svg",
        "export-pdf",
        "export-markdown",
        "convert",
        "replay"
      ],
      "required": []
    }
  },
  "inspectLinkage": {
    "command": "inspect injection",
    "requiredFlagForForms": "--include-fields",
    "engineFields": ["clean", "signalCount", "highestConfidence", "scanScopes"],
    "documentFields": [
      "injectionSignals[].excerpt",
      "injectionSignals[].matched"
    ],
    "afterSignal": "halt"
  }
