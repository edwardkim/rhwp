{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edwardkim/rhwp/blob/devel/assets/font-rules/font_rule_registry_v2.schema.json",
  "title": "rhwp canonical font rule lifecycle registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "issue",
    "sourceCommit",
    "schema",
    "sealedV1Registry",
    "appliedChangeSets",
    "summary",
    "evidenceRecords",
    "rulesSha256",
    "rules"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "kind": { "const": "canonical-font-rule-lifecycle-registry" },
    "issue": { "const": 5955 },
    "sourceCommit": { "$ref": "#/$defs/sha1" },
    "schema": { "$ref": "#/$defs/pathDigest" },
    "sealedV1Registry": { "$ref": "#/$defs/pathDigest" },
    "appliedChangeSets": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/changeSetRef" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleCount", "activeRuleCount", "retiredRuleCount", "countsByProjection"],
      "properties": {
        "ruleCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "activeRuleCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "retiredRuleCount": { "type": "integer", "minimum": 0, "maximum": 4096 },
        "countsByProjection": { "$ref": "#/$defs/countMap" }
      }
    },
    "evidenceRecords": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/evidenceRecord" }
    },
    "rulesSha256": { "$ref": "#/$defs/sha256" },
    "rules": {
      "type": "array",
      "maxItems": 4096,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "nullableString": {
      "oneOf": [{ "$ref": "#/$defs/nonEmptyString" }, { "type": "null" }]
    },
    "pathDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "changeSetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changeSetId", "path", "sha256"],
      "properties": {
        "changeSetId": { "$ref": "#/$defs/identifier" },
        "path": { "$ref": "#/$defs/nullableString" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "countMap": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 4096 }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "languageSlot": { "$ref": "#/$defs/nullableString" },
        "altType": { "$ref": "#/$defs/nullableString" },
        "availability": { "$ref": "#/$defs/nullableString" },
        "profile": { "$ref": "#/$defs/nullableString" }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode"],
      "properties": {
        "id": { "$ref": "#/$defs/projectionId" },
        "mode": { "enum": ["direct", "legacy-preservation"] }
      }
    },
    "projectionId": {
      "enum": [
        "rust-layout-name",
        "rust-layout-metric",
        "canvas2d-paint",
        "canvas2d-webfont",
        "canvaskit-sfnt"
      ]
    },
    "cssSupply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "fontFamily", "sourceUrl", "format", "unicodeRange", "external"],
      "properties": {
        "kind": { "const": "canvas2d-webfont" },
        "fontFamily": { "$ref": "#/$defs/nonEmptyString" },
        "sourceUrl": { "$ref": "#/$defs/nonEmptyString" },
        "format": { "enum": ["woff2", "woff", "truetype", "opentype"] },
        "unicodeRange": { "$ref": "#/$defs/nullableString" },
        "external": { "type": "boolean" }
      }
    },
    "fontPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "unavailableFonts"],
      "properties": {
        "sources": {
          "type": "array",
          "maxItems": 153,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "aliases"],
            "properties": {
              "url": { "$ref": "#/$defs/nonEmptyString" },
              "aliases": {
                "type": "array",
                "minItems": 1,
                "maxItems": 153,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/nonEmptyString" }
              }
            }
          }
        },
        "unavailableFonts": {
          "type": "array",
          "maxItems": 153,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "canvasKitSupply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fontFamily",
        "declaredCapability",
        "runtimePlanStatus",
        "capabilityAgreement",
        "online",
        "offline"
      ],
      "properties": {
        "kind": { "const": "canvaskit-plan" },
        "fontFamily": { "$ref": "#/$defs/nonEmptyString" },
        "declaredCapability": { "enum": ["sfnt-source", "unavailable"] },
        "runtimePlanStatus": { "enum": ["planned", "unavailable"] },
        "capabilityAgreement": { "type": "boolean" },
        "online": { "$ref": "#/$defs/fontPlan" },
        "offline": { "$ref": "#/$defs/fontPlan" }
      }
    },
    "supply": {
      "oneOf": [
        { "$ref": "#/$defs/cssSupply" },
        { "$ref": "#/$defs/canvasKitSupply" },
        { "type": "null" }
      ]
    },
    "legacyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "w1RuleId",
        "candidateIds",
        "sourceBoundaryIds",
        "evidenceStatus",
        "baselineProjectionSha256"
      ],
      "properties": {
        "w1RuleId": { "$ref": "#/$defs/nonEmptyString" },
        "candidateIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "sourceBoundaryIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "evidenceStatus": {
          "enum": ["verified-by-bytes", "verified-by-test", "historical", "unknown"]
        },
        "baselineProjectionSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "legacyEvidenceOrNull": {
      "oneOf": [{ "$ref": "#/$defs/legacyEvidence" }, { "type": "null" }]
    },
    "evidenceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "kind", "source", "sha256", "parentEvidenceIds"],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["sealed-v1", "public-fixture", "public-source", "aggregate-measurement"] },
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "licenseOrProvenance": { "$ref": "#/$defs/nullableString" },
        "parentEvidenceIds": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "introducedBy",
        "lastEvidenceChangeBy",
        "retiredBy",
        "retirementReason",
        "successorRuleIds",
        "predecessorRuleIds"
      ],
      "properties": {
        "introducedBy": { "$ref": "#/$defs/identifier" },
        "lastEvidenceChangeBy": { "$ref": "#/$defs/nullableString" },
        "retiredBy": { "$ref": "#/$defs/nullableString" },
        "retirementReason": { "$ref": "#/$defs/nullableString" },
        "successorRuleIds": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "predecessorRuleIds": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "relationType",
        "decisionPlane",
        "sourceFace",
        "targetFaceOrPolicy",
        "conditions",
        "order",
        "projections",
        "projectionSequence",
        "metricEntryIds",
        "supply",
        "evidence",
        "evidenceIds",
        "selectionTupleSha256",
        "status",
        "lifecycle"
      ],
      "properties": {
        "ruleId": { "$ref": "#/$defs/identifier" },
        "relationType": {
          "enum": [
            "document-substitution",
            "official-successor",
            "metric-surrogate",
            "paint-substitute",
            "style-fallback",
            "generic-fallback",
            "supply-source",
            "capability-detection",
            "unknown"
          ]
        },
        "decisionPlane": { "enum": ["layout-name", "layout-metric", "paint", "supply", "detection"] },
        "sourceFace": { "$ref": "#/$defs/nullableString" },
        "targetFaceOrPolicy": { "$ref": "#/$defs/nonEmptyString" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "order": { "type": ["integer", "null"], "minimum": 0 },
        "projections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/projection" }
        },
        "projectionSequence": { "type": "integer", "minimum": 0, "maximum": 4095 },
        "metricEntryIds": {
          "type": "array",
          "maxItems": 600,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^font-metric\\.[0-9a-f]{20}$" }
        },
        "supply": { "$ref": "#/$defs/supply" },
        "evidence": { "$ref": "#/$defs/legacyEvidenceOrNull" },
        "evidenceIds": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "selectionTupleSha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["active", "retired"] },
        "lifecycle": { "$ref": "#/$defs/lifecycle" }
      }
    }
  }
}
