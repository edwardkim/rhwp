{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edwardkim/rhwp/blob/devel/assets/font-rules/font_rule_registry.schema.json",
  "title": "rhwp canonical font rule registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "issue",
    "sourceCommit",
    "schema",
    "inputs",
    "summary",
    "rulesSha256",
    "rules"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "canonical-font-rule-registry" },
    "issue": { "const": 4966 },
    "sourceCommit": { "$ref": "#/$defs/sha1" },
    "schema": { "$ref": "#/$defs/pathDigest" },
    "inputs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/pathDigest" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleCount",
        "activeUnknownLegacyPreservationCount",
        "metricEntryReferenceCount",
        "countsByProjection",
        "countsByRelation"
      ],
      "properties": {
        "ruleCount": { "const": 830 },
        "activeUnknownLegacyPreservationCount": { "const": 43 },
        "metricEntryReferenceCount": { "type": "integer", "minimum": 1 },
        "countsByProjection": { "$ref": "#/$defs/countMap" },
        "countsByRelation": { "$ref": "#/$defs/countMap" }
      }
    },
    "rulesSha256": { "$ref": "#/$defs/sha256" },
    "rules": {
      "type": "array",
      "minItems": 830,
      "maxItems": 830,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonEmptyString": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "nullableString": {
      "oneOf": [
        { "$ref": "#/$defs/nonEmptyString" },
        { "type": "null" }
      ]
    },
    "pathDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "countMap": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "languageSlot": { "$ref": "#/$defs/nullableString" },
        "altType": { "$ref": "#/$defs/nullableString" },
        "availability": { "$ref": "#/$defs/nullableString" },
        "profile": { "$ref": "#/$defs/nullableString" }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode"],
      "properties": {
        "id": {
          "enum": [
            "rust-layout-name",
            "rust-layout-metric",
            "canvas2d-paint",
            "canvas2d-webfont",
            "canvaskit-sfnt"
          ]
        },
        "mode": { "enum": ["direct", "legacy-preservation"] }
      }
    },
    "cssSupply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fontFamily",
        "sourceUrl",
        "format",
        "unicodeRange",
        "external"
      ],
      "properties": {
        "kind": { "const": "canvas2d-webfont" },
        "fontFamily": { "$ref": "#/$defs/nonEmptyString" },
        "sourceUrl": { "$ref": "#/$defs/nonEmptyString" },
        "format": { "enum": ["woff2", "woff", "truetype", "opentype"] },
        "unicodeRange": { "$ref": "#/$defs/nullableString" },
        "external": { "type": "boolean" }
      }
    },
    "fontPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "unavailableFonts"],
      "properties": {
        "sources": {
          "type": "array",
          "maxItems": 153,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "aliases"],
            "properties": {
              "url": { "$ref": "#/$defs/nonEmptyString" },
              "aliases": {
                "type": "array",
                "minItems": 1,
                "maxItems": 153,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/nonEmptyString" }
              }
            }
          }
        },
        "unavailableFonts": {
          "type": "array",
          "maxItems": 153,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "canvasKitSupply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "fontFamily",
        "declaredCapability",
        "runtimePlanStatus",
        "capabilityAgreement",
        "online",
        "offline"
      ],
      "properties": {
        "kind": { "const": "canvaskit-plan" },
        "fontFamily": { "$ref": "#/$defs/nonEmptyString" },
        "declaredCapability": { "enum": ["sfnt-source", "unavailable"] },
        "runtimePlanStatus": { "enum": ["planned", "unavailable"] },
        "capabilityAgreement": { "type": "boolean" },
        "online": { "$ref": "#/$defs/fontPlan" },
        "offline": { "$ref": "#/$defs/fontPlan" }
      }
    },
    "supply": {
      "oneOf": [
        { "$ref": "#/$defs/cssSupply" },
        { "$ref": "#/$defs/canvasKitSupply" },
        { "type": "null" }
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "w1RuleId",
        "candidateIds",
        "sourceBoundaryIds",
        "evidenceStatus",
        "baselineProjectionSha256"
      ],
      "properties": {
        "w1RuleId": { "$ref": "#/$defs/nonEmptyString" },
        "candidateIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "sourceBoundaryIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "evidenceStatus": {
          "enum": ["verified-by-bytes", "verified-by-test", "historical", "unknown"]
        },
        "baselineProjectionSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "relationType",
        "decisionPlane",
        "sourceFace",
        "targetFaceOrPolicy",
        "conditions",
        "order",
        "projections",
        "metricEntryIds",
        "supply",
        "evidence",
        "status"
      ],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "relationType": {
          "enum": [
            "document-substitution",
            "official-successor",
            "metric-surrogate",
            "paint-substitute",
            "style-fallback",
            "generic-fallback",
            "supply-source",
            "capability-detection",
            "unknown"
          ]
        },
        "decisionPlane": { "enum": ["layout-name", "layout-metric", "paint", "supply", "detection"] },
        "sourceFace": { "$ref": "#/$defs/nullableString" },
        "targetFaceOrPolicy": { "$ref": "#/$defs/nonEmptyString" },
        "conditions": { "$ref": "#/$defs/conditions" },
        "order": { "type": ["integer", "null"], "minimum": 0 },
        "projections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/projection" }
        },
        "metricEntryIds": {
          "type": "array",
          "maxItems": 600,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^font-metric\\.[0-9a-f]{20}$" }
        },
        "supply": { "$ref": "#/$defs/supply" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "status": { "const": "active" }
      }
    }
  }
}
