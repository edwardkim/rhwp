// 타입 검사 기준 설정 (`npm run typecheck` 이 그대로 쓴다).
//
// 엄격 옵션을 **전부** 켜는 이유가 이 파일의 존재 이유다. 이 바인딩은 CLI 봉투를
// 재포장하는 층이고, 봉투는 `null`(검증 안 함)과 `false`(검증 실패), `undefined`
// (모름)와 `[]`(없음)을 구분하는 계약을 갖는다. 느슨한 타입은 그 구분을 조용히
// 뭉갠 뒤 런타임에야 드러난다 — 컴파일러가 먼저 잡게 한다.
{
  "compilerOptions": {
    // Node 18 이 지원하는 최신 문법 수준. 다운레벨 변환이 없어야 스택 트레이스와
    // `class` 상속(예외 계층)이 원본 그대로 남는다.
    "target": "ES2022",
    "module": "ESNext",
    // 번들러(tsup/esbuild)가 실제 해석을 담당하므로 확장자 없는 상대 import 를 허용한다.
    "moduleResolution": "Bundler",
    // `Symbol.asyncDispose` 는 세션·Document 의 `await using` 계약에 쓰인다.
    "lib": ["ES2022", "ESNext.Disposable"],
    "types": ["node"],
    // 예제가 소비자와 똑같이 `@rhwp/node` 로 import 하면서도 빌드 산출물 없이
    // 검사되도록 자기 자신을 소스로 매핑한다. 예제만 다른 import 경로를 쓰면
    // 그 예제는 실제로 동작하는지 증명하지 못한다.
    "paths": {
      "@rhwp/node": ["./src/index.ts"],
      "@rhwp/node/browser": ["./src/browser.ts"]
    },

    // --- 엄격성: 아래 네 개가 이 바인딩의 계약을 지킨다 ---
    "strict": true,
    // 봉투는 `pages[0]` 같은 인덱스 접근이 잦다. 배열이 비었을 가능성을 타입에
    // 남겨야 "빈 결과"를 성공으로 오독하지 않는다.
    "noUncheckedIndexedAccess": true,
    // `{ verify?: VerifyReport }` 에 `undefined` 를 **대입할 수 있는지**와 키가
    // **없는지**는 다른 상태다. 옵션 필드로 판정을 나르는 이상 이 구분이 필요하다.
    "exactOptionalPropertyTypes": true,
    // 예외 계층(RhwpError → UsageError ...)에서 오버라이드를 명시하게 한다.
    // `toString`/`message` 를 실수로 가리면 진단 원문이 사라진다.
    "noImplicitOverride": true,

    // --- 사고를 줄이는 나머지 검사 ---
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,

    // 파일 단위 트랜스파일(esbuild)과 타입 검사 결과가 갈라지지 않게 한다.
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    // 선언 파일은 빌드 전용 설정에서만 만든다. 여기서는 검사만 한다.
    "noEmit": true,
    // 의존성 0 이라 검사할 외부 d.ts 는 @types/node 뿐이다. 그래도 건너뛴다 —
    // 우리 코드가 아닌 곳의 오류로 게이트가 흔들리면 게이트를 믿지 않게 된다.
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "tools/**/*.ts", "examples/**/*.ts", "*.ts"],
  "exclude": ["dist", "node_modules"]
}
