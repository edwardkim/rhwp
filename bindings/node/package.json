{
  "name": "@rhwp/node",
  "version": "0.1.0",
  "description": "HWP/HWPX 문서 엔진 rhwp 의 Node/TypeScript 바인딩 — CLI --json 봉투와 mcp-serve 세션 계약의 재포장",
  "type": "module",
  "license": "MIT",
  "author": "Edward Kim",
  "homepage": "https://edwardkim.github.io/rhwp/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edwardkim/rhwp.git",
    "directory": "bindings/node"
  },
  "bugs": {
    "url": "https://github.com/edwardkim/rhwp/issues"
  },
  "funding": "https://github.com/sponsors/edwardkim",
  "keywords": [
    "hwp",
    "hwpx",
    "hancom",
    "hangul",
    "한글",
    "document",
    "korean",
    "office",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node tools/emit-cjs-types.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "gen:types": "tsx tools/gen-types.ts",
    "gen:check": "tsx tools/gen-types.ts --check"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.3.0",
    "tsx": "^4.8.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  },
  "tsup": {
    "entry": [
      "src/index.ts",
      "src/browser.ts"
    ],
    "format": [
      "esm",
      "cjs"
    ],
    "tsconfig": "tsconfig.build.json",
    "target": "es2022",
    "platform": "node",
    "outDir": "dist",
    "dts": false,
    "sourcemap": true,
    "clean": true,
    "splitting": false,
    "treeshake": true
  }
}
