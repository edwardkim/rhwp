diff --git a/packages/cli/src/build/builder.rs b/packages/cli/src/build/builder.rs
index 2e4fc9be..88b2b844 100644
--- a/packages/cli/src/build/builder.rs
+++ b/packages/cli/src/build/builder.rs
@@ -29,0 +30,47 @@ use super::{BuildContext, BuildId, BuildMode, HotpatchModuleCache};
+fn tip_patch_crates(
+    tip: &str,
+    dependencies: &HashSet<String>,
+    changed: Vec<String>,
+    mut dependents_of: impl FnMut(&str) -> Vec<String>,
+) -> HashSet<String> {
+    let mut selected = HashSet::from([tip.to_string()]);
+    let mut pending = changed;
+    let mut visited = HashSet::new();
+    while let Some(name) = pending.pop() {
+        if !visited.insert(name.clone()) || (name != tip && !dependencies.contains(&name)) {
+            continue;
+        }
+        selected.insert(name.clone());
+        pending.extend(
+            dependents_of(&name)
+                .into_iter()
+                .filter(|dependent| dependent != tip && dependencies.contains(dependent)),
+        );
+    }
+    selected
+}
+
+#[cfg(test)]
+mod patch_tests {
+    use super::*;
+
+    #[test]
+    fn tip_patch_selection_excludes_unrelated_workspace_apps() {
+        let dependencies = HashSet::from(["changed".to_string(), "inside".to_string()]);
+        let selected =
+            tip_patch_crates(
+                "tip",
+                &dependencies,
+                vec!["changed".into()],
+                |name| match name {
+                    "changed" => vec!["inside".into(), "other-app".into()],
+                    _ => vec![],
+                },
+            );
+        assert_eq!(
+            selected,
+            HashSet::from(["tip".into(), "changed".into(), "inside".into()])
+        );
+    }
+}
