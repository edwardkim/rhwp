+struct ReconnectReplayState {
+    messages: [Vec<String>; 2],
+    boot_nonce: String,
+    full_reload_generation: u64,
+}
+
+impl Default for ReconnectReplayState {
+    fn default() -> Self {
+        Self {
+            messages: Default::default(),
+            boot_nonce: uuid::Uuid::new_v4().to_string(),
+            full_reload_generation: 0,
+        }
+    }
+}
+
+impl ReconnectReplayState {
+    fn remember_patch(&mut self, build: BuildId, message: String) {
+        if let Some(slot) = self.messages.get_mut(build.0) {
+            slot.push(message);
+        }
+    }
+
+    fn replay_messages(&self, build: BuildId) -> Vec<Message> {
+        self.messages
+            .get(build.0)
+            .into_iter()
+            .flatten()
+            .map(|message| Message::Text(message.clone().into()))
+            .collect()
+    }
+
+    fn require_full_reload(&mut self) -> String {
+        self.full_reload_generation += 1;
+        let message = serde_json::json!({
+            "RhwpFullReload": format!(
+                "{}:{}",
+                self.boot_nonce,
+                self.full_reload_generation,
+            ),
+        })
+        .to_string();
+        self.messages = [vec![message.clone()], vec![message.clone()]];
+        message
+    }
+}
+
+#[cfg(test)]
+mod patch_tests {
+    use super::*;
+
+    #[test]
+    fn saved_patch_history_replays_in_order_until_full_reload_replaces_it() {
+        let mut cache = ReconnectReplayState {
+            boot_nonce: "first-server".into(),
+            ..Default::default()
+        };
+        cache.remember_patch(BuildId::PRIMARY, "first".into());
+        cache.remember_patch(BuildId::PRIMARY, "latest".into());
+
+        assert_eq!(
+            cache
+                .replay_messages(BuildId::PRIMARY)
+                .into_iter()
+                .map(|message| match message {
+                    Message::Text(text) => text.to_string(),
+                    other => panic!("unexpected replay message: {other:?}"),
+                })
+                .collect::<Vec<_>>(),
+            ["first", "latest"]
+        );
+        let reload = cache.require_full_reload();
+        for build in [BuildId::PRIMARY, BuildId::SECONDARY] {
+            assert!(
+                matches!(cache.replay_messages(build).as_slice(), [Message::Text(text)] if text == &reload)
+            );
+        }
+        cache.remember_patch(BuildId::PRIMARY, "after-reload".into());
+        assert_eq!(cache.replay_messages(BuildId::PRIMARY).len(), 2);
+        assert_ne!(cache.require_full_reload(), reload);
+
+        let mut restarted = ReconnectReplayState {
+            boot_nonce: "second-server".into(),
+            ..Default::default()
+        };
+        assert_ne!(restarted.require_full_reload(), reload);
+    }
+}
