        "Analyze (javascript-typescript)",
        "Analyze (python)",
        "Analyze (rust)"
      ],
      "requiredSkippedJobs": [],
      "requiredArtifacts": [],
      "allowedEvents": ["workflow_dispatch"],
      "allowedActors": ["edwardkim"]
    },
