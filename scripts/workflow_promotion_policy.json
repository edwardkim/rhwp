      "requiredSkippedJobs": [],
      "requiredArtifacts": [],
      "allowedEvents": ["workflow_dispatch"],
      "allowedActors": ["edwardkim"]
    },
    ".github/workflows/ci.yml": {
      "executionMode": "direct",
      "sensitiveSurfaces": ["cache", "artifact"],
