      "requiredArtifacts": [],
      "allowedEvents": ["workflow_dispatch"],
      "allowedActors": ["edwardkim"]
    },
    ".github/workflows/codeql.yml": {
      "executionMode": "direct",
      "sensitiveSurfaces": ["permissions", "matrix", "security"],
      "requiredJobs": [
