      "executionMode": "verify-only",
      "sensitiveSurfaces": ["permissions", "secrets", "matrix", "artifact", "deployment"],
      "requiredJobs": [
        "Build x86_64-unknown-linux-gnu",
        "Build aarch64-unknown-linux-gnu",
