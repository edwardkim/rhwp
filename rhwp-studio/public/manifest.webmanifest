{
  "id": "/",
  "name": "rhwp-studio",
  "short_name": "rhwp",
  "description": "HWP/HWPX 파일을 열고 편집하는 rhwp-studio",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f3f4f6",
  "theme_color": "#0f172a",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/x-hwp": [
          ".hwp",
          ".hwpx"
        ]
      }
    }
  ],
  "icons": [
    {
      "src": "/logo-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/logo-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
