,{"type":"TextRun","bbox":{"x":137.4,"y":334.9,"w":543.0,"h":16.0},"text":"조정 대상 점포의 매출감소가 코로나 등으로 인한 경제사정 변동으로 인","pi":174}]},{"type":"TextLine","bbox":{"x":113.4,"y":363.7,"w":567.0,"h":16.0},"pi":174,"children":[{"type":"TextRun","bbox":{"x":137.4,"y":363.7,"w":543.0,"h":16.0},"text":"한 상권의 전반적 침체에 기인한 것인지, 대상 점포 영업자의 개별적 사","pi":174}]},{"type":"TextLine","bbox":{"x":113.4,"y":392.5,"w":567.0,"h":16.0},"pi":174,"children":[{"type":"TextRun","bbox":{"x":137.4,"y":392.5,"w":551.3,"h":16.0},"text":"정에 따른 것인지 여부 등을 검토할 수 있는 기준이 되며, 코로나 등의 ","pi":174}]},{"type":"TextLine","bbox":{"x":113.4,"y":421.3,"w":567.0,"h":16.0},"pi":174,"children":[{"type":"TextRun","bbox":{"x":137.4,"y":421.3,"w":551.3,"h":16.0},"text":"재난 상황 이후 해당 상권 내의 공실률 증감, 코로나 등으로 인한 상권 ","pi":174}]},{"type":"TextLine","bbox":{"x":113.4,"y":450.1,"w":567.0,"h":16.0},"pi":174,"children":[{"type":"TextRun","bbox":{"x":137.4,"y":450.1,"w":551.7,"h":16.0},"text":"변동 상황 이후에 신규로 체결된 임대료를 검토하고, 권리금의 증감 내역 ","pi":174}]},{"type":"TextLine","bbox":{"x":113.4,"y":478.9,"w":567.0,"h":16.0},"pi":174,"children":[{"type":"TextRun","bbox":{"x":137.4,"y":478.9,"w":551.6,"h":16.0},"text":"등을 통하여 상권의 특성과 변동내역을 파악하고, 임대료 조정 기준으로 ","pi":174}]},{"type":"TextLine","bbox":{"x":113.4,"y":507.7,"w":567.0,"h":16.0},"pi":174,"children":[{"type":"TextRun","bbox":{"x":137.4,"y":507.7,"w":543.0,"h":16.0},"text":"삼을 수 있음. 통상 상권이 좋을수록 권리금이 높아지고, 권리금이 높아","pi":174}]},{"type":"TextLine","bbox":{"x":113.4,"y":536.5,"w":567.0,"h":16.0},"pi":174,"children":[{"type":"TextRun","bbox":{"x":137.4,"y":536.5,"w":543.0,"h":16.0},"text":"지면서 임대료가 함께 상승하는 추세를 보이며, 상권이 침체될수록 권리","pi":174}]},{"type":"TextLine","bbox":{"x":113.4,"y":565.3,"w":567.0,"h":16.0},"pi":174,"children":[{"type":"TextRun","bbox":{"x":137.4,"y":565.3,"w":543.0,"h":16.0},"text":"금이 우선적으로 감소 또는 소멸하고, 후행적으로 임대료가 감소하는 추","pi":174}]},{"type":"TextLine","bbox":{"x":113.4,"y":594.1,"w":567.0,"h":16.0},"pi":174,"children":[{"type":"TextRun","bbox":{"x":137.4,"y":594.1,"w":76.0,"h":16.0}