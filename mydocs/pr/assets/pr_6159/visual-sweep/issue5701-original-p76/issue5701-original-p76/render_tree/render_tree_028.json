{"type":"Page","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5},"children":[{"type":"PageBg","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5}},{"type":"Header","bbox":{"x":113.4,"y":75.6,"w":567.0,"h":56.7}},{"type":"Body","bbox":{"x":113.4,"y":132.3,"w":567.0,"h":876.9},"children":[{"type":"Column","bbox":{"x":113.4,"y":132.3,"w":567.0,"h":876.9},"col":0,"children":[{"type":"TextLine","bbox":{"x":120.0,"y":132.3,"w":560.3,"h":16.0},"pi":49,"children":[{"type":"TextRun","bbox":{"x":120.0,"y":132.3,"w":356.0,"h":16.0},"text":"재정 공간을 확보하기 위한 정책을 사용하였음. ","pi":49}]},{"type":"TextLine","bbox":{"x":120.0,"y":161.1,"w":560.3,"h":16.0},"pi":50,"children":[{"type":"TextRun","bbox":{"x":120.0,"y":161.1,"w":16.0,"h":16.0},"text":"- ","pi":50},{"type":"TextRun","bbox":{"x":136.0,"y":161.1,"w":544.0,"h":16.0},"text":"유로 지역의 국가들이 무차별적인 현금지원이 아닌 손실에 따른 보상의 개","pi":50}]},{"type":"TextLine","bbox":{"x":120.0,"y":189.9,"w":560.3,"h":16.0},"pi":50,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":189.9,"w":544.0,"h":16.0},"text":"념과 저소득층 및 사회 취약계층을 대상으로 한정하여 현금지원을 한 이유","pi":50}]},{"type":"TextLine","bbox":{"x":120.0,"y":218.7,"w":560.3,"h":16.0},"pi":50,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":218.7,"w":544.0,"h":16.0},"text":"는 미국과 같은 대규모의 직접지급정책이 미래에 불러올 수 있는 재정 건전","pi":50}]},{"type":"TextLine","bbox":{"x":120.0,"y":247.5,"w":560.3,"h":16.0},"pi":50,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":247.5,"w":545.0,"h":16.0},"text":"성의 악화 및 새로운 변화에 대응할 재정 공간의 축소를 우려하기 때문임.","pi":50}]},{"type":"TextLine","bbox":{"x":120.0,"y":305.1,"w":560.3,"h":16.0},"pi":51,"children":[{"type":"TextRun","bbox":{"x":120.0,"y":305.1,"w":16.0,"h":16.0},"text":"- ","pi":51},{"type":"TextRun","bbox":{"x":136.0,"y":305.1,"w":545.0,"h":16.0},"text":"일본은 고용 유지와 생계지원, 대외의존도가 높은 산업의 공급망 재구축 등","pi":51}]},{"type":"TextLine","bbox":{"x":120.0,"y":333.9,"w":560.3,"h":16.0},"pi":51,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":333.9,"w":545.0,"h":16.0},"text":"에 초점을 맞추는 한편, 중앙은행의 양적 완화 확대 및 기업지원 특별 오퍼","pi":51}]},{"type":"TextLine","bbox":{"x":120.0,"y":362.7,"w":560.3,"h":16.0},"pi":51,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":362.7,"w":340.0,"h":16.0},"text":"레이션 등 기업을 지원하기 위한 대책을 추진.","pi":51}]},{"type":"TextLine","bbox":{"x":120.0,"y":391.5,"w":560.3,"h":16.0},"pi":52,"children":[{"type":"TextRun","bbox":{"x":120.0,"y":391.5,"w":16.0,"h":16.0},"text":"- ","pi":52},{"type":"TextRun","bbox":{"x":136.0,"y":391.5,"w":342.0,"h":16.0},"text":"싱가포르는 전체 경기부양책 지출 규모 중 약 ","pi":52},{"type":"TextRun","bbox":{"x":478.0,"y":391.5,"w":28.0,"h":16.0},"text":"67%","pi":52},{"type":"TextRun","bbox":{"x":506.0,"y":391.5,"w":175.0,"h":16.0},"text":"를 현금 지급 및 자영업","pi":52}]},{"type":"TextLine","bbox":{"x":120.0,"y":420.3,"w":560.3,"h":16.0},"pi":52,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":420.3,"w":516.0,"h":16.0},"text":"자 지원 등 가계소득 및 기업의 고용 유지를 위한 직접적인 자금지원.","pi":52}]},{"type":"TextLine","bbox":{"x":120.0,"y":449.1,"w":560.3,"h":16.0},"pi":53,"children":[{"type":"TextRun","bbox":{"x":120.0,"y":449.1,"w":16.0,"h":16.0},"text":"- ","pi":53},{"type":"TextRun","bbox":{"x":136.0,"y":449.1,"w":544.0,"h":16.0},"text":"중국은 생계지원을 위한 현금 지급이 아닌 유동성 공급을 통한 기업의 자금","pi":53}]},{"type":"TextLine","bbox":{"x":120.0,"y":477.9,"w":560.3,"h":16.0},"pi":53,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":477.9,"w":473.0,"h":16.0},"text":"난 해결 및 사회보험 부담을 낮추는 지원정책 등을 통해 코로나 ","pi":53},{"type":"TextRun","bbox":{"x":609.0,"y":477.9,"w":16.0,"h":16.0},"text":"19","pi":53},{"type":"TextRun","bbox":{"x":625.0,"y":477.9,"w":63.7,"h":16.0},"text":"에 의한 ","pi":53}]},{"type":"TextLine","bbox":{"x":120.0,"y":506.7,"w":560.3,"h":16.0},"pi":53,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":506.7,"w":324.0,"h":16.0},"text":"고용 충격을 최소화하는 정책을 주로 추진. ","pi":53}]},{"type":"TextLine","bbox":{"x":120.0,"y":535.5,"w":560.3,"h":16.0},"pi":54,"children":[{"type":"TextRun","bbox":{"x":120.0,"y":535.5,"w":16.0,"h":16.0},"text":"- ","pi":54},{"type":"TextRun","bbox":{"x":136.0,"y":535.5,"w":552.0,"h":16.0},"text":"주요국의 재정정책으로 미국, 이탈리아, 영국, 독일, 호주 등은 긴급 예산을 ","pi":54}]},{"type":"TextLine","bbox":{"x":120.0,"y":564.3,"w":560.3,"h":16.0},"pi":54,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":564.3,"w":545.0,"h":16.0},"text":"마련하여 집행하였음. 미국과 홍콩은 각각 급여세와 개인소득세 감면을 시","pi":54}]},{"type":"TextLine","bbox":{"x":120.0,"y":593.1,"w":560.3,"h":16.0},"pi":54,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":593.1,"w":544.0,"h":16.0},"text":"행하였음. 프랑스, 중국, 일본 등은 피해 기업 및 실업·휴직자 등을 중심으","pi":54}]},{"type":"TextLine","bbox":{"x":120.0,"y":621.9,"w":560.3,"h":16.0},"pi":54,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":621.9,"w":552.1,"h":16.0},"text":"로 세제 감면 및 보조금 혜택 확대를 추진하였음. 특히 일본의 경우 상당한 ","pi":54}]},{"type":"TextLine","bbox":{"x":120.0,"y":650.7,"w":560.3,"h":16.0},"pi":54,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":650.7,"w":396.0,"h":16.0},"text":"규모의 임대료 직접 지원 정책을 시행하기도 하였음. ","pi":54}]},{"type":"TextLine","bbox":{"x":120.0,"y":679.5,"w":560.3,"h":16.0},"pi":55,"children":[{"type":"TextRun","bbox":{"x":120.0,"y":679.5,"w":16.0,"h":16.0},"text":"- ","pi":55},{"type":"TextRun","bbox":{"x":136.0,"y":679.5,"w":552.0,"h":16.0},"text":"주요국의 금융정책으로 미국, 영국, 호주는 기준금리를 인하하였음. 중국, ","pi":55}]},{"type":"TextLine","bbox":{"x":120.0,"y":708.3,"w":560.3,"h":16.0},"pi":55,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":708.3,"w":551.6,"h":16.0},"text":"홍콩, 일본, 싱가포르는 피해기업을 중심으로 금융지원 규모 확대, 이자율 ","pi":55}]},{"type":"TextLine","bbox":{"x":120.0,"y":737.1,"w":560.3,"h":16.0},"pi":55,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":737.1,"w":296.0,"h":16.0},"text":"감면, 상환 연장 등의 조치를 취하였음. ","pi":55}]},{"type":"TextLine","bbox":{"x":120.0,"y":765.9,"w":560.3,"h":16.0},"pi":56,"children":[{"type":"TextRun","bbox":{"x":120.0,"y":765.9,"w":16.0,"h":16.0},"text":"- ","pi":56},{"type":"TextRun","bbox":{"x":136.0,"y":765.9,"w":544.0,"h":16.0},"text":"주요국의 직접 소득지원으로 홍콩, 대만, 싱가포르, 호주, 중국 지방정부 등","pi":56}]},{"type":"TextLine","bbox":{"x":120.0,"y":794.7,"w":5