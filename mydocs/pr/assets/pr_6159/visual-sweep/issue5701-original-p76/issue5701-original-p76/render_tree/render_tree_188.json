,"h":14.7},"text":"차임증감청구를 할 당시 차임증감의 사유로 삼지 않았던 사유를 사후적으로 주장할 ","pi":1512}]},{"type":"TextLine","bbox":{"x":113.4,"y":836.3,"w":567.0,"h":14.7},"pi":1512,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":836.3,"w":567.0,"h":14.7},"text":"수 있다고 볼 경우 계약상대방으로서는 차임증감청구 당시에 예측하지 못했던 사유","pi":1512}]},{"type":"TextLine","bbox":{"x":113.4,"y":865.6,"w":567.0,"h":14.7},"pi":1512,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":865.6,"w":567.0,"h":14.7},"text":"로 인하여 과거시점부터 소급하여 차임증감의 불이익을 감수해야 하는 결과를 초래","pi":1512}]},{"type":"TextLine","bbox":{"x":113.4,"y":894.9,"w":567.0,"h":14.7},"pi":1512,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":894.9,"w":567.0,"h":14.7},"text":"하여 그 법적 지위가 현저히 불안정하게 되므로, 차임증감청구 당시 주장하지 아니","pi":1512}]},{"type":"TextLine","bbox":{"x":113.4,"y":924.3,"w":567.0,"h":14.7},"pi":1512,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":924.3,"w":567.0,"h":14.7},"text":"하였던 전혀 새로운 사유를 주장하여 당초 차임증감청구 시점부터 차임 증감의 효","pi":1512}]},{"type":"TextLine","bbox":{"x":113.4,"y":953.6,"w":567.0,"h":14.7},"pi":1512,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":953.6,"w":573.5,"h":14.7},"text":"력을 주장하는 것은 허용되지 아니하고, 새로운 사유 주장 시점을 기준으로 새로운 ","pi":1512}]},{"type":"TextLine","bbox":{"x":113.4,"y":982.9,"w":567.0,"h":14.7},"pi":1512,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":982.9,"w":284.0,"h":14.7},"text":"차임증감청구를 한 것으로 볼 수 있을 뿐","pi":1512},{"type":"TextRun","bbox":{"x":397.4,"y":982.9,"w":146.0,"h":14.7},"text":"이다. 그리고 민법 제","pi":1512},{"type":"TextRun","bbox":{"x":543.4,"y":982.9,"w":22.0,"h":14.7},"text":"628","pi":1512},{"type":"TextRun","bbox":{"x":565.4,"y":982.9,"w":116.0,"h":14.7},"text":"조, ｢상가건물 임","pi":1512}]}]}]},{"type":"Footer","bbox":{"x":113.4,"y":1009.1,"w":567.0,"h":56.7},"children":[{"type":"TextLine","bbox":{"x":369.9,"y":1028.6,"w":54.0,"h":16.0},"pi":0,"children":[{"type":"TextRun","bbox":{"x":369.9,"y":1041.9,"w":54.0,"h":13.3},"text":"- 164 -","pi":0}]}]}]}