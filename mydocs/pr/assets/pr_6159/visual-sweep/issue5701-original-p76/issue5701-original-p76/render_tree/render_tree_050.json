0,"h":13.3},"text":"30% ","pi":18446744073709549615},{"type":"TextRun","bbox":{"x":263.4,"y":718.5,"w":130.0,"h":13.3},"text":"이상 감소한 경우, 제","pi":18446744073709549615},{"type":"TextRun","bbox":{"x":393.4,"y":718.5,"w":7.0,"h":13.3},"text":"1","pi":18446744073709549615},{"type":"TextRun","bbox":{"x":400.4,"y":718.5,"w":193.0,"h":13.3},"text":"급감염병의 영향으로 매출액이 ","pi":18446744073709549615},{"type":"TextRun","bbox":{"x":593.4,"y":718.5,"w":30.0,"h":13.3},"text":"30% ","pi":18446744073709549615},{"type":"TextRun","bbox":{"x":623.4,"y":718.5,"w":33.0,"h":13.3},"text":"이상 ","pi":18446744073709549615}]},{"type":"TextLine","bbox":{"x":113.4,"y":739.8,"w":567.0,"h":13.3},"pi":0,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":739.8,"w":544.0,"h":13.3},"text":"감소한 경우임. 물론 이러한 기준은 현재 없으나 실무적 선행연구라서 완전하지 않지만 ","pi":18446744073709549615}]},{"type":"TextLine","bbox":{"x":113.4,"y":761.1,"w":567.0,"h":13.3},"pi":0,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":761.1,"w":533.0,"h":13.3},"text":"이를 바탕으로 향후 이 증감청구권에 대한 연구가 활발해지기를 기대하면서 제안한 것","pi":18446744073709549615}]},{"type":"TextLine","bbox":{"x":113.4,"y":782.5,"w":567.0,"h":13.3},"pi":0,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":782.5,"w":130.0,"h":13.3},"text":"임. 이것은 대법원의 ","pi":18446744073709549615},{"type":"TextRun","bbox":{"x":243.4,"y":782.5,"w":28.0,"h":13.3},"text":"IMF ","pi":18446744073709549615},{"type":"TextRun","bbox":{"x":271.4,"y":782.5,"w":380.0,"h":13.3},"text":"경제위기 당시 임대료 감액청구에 대해 부정하는 판결을 고려","pi":18446744073709549615}]},{"type":"TextLine","bbox":{"x":113.4,"y":803.8,"w":567.0,"h":13.3},"pi":0,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":803.8,"w":540.0,"h":13.3},"text":"하여 그 보다는 현저성, 엄격성을 완화해서 비교적 상당성 있는 기준을 제시한 것이나, ","pi":18446744073709549615}]},{"type":"TextLine","bbox":{"x":113.4,"y":825.1,"w":567.0,"h":13.3},"pi":0,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":825.1,"w":540.0,"h":13.3},"text":"앞으로 차임증감에 대한 법원의 축척된 판례에 따라 완성도 높은 기준이 마련되리라고 ","pi":18446744073709549615}]},{"type":"TextLine","bbox":{"x":113.4,"y":846.5,"w":567.0,"h":13.3},"pi":0,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":846.5,"w":537.0,"h":13.3},"text":"봄. 그렇다면 이러한 변동요인에 대한 증감청구를 할 수 있는 변동의 정도에 대한 기준","pi":18446744073709549615}]},{"type":"TextLine","bbox":{"x":113.4,"y":867.8,"w":567.0,"h":13.3},"pi":0,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":867.8,"w":540.0,"h":13.3},"text":"이 마련된다면 분쟁시 소송으로 가지 않고 당사자가 협의하여 증감청구 인정 여부와 증","pi":18446744073709549615}]},{"type":"TextLine","bbox":{"x":113.4,"y":889.1,"w":567.0,"h":13.3},"pi":0,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":889.1,"w":537.0,"h":13.3},"text":"감액의 정도를 스스로 결정할 수 있을 것임. 지금까지 이러한 변동요인에 대한 증감 청","pi":18446744073709549615}]},{"type":"TextLine","bbox":{"x":113.4,"y":910.5,"w":567.0,"h":13.3},"pi":0,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":910.5,"w":547.0,"h":13.3},"text":"구를 할 수 있는 기준이 없기 때문에 의견 대립 시 다툼이 발생하고 지나친 경우에는 소","pi":18446744073709549615}]},{"type":"TextLine","bbox":{"x":113.4,"y":931.8,"w":567.0,"h":13.3},"pi":0,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":931.8,"w":537.0,"h":13.3},"text":"송으로까지 진행되어 법원의 결정에 의존했던 것임. 물론 복잡한 변동요인이 있어 당사","pi":18446744073709549615}]},{"type":"TextLine","bbox":{"x":113.4,"y":953.1,"w":567.0,"h":13.3},"pi":0,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":953.1,"w":553.0,"h":13.3},"text":"자가 판단하기 어려운 경우에는 분쟁조정위원회의 조정 또는 부득이 법원의 판단을 구할 ","pi":18446744073709549615}]},{"type":"TextLine","bbox":{"x":113.4,"y":974.5,"w":567.0,"h":13.3},"pi":0,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":974.5,"w":540.0,"h":13.3},"text":"수 있겠지만 그렇지 않을 경우에는 이 법 조항의 입법 취지에 맞게 요건을 갖춘 경우에","pi":18446744073709549615}]},{"type":"TextLine","bbox":{"x":113.4,"y":995.8,"w":567.0,"h":13.3},"pi":0,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":995.8,"w":444.0,"h":13.3},"text":"는 당사자들이 의하여 원활하게 증감청구를 행사할 수 있어야 할 것임. ","pi":18446744073709549615}]}]},{"type":"Footer","bbox":{"x":113.4,"y":1009.1,"w":567.0,"h":56.7},"children":[{"type":"TextLine","bbox":{"x