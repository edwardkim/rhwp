.0,"y":494.7,"w":560.3,"h":16.0},"pi":16,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":494.7,"w":544.0,"h":16.0},"text":"정의 변동으로 인하여 상당하지 아니하게 된 경우 행사 가능’으로 개정되었","pi":16}]},{"type":"TextLine","bbox":{"x":120.0,"y":523.5,"w":560.3,"h":16.0},"pi":16,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":523.5,"w":545.0,"h":16.0},"text":"지만 경제사정 변동 및 차임증감 조정 기준이 명확하지 않고, 이를 구체화","pi":16}]},{"type":"TextLine","bbox":{"x":120.0,"y":552.3,"w":560.3,"h":16.0},"pi":16,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":552.3,"w":552.0,"h":16.0},"text":"시킨 하위 입법도 존재하지 않아 증감청구권의 실효성이 떨어지고 활용도도 ","pi":16}]},{"type":"TextLine","bbox":{"x":120.0,"y":581.1,"w":560.3,"h":16.0},"pi":16,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":581.1,"w":144.0,"h":16.0},"text":"매우 저조한 상황임","pi":16}]},{"type":"TextLine","bbox":{"x":120.0,"y":609.9,"w":560.3,"h":16.0},"pi":17,"children":[{"type":"TextRun","bbox":{"x":120.0,"y":609.9,"w":16.0,"h":16.0},"text":"- ","pi":17},{"type":"TextRun","bbox":{"x":136.0,"y":609.9,"w":544.0,"h":16.0},"text":"차임증감청구권의 실효성을 높여 감염병 상황으로 어려움에 처한 소상공인","pi":17}]},{"type":"TextLine","bbox":{"x":120.0,"y":638.7,"w":560.3,"h":16.0},"pi":17,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":638.7,"w":544.0,"h":16.0},"text":"들에게 실질적인 도움을 주기 위해서는 감염병으로 인한 ‘경제사정 변동 식","pi":17}]},{"type":"TextLine","bbox":{"x":120.0,"y":667.5,"w":560.3,"h":16.0},"pi":17,"children":[{"type":"TextRun","bbox":{"x":136.0,"y":667.5,"w":397.0,"h":16.0},"text":"별기준 및 차임증가 조정 기준’이 구체화될 필요 있음","pi":17}]},{"type":"TextLine","bbox":{"x":126.7,"y":696.3,"w":553.6,"h":16.0},"pi":18,"children":[{"type":"TextRun","bbox":{"x":126.7,"y":696.3,"w":553.6,"h":16.0},"text":"","pi":18}]},{"type":"TextLine","bbox":{"x":113.4,"y":725.1,"w":567.0,"h":16.0},"pi":19,"children":[{"type":"TextRun","bbox":{"x":113.4,"y":725.1,"w":24.0,"h":16.0},"text":"○ ","pi":19},{"type":"TextRun","bbox":{"x":137.4,"y":725.1,"w":64.0,"h":16.0},"text":"연구목적","pi":19}]},{"type":"TextLine","bbox":{"x":120.0,"y":753.9,"w":560.3