{"type":"Page","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5},"children":[{"type":"PageBg","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5}},{"type":"Header","bbox":{"x":83.1,"y":56.7,"w":627.4,"h":56.7}},{"type":"Body","bbox":{"x":83.1,"y":113.4,"w":627.4,"h":895.7},"children":[{"type":"Column","bbox":{"x":83.1,"y":113.4,"w":627.4,"h":895.7},"col":0,"children":[{"type":"TextLine","bbox":{"x":93.8,"y":129.4,"w":616.7,"h":14.7},"pi":262,"children":[{"type":"TextRun","bbox":{"x":93.8,"y":129.4,"w":157.0,"h":14.7},"text":"가. 하향식예산편성제도","pi":262},{"type":"FnMarker","bbox":{"x":250.8,"y":129.4,"w":16.0,"h":14.7}}]},{"type":"TextLine","bbox":{"x":96.5,"y":162.5,"w":614.1,"h":14.7},"pi":263,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":162.5,"w":614.0,"h":14.7},"text":"노무현정부가 출범하면서 중앙정부의 예산편성에 변화가 있게 되었는 데, 그 동안의 상향","pi":263}]},{"type":"TextLine","bbox":{"x":83.1,"y":184.5,"w":627.4,"h":14.7},"pi":263,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":184.5,"w":19.0,"h":14.7},"text":"식(","pi":263},{"type":"TextRun","bbox":{"x":102.1,"y":184.5,"w":81.0,"h":14.7},"text":"bottom-up) ","pi":263},{"type":"TextRun","bbox":{"x":183.1,"y":184.5,"w":166.0,"h":14.7},"text":"예산편성 대신에 하향식(","pi":263},{"type":"TextRun","bbox":{"x":349.1,"y":184.5,"w":76.0,"h":14.7},"text":"top-down) ","pi":263},{"type":"TextRun","bbox":{"x":425.1,"y":184.5,"w":209.0,"h":14.7},"text":"편성접근방법을 도입한 것이다.","pi":263}]},{"type":"TextLine","bbox":{"x":96.5,"y":213.2,"w":614.1,"h":14.7},"pi":264,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":213.2,"w":49.0,"h":14.7},"text":"하향식(","pi":264},{"type":"TextRun","bbox":{"x":145.5,"y":213.2,"w":77.0,"h":14.7},"text":"top-down) ","pi":264},{"type":"TextRun","bbox":{"x":222.5,"y":213.2,"w":489.0,"h":14.7},"text":"예산편성은 총예산을 분야별, 부처별로 사전적으로 배분결정하고 구체적","pi":264}]},{"type":"TextLine","bbox":{"x":83.1,"y":235.2,"w":627.4,"h":14.7},"pi":264,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":235.2,"w":627.0,"h":14.7},"text":"인 사업별 예산배분은 해당부처에서 자율적으로 결정토록하며 다만 중앙예산기구는 재원배","pi":264}]},{"type":"TextLine","bbox":{"x":83.1,"y":257.2,"w":627.4,"h":14.7},"pi":264,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":257.2,"w":503.0,"h":14.7},"text":"분기준을 시달하고 사후에 배분의 적합성을 점검토록 하는 것을 의미한다.","pi":264}]},{"type":"TextLine","bbox":{"x":96.5,"y":285.9,"w":614.1,"h":14.7},"pi":265,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":285.9,"w":620.7,"h":14.7},"text":"이전까지는 예산을 편성할 때 각 부처에서 요청한 품목(투입물)을 중심으로 이의 타당성을 ","pi":265}]},{"type":"TextLine","bbox":{"x":83.1,"y":307.9,"w":627.4,"h":14.7},"pi":265,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":307.9,"w":628.0,"h":14.7},"text":"검토하여 예산을 확정짓는 것이었으므로 아래에서부터 품목별, 사업별로 요청하고 이를 합산","pi":265}]},{"type":"TextLine","bbox":{"x":83.1,"y":330.0,"w":627.4,"h":14.7},"pi":265,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":330.0,"w":217.0,"h":14.7},"text":"시켜 총예산이 결정되는 상향식(","pi":265},{"type":"TextRun","bbox":{"x":300.1,"y":330.0,"w":74.0,"h":14.7},"text":"bottom-up)","pi":265},{"type":"TextRun","bbox":{"x":374.1,"y":330.0,"w":48.0,"h":14.7},"text":"이였다.","pi":265}]},{"type":"TextLine","bbox":{"x":103.1,"y":365.3,"w":607.4,"h":16.0},"pi":266,"children":[{"type":"TextRun","bbox":{"x":103.1,"y":365.3,"w":21.0,"h":16.0},"text":"1) ","pi":266},{"type":"TextRun","bbox":{"x":124.1,"y":365.3,"w":160.0,"h":16.0},"text":"하향식 예산편성 내용","pi":266}]},{"type":"TextLine","bbox":{"x":109.8,"y":403.5,"w":600.7,"h":14.7},"pi":267,"children":[{"type":"TextRun","bbox":{"x":109.8,"y":403.5,"w":24.0,"h":14.7},"text":"(1) ","pi":267},{"type":"TextRun","bbox":{"x":133.8,"y":403.5,"w":220.0,"h":14.7},"text":"연차별 총 재원배분 규모의 결정","pi":267}]},{"type":"TextLine","bbox":{"x":96.5,"y":432.2,"w":614.1,"h":14.7},"pi":268,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":432.2,"w":614.0,"h":14.7},"text":"하향식 예산편성제도는 총 재원배분 규모와 분야별 재원배분 규모를 사전적으로 설정한다","pi":268}]},{"type":"TextLine","bbox":{"x":83.1,"y":454.2,"w":627.4,"h":14.7},"pi":268,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":454.2,"w":627.0,"h":14.7},"text":"는 특징을 갖는다. 총 재원배분 규모를 설정하기 위해서는 먼저 중기 국가 정책목표와 정책","pi":268}]},{"type":"TextLine","bbox":{"x":83.1,"y":476.2,"w":627.4,"h":14.7},"pi":268,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":476.2,"w":628.0,"h":14.7},"text":"방향을 확정해야 한다. 이것은 결코 쉽지 않은 과제이지만 중기적인 시각에서 세계적인 발전","pi":268}]},{"type":"TextLine","bbox":{"x":83.1,"y":498.2,"w":627.4,"h":14.7},"pi":268,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":498.2,"w":627.0,"h":14.7},"text":"흐름, 선진국의 경험과 교훈등 대외적인 요소와 국가발전계획, 지역발전전략 등 대내적인 요","pi":268}]},{"type":"TextLine","bbox":{"x":83.1,"y":520.3,"w":627.4,"h":14.7},"pi":268,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":520.3,"w":598.0,"h":14.7},"text":"소를 종합적으로 고려하여 국가가 중점적으로 추진해야 할 정책목표와 방향을 설정한다.","pi":268}]},{"type":"TextLine","bbox":{"x":96.5,"y":549.0,"w":614.1,"h":14.7},"pi":269,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":549.0,"w":621.5,"h":14.7},"text":"중기 국가 정책목표와 방향이 설정되면 이를 달성하는데 소요되는 재정지출 소요를 추정한다. ","pi":269}]},{"type":"TextLine","bbox":{"x":83.1,"y":571.0,"w":627.4,"h":14.7},"pi":269,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":571.0,"w":602.0,"h":14.7},"text":"그리고 정책목표의 달성속도 및 달성정도 등을 고려하여 총 재원배분 규모를 결정하게 된다.","pi":269}]},{"type":"TextLine","bbox":{"x":109.8,"y":602.3,"w":600.7,"h":14.7},"pi":270,"children":[{"type":"TextRun","bbox":{"x":109.8,"y":602.3,"w":24.0,"h":14.7},"text":"(2) ","pi":270},{"type":"TextRun","bbox":{"x":133.8,"y":602.3,"w":217.0,"h":14.7},"text":"분야별, 부처별 재원규모의 결정","pi":270}]},{"type":"TextLine","bbox":{"x":96.5,"y":631.0,"w":614.1,"h":14.7},"pi":271,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":631.0,"w":614.0,"h":14.7},"text":"분야별, 부처별 재원배분규모의 결정은 국회, 정부 그리고 국민 등이 참여하는 논의 과정","pi":271}]},{"type":"TextLine","bbox":{"x":83.1,"y":653.1,"w":627.4,"h":14.7},"pi":271,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":653.1,"w":627.0,"h":14.7},"text":"을 거쳐 의회 또는 행정부(중앙예산기구) 주도로 결정된다. 여기서 그 결정주체가 누가 되느","pi":271}]},{"type":"TextLine","bbox":{"x":83.1,"y":675.1,"w":627.4,"h":14.7},"pi":271,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":675.1,"w":628.0,"h":14.7},"text":"냐가 대단히 중요하다. 왜냐하면 분야별, 부처별 재원배분 규모를 결정할 때에는 총 재원배","pi":271}]},{"type":"TextLine","bbox":{"x":83.1,"y":697.1,"w":627.4,"h":14.7},"pi":271,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":697.1,"w":628.0,"h":14.7},"text":"분 규모의 결정 때와는 달리 특정분야, 특정부처의 이해관계가 직접 충돌하기 때문에 잘못하","pi":271}]},{"type":"TextLine","bbox":{"x":83.1,"y":719.1,"w":627.4,"h":14.7},"pi":271,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":719.1,"w":634.3,"h":14.7},"text":"면 외부로부터의 정치적 압력을 받을 수 있어 재원배분의 최적성이 크게 왜곡될 가능성이 ","pi":271}]},{"type":"TextLine","bbox":{"x":83.1,"y":741.2,"w":627.4,"h":14.7},"pi":271,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":741.2,"w":99.0,"h":14.7},"text":"높기 때문이다.","pi":271}]},{"type":"TextLine","bbox":{"x":96.5,"y":769.9,"w":614.1,"h":14.7},"pi":272,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":769.9,"w":614.0,"h":14.7},"text":"중앙예산기구는 각 지출부서가 제출한 “중기재정계획서”를 면밀히 검토하고 중기재정계획","pi":272}]},{"type":"TextLine","bbox":{"x":83.1,"y":791.9,"w":627.4,"h":14.7},"pi":272,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":791.9,"w":627.0,"h":14.7},"text":"상의 정책 목표 및 투자우선순위 등을 점검하여 분야별, 부처별로 재원 배분 규모를 확정지","pi":272}]},{"type":"TextLine","bbox":{"x":83.1,"y":813.9,"w":627.4,"h":14.7},"pi":272,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":813.9,"w":158.0,"h":14.7},"text":"어 배분해야 할 것이다.","pi":272}]},{"type":"TextLine","bbox":{"x":109.8,"y":845.3,"w":600.7,"h":14.7},"pi":273,"children":[{"type":"TextRun","bbox":{"x":109.8,"y":845.3,"w":24.0,"h":14.7},"text":"(3) ","pi":273},{"type":"TextRun","bbox":{"x":133.8,"y":845.3,"w":205.0,"h":14.7},"text":"지출부서의 자율적인 재원배분","pi":273}]},{"type":"TextLine","bbox":{"x":96.5,"y":874.0,"w":614.1,"h":14.7},"pi":274,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":874.0,"w":614.0,"h":14.7},"text":"분야별, 부처별 재원배분규모가 결정되면 각 지출부처는 사업별로 재원을 자율배분하게 된","pi":274}]},{"type":"TextLine","bbox":{"x":83.1,"y":896.0,"w":627.4,"h":14.7},"pi":274,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":896.0,"w":634.1,"h":14.7},"text":"다. 이 과정에서 지출부처에 상당한 자율권이 부여되어야 하며, 이 자율성의 확보가 하향식 ","pi":274}]},{"type":"TextLine","bbox":{"x":83.1,"y":918.0,"w":627.4,"h":14.7},"pi":274,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":918.0,"w":628.0,"h":14.7},"text":"예산편성제도가 갖는 가장 중요한 장점이 된다. 지출부처는 전체 국가 정책목표와 투자 우선","pi":274}]},{"type":"TextLine","bbox":{"x":83.1,"y":940.1,"w":627.4,"h":14.7},"pi":274,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":940.1,"w":635.0,"h":14.7},"text":"순위 등을 고려하면서 마련된 부처별 세부 정책목표 및 세부 투자 우선순위에 따라 사업별 ","pi":274}]}]}]},{"type":"FootnoteArea","bbox":{"x":83.1,"y":976.4,"w":627.4,"h":32.7},"children":[{"type":"Line","bbox":{"x":83.1,"y":987.5,"w":189.0,"h":0.5}},{"type":"TextLine","bbox":{"x":83.1,"y":995.8,"w":627.4,"h":13.3},"pi":0,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":995.8,"w":29.0,"h":13.3},"text":"142) ","pi":18446744073709549615},{"type":"TextRun","bbox":{"x":112.1,"y":995.8,"w":12.0,"h":13.3},"text":"  ","pi":18446744073709549615},{"type":"TextRun","bbox":{"x":124.1,"y":995.8,"w":152.0,"h":13.3},"text":"김동건, 지방예산과 하향식(","pi":18446744073709549615},{"type":"TextRun","bbox":{"x":276.1,"y":995.8,"w":67.0,"h":13.3},"text":"top-down) ","pi":18446744073709549615},{"type":"TextRun","bbox":{"x":343.1,"y":995.8,"w":151.0,"h":13.3},"text":"예산편성제도, 서울대학교, ","pi":18446744073709549615},{"type":"TextRun","bbox":{"x":494.1,"y":995.8,"w":38.0,"h":13.3},"text":"2003. ","pi":18446744073709549615},{"type":"TextRun","bbox":{"x":532.1,"y":995.8,"w":138.0,"h":13.3},"text":"제구성하여 재인용하였음","pi":18446744073709549615}]}]},{"type":"Footer","bbox":{"x":83.1,"y":1009.1,"w":627.4,"h":56.7},"children":[{"type":"TextLine","bbox":{"x":369.9,"y":1028.6,"w":54.0,"h":16.0},"pi":0,"children":[{"type":"TextRun","bbox":{"x":369.9,"y":1041.9,"w":54.0,"h":13.3},"text":"- 297 -","pi":0}]}]}]}