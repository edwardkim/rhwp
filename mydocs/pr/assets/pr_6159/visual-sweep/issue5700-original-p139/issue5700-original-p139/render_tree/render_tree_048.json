{"type":"Page","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5},"children":[{"type":"PageBg","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5}},{"type":"MasterPage","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5},"children":[{"type":"Table","bbox":{"x":0.0,"y":54.3,"w":642.0,"h":26.5},"rows":1,"cols":2,"pi":0,"ci":0,"children":[{"type":"Cell","bbox":{"x":0.0,"y":54.3,"w":615.5,"h":26.5},"row":0,"col":0,"children":[{"type":"TextLine","bbox":{"x":1.9,"y":60.1,"w":611.7,"h":14.7},"pi":0,"children":[{"type":"TextRun","bbox":{"x":347.6,"y":60.1,"w":22.0,"h":14.7},"text":"제 ","pi":0},{"type":"TextRun","bbox":{"x":369.6,"y":60.1,"w":17.0,"h":14.7},"text":"3 ","pi":0},{"type":"TextRun","bbox":{"x":386.6,"y":60.1,"w":227.0,"h":14.7},"text":"장 최적의 수색구조장비 확보방안","pi":0}]}]},{"type":"Cell","bbox":{"x":615.5,"y":54.3,"w":26.5,"h":26.5},"row":0,"col":1,"children":[{"type":"TextLine","bbox":{"x":624.0,"y":59.5,"w":16.1,"h":16.0},"pi":0,"children":[{"type":"TextRun","bbox":{"x":624.0,"y":59.5,"w":16.1,"h":16.0},"text":"","pi":0}]}]},{"type":"Line","bbox":{"x":0.0,"y":80.7,"w":615.5,"h":0.8}}]}]},{"type":"Header","bbox":{"x":83.1,"y":56.7,"w":627.4,"h":56.7}},{"type":"Body","bbox":{"x":83.1,"y":113.4,"w":627.4,"h":895.7},"children":[{"type":"Column","bbox":{"x":83.1,"y":113.4,"w":627.4,"h":895.7},"col":0,"children":[{"type":"TextLine","bbox":{"x":96.5,"y":113.4,"w":614.1,"h":14.7},"pi":430,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":113.4,"w":614.0,"h":14.7},"text":"예를 들어서 해상보안청과 사단법인인 일본수난구제회의 구난소, 마리나, 어업협동조합 기","pi":430}]},{"type":"TextLine","bbox":{"x":83.1,"y":135.4,"w":627.4,"h":14.7},"pi":430,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":135.4,"w":627.0,"h":14.7},"text":"타 민간단체들 사이에 연락조정은 물론이고 강력한 네트워크적 협력체제가 구축되고 있다.  ","pi":430}]},{"type":"TextLine","bbox":{"x":96.5,"y":164.1,"w":614.1,"h":14.7},"pi":431,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":164.1,"w":614.0,"h":14.7},"text":"셋째, 해상사고가 자주 발생하고 있는 지역의 서비스 제공자들 사이에는 연안구조와 연안","pi":431}]},{"type":"TextLine","bbox":{"x":83.1,"y":186.1,"w":627.4,"h":14.7},"pi":431,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":186.1,"w":634.3,"h":14.7},"text":"구조정에 관한 기본적인 교육을 실시하려는 분위기가 조성되고 있다. 예를 들어서 해양안전 ","pi":431}]},{"type":"TextLine","bbox":{"x":83.1,"y":208.2,"w":627.4,"h":14.7},"pi":431,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":208.2,"w":628.0,"h":14.7},"text":"사고지역에 위치한 병원, 호텔 등에서는 관계자들이 힘을 모아서 ‘지구 보트세일링 안전대책","pi":431}]},{"type":"TextLine","bbox":{"x":83.1,"y":230.2,"w":627.4,"h":14.7},"pi":431,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":230.2,"w":628.0,"h":14.7},"text":"협의회,’ ‘지구 스쿠버 다이빙 안전대책 협의회’ 등과 같은 단체를 통하여 관련된 교육과 활","pi":431}]},{"type":"TextLine","bbox":{"x":83.1,"y":252.2,"w":627.4,"h":14.7},"pi":431,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":252.2,"w":151.0,"h":14.7},"text":"동을 제공하고 있다.  ","pi":431}]},{"type":"TextLine","bbox":{"x":96.5,"y":280.9,"w":614.1,"h":14.7},"pi":432,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":280.9,"w":94.0,"h":14.7},"text":"넷째, 일부의 ","pi":432},{"type":"TextRun","bbox":{"x":190.5,"y":280.9,"w":35.0,"h":14.7},"text":"NGO","pi":432},{"type":"TextRun","bbox":{"x":225.5,"y":280.9,"w":485.0,"h":14.7},"text":"들은 연안구조를 체계적으로 그리고 실질적으로 실시하기 위하여 관련","pi":432}]},{"type":"TextLine","bbox":{"x":83.1,"y":302.9,"w":627.4,"h":14.7},"pi":432,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":302.9,"w":628.0,"h":14.7},"text":"된 사업을 추구하고 있다. 예를 들어서 일본의 관동지구와 관서지구는  ‘레저보트 구조사업’","pi":432}]},{"type":"TextLine","bbox":{"x":83.1,"y":325.0,"w":627.4,"h":14.7},"pi":432,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":325.0,"w":24.0,"h":14.7},"text":"인 ","pi":432},{"type":"TextRun","bbox":{"x":107.1,"y":325.0,"w":216.0,"h":14.7},"text":"BAN(Boat Assistance Network)","pi":432},{"type":"TextRun","bbox":{"x":323.1,"y":325.0,"w":394.2,"h":14.7},"text":"을 실행하고 있으며 재단법인인 일본 해양성 레저 안전 ","pi":432}]},{"type":"TextLine","bbox":{"x":83.1,"y":347.0,"w":627.4,"h":14.7},"pi":432,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":347.0,"w":274.0,"h":14.7},"text":"진흥협회는 ‘일본 다이빙 경고네트워크: ","pi":432},{"type":"TextRun","bbox":{"x":357.1,"y":347.0,"w":316.0,"h":14.7},"text":"DAN Japan (Divers Alert Network of Japan)'","pi":432},{"type":"TextRun","bbox":{"x":673.1,"y":347.0,"w":37.0,"h":14.7},"text":"을 적","pi":432}]},{"type":"TextLine","bbox":{"x":83.1,"y":369.0,"w":627.4,"h":14.7},"pi":432,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":369.0,"w":173.0,"h":14.7},"text":"극적으로 실행하고 있다. ","pi":432}]},{"type":"TextLine","bbox":{"x":93.8,"y":407.0,"w":616.7,"h":14.7},"pi":433,"children":[{"type":"TextRun","bbox":{"x":93.8,"y":407.0,"w":106.0,"h":14.7},"text":"나. 중국의 경우","pi":433}]},{"type":"TextLine","bbox":{"x":96.5,"y":440.1,"w":614.1,"h":14.7},"pi":434,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":440.1,"w":614.0,"h":14.7},"text":"최근 중국의 동북아 해상에는 해상사고를 야기할 수 있는 다양한 원인들이 도사리고 있으","pi":434}]},{"type":"TextLine","bbox":{"x":83.1,"y":462.1,"w":627.4,"h":14.7},"pi":434,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":462.1,"w":634.7,"h":14.7},"text":"며 그 위협성이 증대되고 있다. 구체적으로 살펴보면 첫째는 군사적 이유로 인하여 발생할 ","pi":434}]},{"type":"TextLine","bbox":{"x":83.1,"y":484.2,"w":627.4,"h":14.7},"pi":434,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":484.2,"w":634.1,"h":14.7},"text":"수 있는 해상교통로의 위협이다. 중국과 인접한 동북아시아의 해상에서는 도서영유권 분쟁이 ","pi":434}]},{"type":"TextLine","bbox":{"x":83.1,"y":506.2,"w":627.4,"h":14.7},"pi":434,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":506.2,"w":627.0,"h":14.7},"text":"남아있다. 그리고 정치적 목적으로 동북아 해상에서는 군사훈련, 무력사용 등이 발생하고 있","pi":434}]},{"type":"TextLine","bbox":{"x":83.1,"y":528.2,"w":627.4,"h":14.7},"pi":434,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":528.2,"w":628.0,"h":14.7},"text":"다. 이러한 사건들은 주변의 해상교통로를 위협함으로써 연안구조정의 필요성을 더욱 증가시","pi":434}]},{"type":"TextLine","bbox":{"x":83.1,"y":550.2,"w":627.4,"h":14.7},"pi":434,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":550.2,"w":70.0,"h":14.7},"text":"키고 있다.","pi":434}]},{"type":"TextLine","bbox":{"x":96.5,"y":578.9,"w":614.1,"h":14.7},"pi":435,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":578.9,"w":614.0,"h":14.7},"text":"둘째는 중국을 포함한 주변국들이 해양관할권을 행사하여 통항제한을 위협하고 있다는 것","pi":435}]},{"type":"TextLine","bbox":{"x":83.1,"y":601.0,"w":627.4,"h":14.7},"pi":435,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":601.0,"w":628.0,"h":14.7},"text":"이다. 즉, 중국이나 주변국들이 타국과의 긴밀한 협력관계에 실패하여 일방적으로 자국영해","pi":435}]},{"type":"TextLine","bbox":{"x":83.1,"y":623.0,"w":627.4,"h":14.7},"pi":435,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":623.0,"w":627.0,"h":14.7},"text":"의 기준선을 확대하는 경우가 발생하고 있으며 동시에 국제해협, 만 등과 같은 지역을 국내","pi":435}]},{"type":"TextLine","bbox":{"x":83.1,"y":645.0,"w":627.4,"h":14.7},"pi":435,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":645.0,"w":634.4,"h":14.7},"text":"수역으로 선포하려는 의도도 감지되하고 있다. 이러한 경우에는 동북아 해상의 통항제한이 ","pi":435}]},{"type":"TextLine","bbox":{"x":83.1,"y":667.0,"w":627.4,"h":14.7},"pi":435,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":667.0,"w":407.0,"h":14.7},"text":"발생하며 그래서 연안구조정의 필요성이 제기되는 대목이다.","pi":435}]},{"type":"TextLine","bbox":{"x":96.5,"y":695.7,"w":614.1,"h":14.7},"pi":436,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":695.7,"w":629.0,"h":14.7},"text":"셋째, 중국을 둘러싼 동북아의 해상에서도 다양한 범죄행위가 증가하고 있다는 것이다.  ","pi":436}]},{"type":"TextLine","bbox":{"x":83.1,"y":717.8,"w":627.4,"h":14.7},"pi":436,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":717.8,"w":628.0,"h":14.7},"text":"예를 들어서 중국인 혹은 중국인과 다른 국적의 범죄자들의 협력으로 발생하는 마약운반 행","pi":436}]},{"type":"TextLine","bbox":{"x":83.1,"y":739.8,"w":627.4,"h":14.7},"pi":436,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":739.8,"w":634.3,"h":14.7},"text":"위, 불법난민의 수송행위 등은 해상사고를 촉발시키고 있다. 또한, 동북아에서의 해적행위도 ","pi":436}]},{"type":"TextLine","bbox":{"x":83.1,"y":761.8,"w":627.4,"h":14.7},"pi":436,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":761.8,"w":627.0,"h":14.7},"text":"증가하고 있으며 그래서 이러한 원인들의 중국 주변의 동북아 해상에서 연안구조정의 필요","pi":436}]},{"type":"TextLine","bbox":{"x":83.1,"y":783.8,"w":627.4,"h":14.7},"pi":436,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":783.8,"w":187.0,"h":14.7},"text":"성을 더욱 증가시키고 있다.","pi":436}]},{"type":"TextLine","bbox":{"x":96.5,"y":812.5,"w":614.1,"h":14.7},"pi":437,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":812.5,"w":614.1,"h":14.7},"text":"","pi":437}]},{"type":"TextLine","bbox":{"x":96.5,"y":841.2,"w":614.1,"h":14.7},"pi":438,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":841.2,"w":614.1,"h":14.7},"text":"","pi":438}]},{"type":"TextLine","bbox":{"x":96.5,"y":869.9,"w":614.1,"h":14.7},"pi":439,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":869.9,"w":614.1,"h":14.7},"text":"","pi":439}]},{"type":"TextLine","bbox":{"x":96.5,"y":898.6,"w":614.1,"h":14.7},"pi":440,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":898.6,"w":614.1,"h":14.7},"text":"","pi":440}]},{"type":"TextLine","bbox":{"x":96.5,"y":927.3,"w":614.1,"h":14.7},"pi":441,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":927.3,"w":614.1,"h":14.7},"text":"","pi":441}]},{"type":"TextLine","bbox":{"x":96.5,"y":956.0,"w":614.1,"h":14.7},"pi":442,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":956.0,"w":614.1,"h":14.7},"text":"","pi":442}]}]}]},{"type":"Footer","bbox":{"x":83.1,"y":1009.1,"w":627.4,"h":56.7},"children":[{"type":"TextLine","bbox":{"x":369.9,"y":1028.6,"w":54.0,"h":16.0},"pi":0,"children":[{"type":"TextRun","bbox":{"x":369.9,"y":1041.9,"w":54.0,"h":13.3},"text":"- 262 -","pi":0}]}]}]}