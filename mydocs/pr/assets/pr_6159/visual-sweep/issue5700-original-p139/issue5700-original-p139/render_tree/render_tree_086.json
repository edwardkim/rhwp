{"type":"Page","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5},"children":[{"type":"PageBg","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5}},{"type":"Header","bbox":{"x":83.1,"y":56.7,"w":627.4,"h":56.7}},{"type":"Body","bbox":{"x":83.1,"y":113.4,"w":627.4,"h":895.7},"children":[{"type":"Column","bbox":{"x":83.1,"y":113.4,"w":627.4,"h":895.7},"col":0,"children":[{"type":"TextLine","bbox":{"x":103.1,"y":126.7,"w":607.4,"h":16.0},"pi":299,"children":[{"type":"TextRun","bbox":{"x":103.1,"y":126.7,"w":21.0,"h":16.0},"text":"1) ","pi":299},{"type":"TextRun","bbox":{"x":124.1,"y":126.7,"w":192.0,"h":16.0},"text":"하향식 예산편성제도 도입","pi":299}]},{"type":"TextLine","bbox":{"x":109.8,"y":164.9,"w":600.7,"h":14.7},"pi":300,"children":[{"type":"TextRun","bbox":{"x":109.8,"y":164.9,"w":24.0,"h":14.7},"text":"(1) ","pi":300},{"type":"TextRun","bbox":{"x":133.8,"y":164.9,"w":220.0,"h":14.7},"text":"연차별 총 재원배분 규모의 결정","pi":300}]},{"type":"TextLine","bbox":{"x":96.5,"y":193.5,"w":614.1,"h":14.7},"pi":301,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":193.5,"w":614.0,"h":14.7},"text":"하향식 예산편성제도는 총 재원배분 규모와 분야별 재원배분 규모를 사전에 설정해야 한","pi":301}]},{"type":"TextLine","bbox":{"x":83.1,"y":215.6,"w":627.4,"h":14.7},"pi":301,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":215.6,"w":594.0,"h":14.7},"text":"다는 전제가 필요하며, 이것은 연안구조장비 연차별 도입계획을 통해서 결정될 수 있다.","pi":301}]},{"type":"TextLine","bbox":{"x":96.5,"y":244.3,"w":614.1,"h":14.7},"pi":302,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":244.3,"w":614.0,"h":14.7},"text":"그리고 연차별 도입계획 수립을 위해서 타과 연관부서와 본청 및 지방청 수색구조업무 관","pi":302}]},{"type":"TextLine","bbox":{"x":83.1,"y":266.3,"w":627.4,"h":14.7},"pi":302,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":266.3,"w":627.0,"h":14.7},"text":"련부서원 , 외부전문가들로 구성된 가칭 “연안구조장비도입평가위원회” 검토를 거쳐 기본계","pi":302}]},{"type":"TextLine","bbox":{"x":83.1,"y":288.3,"w":627.4,"h":14.7},"pi":302,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":288.3,"w":173.0,"h":14.7},"text":"획을 수립하면 될 것이다.","pi":302}]},{"type":"TextLine","bbox":{"x":109.8,"y":319.7,"w":600.7,"h":14.7},"pi":303,"children":[{"type":"TextRun","bbox":{"x":109.8,"y":319.7,"w":24.0,"h":14.7},"text":"(2) ","pi":303},{"type":"TextRun","bbox":{"x":133.8,"y":319.7,"w":217.0,"h":14.7},"text":"분야별, 부서별 재원규모의 결정","pi":303}]},{"type":"TextLine","bbox":{"x":96.5,"y":348.4,"w":614.1,"h":14.7},"pi":304,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":348.4,"w":592.0,"h":14.7},"text":"분야별, 부서별 재원배분규모의 결정도 가칭 “연안구조장비도입평가위원회”에서 협의","pi":304},{"type":"TextRun","bbox":{"x":688.5,"y":348.4,"w":7.0,"h":14.7},"text":"ㆍ","pi":304},{"type":"TextRun","bbox":{"x":695.5,"y":348.4,"w":15.0,"h":14.7},"text":"도","pi":304}]},{"type":"TextLine","bbox":{"x":83.1,"y":370.4,"w":627.4,"h":14.7},"pi":304,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":370.4,"w":627.0,"h":14.7},"text":"출된 사항으로 결정하면 된다. 이러한 의사결정구조는 재원배분이 특정분야 또는 특정 관할","pi":304}]},{"type":"TextLine","bbox":{"x":83.1,"y":392.4,"w":627.4,"h":14.7},"pi":304,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":392.4,"w":349.0,"h":14.7},"text":"해역으로만 집중될 수 있는 오류를 방지할 수 있다.","pi":304}]},{"type":"TextLine","bbox":{"x":109.8,"y":423.8,"w":600.7,"h":14.7},"pi":305,"children":[{"type":"TextRun","bbox":{"x":109.8,"y":423.8,"w":24.0,"h":14.7},"text":"(3) ","pi":305},{"type":"TextRun","bbox":{"x":133.8,"y":423.8,"w":205.0,"h":14.7},"text":"지출부서의 자율적인 재원배분","pi":305}]},{"type":"TextLine","bbox":{"x":96.5,"y":452.5,"w":614.1,"h":14.7},"pi":306,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":452.5,"w":614.0,"h":14.7},"text":"재원배분규모가 결정되면 지출부서에 상당한 자율권이 부여되어야 하며, 이 자율성의 확보","pi":306}]},{"type":"TextLine","bbox":{"x":83.1,"y":474.5,"w":627.4,"h":14.7},"pi":306,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":474.5,"w":628.0,"h":14.7},"text":"의 근거는 가칭 “연안구조장비도입평가위원회”에서 결정된 계획에 준하여 진행되어야 할 것","pi":306}]},{"type":"TextLine","bbox":{"x":83.1,"y":496.5,"w":627.4,"h":14.7},"pi":306,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":496.5,"w":528.0,"h":14.7},"text":"이며, 이러한 분위기는 하향식 예산편성제도가 갖는 가장 중요한 장점이 된다.","pi":306}]},{"type":"TextLine","bbox":{"x":109.8,"y":527.9,"w":600.7,"h":14.7},"pi":307,"children":[{"type":"TextRun","bbox":{"x":109.8,"y":527.9,"w":24.0,"h":14.7},"text":"(4) ","pi":307},{"type":"TextRun","bbox":{"x":133.8,"y":527.9,"w":235.0,"h":14.7},"text":"재원배분 기준과 이의 적합성 점검","pi":307}]},{"type":"TextLine","bbox":{"x":96.5,"y":556.6,"w":614.1,"h":14.7},"pi":308,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":556.6,"w":614.0,"h":14.7},"text":"가칭 “연안구조장비도입평가위원회”에서 결정된 사항들을 통해서 배분된 자원에 대해 부","pi":308}]},{"type":"TextLine","bbox":{"x":83.1,"y":578.6,"w":627.4,"h":14.7},"pi":308,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":578.6,"w":565.0,"h":14.7},"text":"서별로 자율성을 부여하여 추진하나, 이에 대해 검증할 수 있는 시스템이 필요하다.","pi":308}]},{"type":"TextLine","bbox":{"x":96.5,"y":607.3,"w":614.1,"h":14.7},"pi":309,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":607.3,"w":614.0,"h":14.7},"text":"즉 기본계획에 따른 업무추진이 제대로 수행되었는지 도입기준을 준하였는지 실제로 해역","pi":309}]},{"type":"TextLine","bbox":{"x":83.1,"y":629.3,"w":627.4,"h":14.7},"pi":309,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":629.3,"w":635.1,"h":14.7},"text":"특성에 맞게 추진되었는지, 공정성은 확보하였는지 등등 사업추진에 따른 평가검증시스템을 ","pi":309}]},{"type":"TextLine","bbox":{"x":83.1,"y":651.4,"w":627.4,"h":14.7},"pi":309,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":651.4,"w":627.0,"h":14.7},"text":"통하여 객관성과 투명성 등을 검증할 필요가 있다. 따라서 가칭 “연안구조장비도입평가위원","pi":309}]},{"type":"TextLine","bbox":{"x":83.1,"y":673.4,"w":627.4,"h":14.7},"pi":309,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":673.4,"w":268.0,"h":14.7},"text":"회”에서 그 역할을 수행하면 될 것이다.","pi":309}]},{"type":"TextLine","bbox":{"x":103.1,"y":708.7,"w":607.4,"h":16.0},"pi":310,"children":[{"type":"TextRun","bbox":{"x":103.1,"y":708.7,"w":21.0,"h":16.0},"text":"2) ","pi":310},{"type":"TextRun","bbox":{"x":124.1,"y":708.7,"w":304.0,"h":16.0},"text":"가칭 “연안구조장비도입평가위원회” 신설","pi":310}]},{"type":"TextLine","bbox":{"x":96.5,"y":744.2,"w":614.1,"h":14.7},"pi":311,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":744.2,"w":614.0,"h":14.7},"text":"앞서 언급한 대로 사업추진 및 예산편성 그리고 예산지출에 대한 효율성과 객관적 투명성","pi":311}]},{"type":"TextLine","bbox":{"x":83.1,"y":766.2,"w":627.4,"h":14.7},"pi":311,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":766.2,"w":628.0,"h":14.7},"text":"을 답보하기 위해서는 해양경찰청 내부에 존재하는 수색구조 관련인원과 외부전문가로 구성","pi":311}]},{"type":"TextLine","bbox":{"x":83.1,"y":788.3,"w":627.4,"h":14.7},"pi":311,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":788.3,"w":473.0,"h":14.7},"text":"된 가칭 “연안구조장비도입평가위원회” 라는 협의체 도입이 필요하다.","pi":311}]},{"type":"TextLine","bbox":{"x":96.5,"y":817.0,"w":614.1,"h":14.7},"pi":312,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":817.0,"w":385.0,"h":14.7},"text":"현재 연안구조장비 도입을 위해서는 해양경찰청 예규 제","pi":312},{"type":"TextRun","bbox":{"x":481.5,"y":817.0,"w":15.0,"h":14.7},"text":"83","pi":312},{"type":"TextRun","bbox":{"x":496.5,"y":817.0,"w":221.4,"h":14.7},"text":"호 함정건조 및 장비선정위원회 ","pi":312}]},{"type":"TextLine","bbox":{"x":83.1,"y":839.0,"w":627.4,"h":14.7},"pi":312,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":839.0,"w":613.0,"h":14.7},"text":"규칙에 따라 연안구조장비 도입시 위원회를 구성하여 심의결의된 사항으로 추진되고 있다.","pi":312}]},{"type":"TextLine","bbox":{"x":96.5,"y":867.7,"w":614.1,"h":14.7},"pi":313,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":867.7,"w":614.0,"h":14.7},"text":"그러나 연안구조정은 소형급에 해당하며 순찰개념보다는 즉각 대응을 통한 인명구조에 있","pi":313}]},{"type":"TextLine","bbox":{"x":83.1,"y":889.7,"w":627.4,"h":14.7},"pi":313,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":889.7,"w":634.3,"h":14.7},"text":"기 때문에 기존 함정운용의 개념과는 차이가 있으므로 일선 현장에서 운용을 하는 담당자 ","pi":313}]},{"type":"TextLine","bbox":{"x":83.1,"y":911.7,"w":627.4,"h":14.7},"pi":313,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":911.7,"w":378.0,"h":14.7},"text":"및 수색구조 전문가의 의견수렴은 무엇보다도 중요하다.","pi":313}]},{"type":"TextLine","bbox":{"x":96.5,"y":940.4,"w":614.1,"h":14.7},"pi":314,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":940.4,"w":614.0,"h":14.7},"text":"따라서 수색구조 관계전문가들로 구성된 상시기구의 위원회체제를 도입하여 급변하는 연안","pi":314}]},{"type":"TextLine","bbox":{"x":83.1,"y":962.5,"w":627.4,"h":14.7},"pi":314,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":962.5,"w":634.1,"h":14.7},"text":"환경변화와 그에 따른 수색구조업무확대 등을 고려한 기본계획을 수립하고, 해역별 특성 및 ","pi":314}]},{"type":"TextLine","bbox":{"x":83.1,"y":984.5,"w":627.4,"h":14.7},"pi":314,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":984.5,"w":144.0,"h":14.7},"text":"국내외 시장환경 조사","pi":314},{"type":"TextRun","bbox":{"x":227.1,"y":984.5,"w":7.0,"h":14.7},"text":"ㆍ","pi":314},{"type":"TextRun","bbox":{"x":234.1,"y":984.5,"w":471.0,"h":14.7},"text":"분석 등 다양한 업무추진을 통하여 효율적 사업추진을 기대할 수 있다.","pi":314}]}]}]},{"type":"Footer","bbox":{"x":83.1,"y":1009.1,"w":627.4,"h":56.7},"children":[{"type":"TextLine","bbox":{"x":369.9,"y":1028.6,"w":54.0,"h":16.0},"pi":0,"children":[{"type":"TextRun","bbox":{"x":369.9,"y":1041.9,"w":54.0,"h":13.3},"text":"- 300 -","pi":0}]}]}]}