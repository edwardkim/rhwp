{"type":"Page","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5},"children":[{"type":"PageBg","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5}},{"type":"Header","bbox":{"x":83.1,"y":56.7,"w":627.4,"h":56.7}},{"type":"Body","bbox":{"x":83.1,"y":113.4,"w":627.4,"h":895.7},"children":[{"type":"Column","bbox":{"x":83.1,"y":113.4,"w":627.4,"h":895.7},"col":0,"children":[{"type":"TextLine","bbox":{"x":96.5,"y":113.4,"w":614.1,"h":14.7},"pi":288,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":113.4,"w":614.1,"h":14.7},"text":"","pi":288}]},{"type":"TextLine","bbox":{"x":93.8,"y":151.4,"w":616.7,"h":14.7},"pi":289,"children":[{"type":"TextRun","bbox":{"x":93.8,"y":151.4,"w":340.0,"h":14.7},"text":"나. 효율적 사업추진을 위한 최적의 예산편성 방법","pi":289}]},{"type":"TextLine","bbox":{"x":96.5,"y":184.5,"w":614.1,"h":14.7},"pi":290,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":184.5,"w":49.0,"h":14.7},"text":"하향식(","pi":290},{"type":"TextRun","bbox":{"x":145.5,"y":184.5,"w":77.0,"h":14.7},"text":"top-down) ","pi":290},{"type":"TextRun","bbox":{"x":222.5,"y":184.5,"w":489.0,"h":14.7},"text":"예산편성은 총예산을 분야별, 부처별로 사전적으로 배분결정하고 구체적","pi":290}]},{"type":"TextLine","bbox":{"x":83.1,"y":206.5,"w":627.4,"h":14.7},"pi":290,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":206.5,"w":627.0,"h":14.7},"text":"인 사업별 예산배분은 해당부처에서 자율적으로 결정토록하며 다만 중앙예산기구는 재원배","pi":290}]},{"type":"TextLine","bbox":{"x":83.1,"y":228.5,"w":627.4,"h":14.7},"pi":290,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":228.5,"w":569.0,"h":14.7},"text":"분기준을 시달하고 사후에 배분의 적합성을 점검토록 하는 것을 의미한다고 하였다.","pi":290}]},{"type":"TextLine","bbox":{"x":96.5,"y":257.2,"w":614.1,"h":14.7},"pi":291,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":257.2,"w":614.0,"h":14.7},"text":"연안구조장비도입에 관련된 사업추진 부서는 현재의 조직체계에서 보면 해양경찰청 경비","pi":291}]},{"type":"TextLine","bbox":{"x":83.1,"y":279.3,"w":627.4,"h":14.7},"pi":291,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":279.3,"w":627.0,"h":14.7},"text":"구난국으로 하위부서로는 수색구조과가 된다. 그리고 연안구조장비 필요부서로는 각 해양경","pi":291}]},{"type":"TextLine","bbox":{"x":83.1,"y":301.3,"w":627.4,"h":14.7},"pi":291,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":301.3,"w":161.0,"h":14.7},"text":"찰관서 산하 파출소 및 ","pi":291},{"type":"TextRun","bbox":{"x":244.1,"y":301.3,"w":22.0,"h":14.7},"text":"122","pi":291},{"type":"TextRun","bbox":{"x":266.1,"y":301.3,"w":437.0,"h":14.7},"text":"해양경찰구조대 등 구조업무를 담당하고 있는 부서가 될 것이다.","pi":291}]},{"type":"TextLine","bbox":{"x":96.5,"y":330.0,"w":614.1,"h":14.7},"pi":292,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":330.0,"w":614.0,"h":14.7},"text":"따라서 현재 해양경찰청 조직체계에서 정책수립 및 예산편성, 운용부서를 기준으로 도식화","pi":292}]},{"type":"TextLine","bbox":{"x":83.1,"y":352.0,"w":627.4,"h":14.7},"pi":292,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":352.0,"w":121.0,"h":14.7},"text":"하면 다음과 같다.","pi":292}]},{"type":"TextLine","bbox":{"x":96.5,"y":380.7,"w":614.1,"h":8.0},"pi":293,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":380.7,"w":614.1,"h":8.0},"text":"","pi":293}]},{"type":"TextLine","bbox":{"x":83.1,"y":392.7,"w":627.4,"h":303.8},"pi":294,"children":[{"type":"Image","bbox":{"x":146.2,"y":392.7,"w":501.4,"h":274.0},"pi":294,"ci":0,"textWrap":"TopAndBottom"},{"type":"TextRun","bbox":{"x":647.5,"y":392.7,"w":0.0,"h":303.8},"text":"","pi":294}]},{"type":"TextLine","bbox":{"x":146.2,"y":678.0,"w":501.4,"h":14.7},"pi":0,"children":[{"type":"TextRun","bbox":{"x":223.9,"y":678.0,"w":8.0,"h":14.7},"text":"<","pi":0},{"type":"TextRun","bbox":{"x":231.9,"y":678.0,"w":37.0,"h":14.7},"text":"그림 ","pi":0},{"type":"TextRun","bbox":{"x":268.9,"y":678.0,"w":37.0,"h":14.7},"text":"3. > ","pi":0},{"type":"TextRun","bbox":{"x":305.9,"y":678.0,"w":264.0,"h":14.7},"text":"해양경찰청 연안구조장비 도입관련부서","pi":0}]},{"type":"TextLine","bbox":{"x":96.5,"y":710.5,"w":614.1,"h":8.0},"pi":295,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":710.5,"w":614.1,"h":8.0},"text":"","pi":295}]},{"type":"TextLine","bbox":{"x":96.5,"y":729.2,"w":614.1,"h":14.7},"pi":296,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":729.2,"w":614.0,"h":14.7},"text":"연안구조장비 도입과 관련부서는 예산을 다루는 부서와 구조장비도입계획을 수립하는 본","pi":296}]},{"type":"TextLine","bbox":{"x":83.1,"y":751.2,"w":627.4,"h":14.7},"pi":296,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":751.2,"w":627.0,"h":14.7},"text":"청업무 그리고 연안구조장비를 운용하는 장비운용부서로 구분되며, 예산부서로는 본청 운영","pi":296}]},{"type":"TextLine","bbox":{"x":83.1,"y":773.2,"w":627.4,"h":14.7},"pi":296,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":773.2,"w":627.0,"h":14.7},"text":"지원과, 지방청의 경우 경무기획과 소속 기획예산계 그리고 해양경찰서 경무기획과 소속 경","pi":296}]},{"type":"TextLine","bbox":{"x":83.1,"y":795.3,"w":627.4,"h":14.7},"pi":296,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":795.3,"w":136.0,"h":14.7},"text":"리계로 볼 수 있다. ","pi":296}]},{"type":"TextLine","bbox":{"x":96.5,"y":823.9,"w":614.1,"h":14.7},"pi":297,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":823.9,"w":614.0,"h":14.7},"text":"따라서 연안구조장비 도입을 위해 본청 수색구조과에서 장비도입계획을 수립하며 이는 장","pi":297}]},{"type":"TextLine","bbox":{"x":83.1,"y":846.0,"w":627.4,"h":14.7},"pi":297,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":846.0,"w":202.0,"h":14.7},"text":"비운용부서인 각 해양경찰서 ","pi":297},{"type":"TextRun","bbox":{"x":285.1,"y":846.0,"w":22.0,"h":14.7},"text":"122","pi":297},{"type":"TextRun","bbox":{"x":307.1,"y":846.0,"w":187.0,"h":14.7},"text":"해양구조대와 경찰서 산하 ","pi":297},{"type":"TextRun","bbox":{"x":494.1,"y":846.0,"w":15.0,"h":14.7},"text":"74","pi":297},{"type":"TextRun","bbox":{"x":509.1,"y":846.0,"w":202.0,"h":14.7},"text":"개 파출소에서 제출한 현황보","pi":297}]},{"type":"TextLine","bbox":{"x":83.1,"y":868.0,"w":627.4,"h":14.7},"pi":297,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":868.0,"w":628.0,"h":14.7},"text":"고서를 검토하여 고려하면 될 것이다. 또한 정책수립의 협조부서로 본청 및 해양경찰서 해상","pi":297}]},{"type":"TextLine","bbox":{"x":83.1,"y":890.0,"w":627.4,"h":14.7},"pi":297,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":890.0,"w":422.0,"h":14.7},"text":"안전과 및 수상레저 관련 업무부서도 연계되어 수립하면 된다.","pi":297}]},{"type":"TextLine","bbox":{"x":96.5,"y":918.7,"w":614.1,"h":14.7},"pi":298,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":918.7,"w":614.0,"h":14.7},"text":"사업추진의 효율성과 객관적 투명성을 답보하기 위한 정책추진으로 현행 정부예산 편성제","pi":298}]},{"type":"TextLine","bbox":{"x":83.1,"y":940.7,"w":627.4,"h":14.7},"pi":298,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":940.7,"w":627.0,"h":14.7},"text":"도의 하나인 하향식 예산편성제도의 도입과 가칭 “연안구조장비도입평가위원회” 신설을 제","pi":298}]},{"type":"TextLine","bbox":{"x":83.1,"y":962.8,"w":627.4,"h":14.7},"pi":298,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":962.8,"w":634.7,"h":14.7},"text":"시하고자 한다. 물론 하향식 예산편성제도는 현재 시행되고 있는 것이며, 이를 연안구조장비 ","pi":298}]},{"type":"TextLine","bbox":{"x":83.1,"y":984.8,"w":627.4,"h":14.7},"pi":298,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":984.8,"w":246.0,"h":14.7},"text":"도입을 위한 측면에서 재검토하였다.","pi":298}]}]}]},{"type":"Footer","bbox":{"x":83.1,"y":1009.1,"w":627.4,"h":56.7},"children":[{"type":"TextLine","bbox":{"x":369.9,"y":1028.6,"w":54.0,"h":16.0},"pi":0,"children":[{"type":"TextRun","bbox":{"x":369.9,"y":1041.9,"w":54.0,"h":13.3},"text":"- 299 -","pi":0}]}]}]}