x":{"x":109.8,"y":759.6,"w":600.7,"h":14.7},"pi":341,"children":[{"type":"TextRun","bbox":{"x":109.8,"y":759.6,"w":24.0,"h":14.7},"text":"(4) ","pi":341},{"type":"TextRun","bbox":{"x":133.8,"y":759.6,"w":169.0,"h":14.7},"text":"집행 단계의 체크 리스트","pi":341}]},{"type":"TextLine","bbox":{"x":96.5,"y":788.3,"w":614.1,"h":14.7},"pi":342,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":788.3,"w":614.0,"h":14.7},"text":"집행단계에서는 기획단계에서 마련된 대로 되고 있는지를 검토하고 있는 것이 가장 중요","pi":342}]},{"type":"TextLine","bbox":{"x":83.1,"y":810.4,"w":627.4,"h":14.7},"pi":342,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":810.4,"w":628.0,"h":14.7},"text":"하며, 특히 사업자를 잘 선택하고 최적의 비용으로 집행하고 있는가를 검토하여야 한다. 그","pi":342}]},{"type":"TextLine","bbox":{"x":83.1,"y":832.4,"w":627.4,"h":14.7},"pi":342,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":832.4,"w":554.0,"h":14.7},"text":"리고 기획 단계에서의 정해진 계획과 차이가 있는 경우 그 이유가 명확해야 한다.","pi":342}]},{"type":"TextLine","bbox":{"x":96.5,"y":861.1,"w":614.1,"h":14.7},"pi":343,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":861.1,"w":621.6,"h":14.7},"text":"한편 사업 시행과 관련하여 계획대로 집행하느냐도 중요하다. 예컨대 생활보호 대상자에게 복지 ","pi":343}]},{"type":"TextLine","bbox":{"x":83.1,"y":883.1,"w":627.4,"h":14.7},"pi":343,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":883.1,"w":628.0,"h":14.7},"text":"서비스를 전달하는 경우 적격자를 어떻게 관리하느냐와 관련하여 자격 관리 과정이 중요하다. 그","pi":343}]},{"type":"TextLine","bbox":{"x":83.1,"y":905.1,"w":627.4,"h":14.7},"pi":343,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":905.1,"w":617.0,"h":14.7},"text":"리고 보다 중요한 것은 필요한 시기에 예산 사업이 시행되고 있느냐를 관리하는 것이 중요하다. ","pi":343}]},{"type":"TextLine","bbox":{"x":96.5,"y":933.8,"w":614.1,"h":14.7},"pi":344,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":933.8,"w":620.8,"h":14.7},"text":"이러한 맥락에서 예산의 집행과 관련하여서는 사업자 선정 과정과 사업의 집행과 관련한 ","pi":344}]},{"type":"TextLine","bbox":{"x":83.1,"y":955.9,"w":627.4,"h":14.7},"pi":344,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":955.9,"w":246.0,"h":14.7},"text":"예산 집행 등이 체크 포인트가 된다.","pi":344}]},{"type":"TextLine","bbox":{"x":96.5,"y":984.5,"w":614.1,"h":14.7},"pi":345,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":984.5,"w":614.1,"h":14.7},"text":"","pi":345}]}]}]},{"type":"Footer","bbox":{"x":83.1,"y":1009.1,"w":627.4,"h":56.7},"children":[{"type":"TextLine","bbox":{"x":369.9,"y":1028.6,"w":54.0,"h":16.0},"pi":0,"children":[{"type":"TextRun","bbox":{"x":369.9,"y":1041.9,"w":54.0,"h":13.3},"text":"- 304 -","pi":0}]}]}]}