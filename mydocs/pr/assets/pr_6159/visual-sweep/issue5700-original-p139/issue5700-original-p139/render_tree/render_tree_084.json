{"type":"Page","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5},"children":[{"type":"PageBg","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5}},{"type":"Header","bbox":{"x":83.1,"y":56.7,"w":627.4,"h":56.7}},{"type":"Body","bbox":{"x":83.1,"y":113.4,"w":627.4,"h":895.7},"children":[{"type":"Column","bbox":{"x":83.1,"y":113.4,"w":627.4,"h":895.7},"col":0,"children":[{"type":"TextLine","bbox":{"x":83.1,"y":113.4,"w":627.4,"h":14.7},"pi":274,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":113.4,"w":180.0,"h":14.7},"text":"재원배분을 결정하게 된다.","pi":274}]},{"type":"TextLine","bbox":{"x":109.8,"y":144.7,"w":600.7,"h":14.7},"pi":275,"children":[{"type":"TextRun","bbox":{"x":109.8,"y":144.7,"w":24.0,"h":14.7},"text":"(4) ","pi":275},{"type":"TextRun","bbox":{"x":133.8,"y":144.7,"w":235.0,"h":14.7},"text":"재원배분 기준과 이의 적합성 점검","pi":275}]},{"type":"TextLine","bbox":{"x":96.5,"y":173.4,"w":614.1,"h":14.7},"pi":276,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":173.4,"w":462.0,"h":14.7},"text":"각 지출부처가 자신들에게 할당된 분야별, 부처별 재원배분의 한도(","pi":276},{"type":"TextRun","bbox":{"x":558.5,"y":173.4,"w":56.0,"h":14.7},"text":"ceiling) ","pi":276},{"type":"TextRun","bbox":{"x":614.5,"y":173.4,"w":96.0,"h":14.7},"text":"내에서 사업별","pi":276}]},{"type":"TextLine","bbox":{"x":83.1,"y":195.5,"w":627.4,"h":14.7},"pi":276,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":195.5,"w":627.0,"h":14.7},"text":"로 재원을 배분하고 나면 이를 중앙예산기구에 제출하게 된다. 중앙예산기구는 사전에 재원","pi":276}]},{"type":"TextLine","bbox":{"x":83.1,"y":217.5,"w":627.4,"h":14.7},"pi":276,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":217.5,"w":71.0,"h":14.7},"text":"배분 기준(","pi":276},{"type":"TextRun","bbox":{"x":154.1,"y":217.5,"w":66.0,"h":14.7},"text":"guideline)","pi":276},{"type":"TextRun","bbox":{"x":220.1,"y":217.5,"w":490.0,"h":14.7},"text":"을 마련하여 시달한 바 있는데 지출부서 내의 예산배분이 이 기준에 부","pi":276}]},{"type":"TextLine","bbox":{"x":83.1,"y":239.5,"w":627.4,"h":14.7},"pi":276,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":239.5,"w":634.4,"h":14.7},"text":"합되는지를 점검하게 된다. 중앙예산기구는 사업별 예산편성을 할 때 지출부처별로 상이한 ","pi":276}]},{"type":"TextLine","bbox":{"x":83.1,"y":261.5,"w":627.4,"h":14.7},"pi":276,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":261.5,"w":308.0,"h":14.7},"text":"기준, 단가 등이 적용되지 않도록 해야 한다. ","pi":276}]},{"type":"TextLine","bbox":{"x":103.1,"y":296.9,"w":607.4,"h":16.0},"pi":277,"children":[{"type":"TextRun","bbox":{"x":103.1,"y":296.9,"w":21.0,"h":16.0},"text":"2) ","pi":277},{"type":"TextRun","bbox":{"x":124.1,"y":296.9,"w":184.0,"h":16.0},"text":"하향식 예산편성의 효과 ","pi":277}]},{"type":"TextLine","bbox":{"x":96.5,"y":332.4,"w":614.1,"h":14.7},"pi":278,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":332.4,"w":498.0,"h":14.7},"text":"하향식 예산편성제도가 갖고 있는 긍정적인 측면의 효과들은 대체로 다음과 같은 ","pi":278},{"type":"TextRun","bbox":{"x":594.5,"y":332.4,"w":7.0,"h":14.7},"text":"4","pi":278},{"type":"TextRun","bbox":{"x":601.5,"y":332.4,"w":108.0,"h":14.7},"text":"가지로 요약된다. ","pi":278}]},{"type":"TextLine","bbox":{"x":109.8,"y":363.7,"w":600.7,"h":14.7},"pi":279,"children":[{"type":"TextRun","bbox":{"x":109.8,"y":363.7,"w":24.0,"h":14.7},"text":"(1) ","pi":279},{"type":"TextRun","bbox":{"x":133.8,"y":363.7,"w":198.0,"h":14.7},"text":"재원배분 규모의 최적성 확보","pi":279}]},{"type":"TextLine","bbox":{"x":96.5,"y":392.4,"w":614.1,"h":14.7},"pi":280,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":392.4,"w":621.8,"h":14.7},"text":"하향식 예산편성 제도하에서는 상향식의 경우와 비교하여 재원배분규모의 결정이 좀 더 ","pi":280}]},{"type":"TextLine","bbox":{"x":83.1,"y":414.5,"w":627.4,"h":14.7},"pi":280,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":414.5,"w":628.0,"h":14.7},"text":"최적성에 근접시킬 수 있다는 장점이 있다. 이렇게 이야기기할 수 있는 근거로는 하향식제도","pi":280}]},{"type":"TextLine","bbox":{"x":83.1,"y":436.5,"w":627.4,"h":14.7},"pi":280,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":436.5,"w":628.0,"h":14.7},"text":"에서는 국가의 정책목표, 분야별 투자우선순위 등을 설정함에 있어서 전체 지출부처 및 국민","pi":280}]},{"type":"TextLine","bbox":{"x":83.1,"y":458.5,"w":627.4,"h":14.7},"pi":280,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":458.5,"w":633.7,"h":14.7},"text":"이 참여하는 토론 등을 거쳐 공감대를 형성하여 결정하기 때문에 최소한 중양예산기구와 각 ","pi":280}]},{"type":"TextLine","bbox":{"x":83.1,"y":480.5,"w":627.4,"h":14.7},"pi":280,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":480.5,"w":591.0,"h":14.7},"text":"지출부처간에 존재할 수 있는 “비용인식” 의 불일치 문제를 어느 정도 해소할 수 있다.","pi":280}]},{"type":"TextLine","bbox":{"x":96.5,"y":509.2,"w":614.1,"h":14.7},"pi":281,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":509.2,"w":614.0,"h":14.7},"text":"하향식 예산편성제도에서 중기 재정계획에 입각한 재원배분 규모를 중기적인 시각에서 결","pi":281}]},{"type":"TextLine","bbox":{"x":83.1,"y":531.3,"w":627.4,"h":14.7},"pi":281,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":531.3,"w":627.0,"h":14.7},"text":"정하고 이를 부처별로 사전적으로 배분규모를 결정한다면 재정지출규모를 효율적으로 통제","pi":281}]},{"type":"TextLine","bbox":{"x":83.1,"y":553.3,"w":627.4,"h":14.7},"pi":281,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":553.3,"w":114.0,"h":14.7},"text":"할 수 있게 된다.","pi":281}]},{"type":"TextLine","bbox":{"x":109.8,"y":584.6,"w":600.7,"h":14.7},"pi":282,"children":[{"type":"TextRun","bbox":{"x":109.8,"y":584.6,"w":24.0,"h":14.7},"text":"(2) ","pi":282},{"type":"TextRun","bbox":{"x":133.8,"y":584.6,"w":183.0,"h":14.7},"text":"예산 집행상의 최적성 확보","pi":282}]},{"type":"TextLine","bbox":{"x":96.5,"y":613.3,"w":614.1,"h":14.7},"pi":283,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":613.3,"w":621.5,"h":14.7},"text":"각 지출부처가 할당된 재원배분한도내에서 사업별 예산배분을 자율적으로 결정하기 때문에 ","pi":283}]},{"type":"TextLine","bbox":{"x":83.1,"y":635.4,"w":627.4,"h":14.7},"pi":283,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":635.4,"w":627.0,"h":14.7},"text":"예산집행상의 최적성을 확보할 수 있다. 이는 각 지출부처가 각 사업들에 대한 자신들의 선","pi":283}]},{"type":"TextLine","bbox":{"x":83.1,"y":657.4,"w":627.4,"h":14.7},"pi":283,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":657.4,"w":633.9,"h":14.7},"text":"호를 가장 잘 알고 있기 때문이며 가장 정확한 정보를 갖고 있기 때문이다. 중앙예산기구가 ","pi":283}]},{"type":"TextLine","bbox":{"x":83.1,"y":679.4,"w":627.4,"h":14.7},"pi":283,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":679.4,"w":614.0,"h":14.7},"text":"과거처럼 각 지출부처의 정확한 선호나 정보를 확보하려는 노력은 더 이상 필요 없게 된다.","pi":283}]},{"type":"TextLine","bbox":{"x":96.5,"y":708.1,"w":614.1,"h":14.7},"pi":284,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":708.1,"w":332.0,"h":14.7},"text":"각 지출부처는 부처별 가용재원총액을 예산제약(","pi":284},{"type":"TextRun","bbox":{"x":428.5,"y":708.1,"w":124.0,"h":14.7},"text":"budget constraint)","pi":284},{"type":"TextRun","bbox":{"x":552.5,"y":708.1,"w":164.7,"h":14.7},"text":"으로 인식하고 그 범위 ","pi":284}]},{"type":"TextLine","bbox":{"x":83.1,"y":730.1,"w":627.4,"h":14.7},"pi":284,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":730.1,"w":628.0,"h":14.7},"text":"내에서 자율권을 대폭 확대시킬 때 사업부처의 전문성을 발휘할 여지가 넓어지게 되며, 우선","pi":284}]},{"type":"TextLine","bbox":{"x":83.1,"y":752.2,"w":627.4,"h":14.7},"pi":284,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":752.2,"w":628.0,"h":14.7},"text":"순위가 낮은 사업에서 우선순위가 높은 사업으로 재원배분이 이루어져 사업간 최적 예산 배","pi":284}]},{"type":"TextLine","bbox":{"x":83.1,"y":774.2,"w":627.4,"h":14.7},"pi":284,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":774.2,"w":173.0,"h":14.7},"text":"분이 가능하게 될 것이다.","pi":284}]},{"type":"TextLine","bbox":{"x":109.8,"y":805.5,"w":600.7,"h":14.7},"pi":285,"children":[{"type":"TextRun","bbox":{"x":109.8,"y":805.5,"w":24.0,"h":14.7},"text":"(3) ","pi":285},{"type":"TextRun","bbox":{"x":133.8,"y":805.5,"w":217.0,"h":14.7},"text":"재정구조의 단순화, 투명화 촉진","pi":285}]},{"type":"TextLine","bbox":{"x":96.5,"y":834.2,"w":614.1,"h":14.7},"pi":286,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":834.2,"w":614.0,"h":14.7},"text":"하향식 예산편성제도는 총 재원배분규모의 한도를 설정하는 것으로 시작되므로, 각 지출부","pi":286}]},{"type":"TextLine","bbox":{"x":83.1,"y":856.3,"w":627.4,"h":14.7},"pi":286,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":856.3,"w":628.0,"h":14.7},"text":"처의 입장에서는 그 재원한도가 부문별로 지나치게 세분화되는 것을 원치 않을 것이다. 중앙","pi":286}]},{"type":"TextLine","bbox":{"x":83.1,"y":878.3,"w":627.4,"h":14.7},"pi":286,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":878.3,"w":628.0,"h":14.7},"text":"예산기구의 입장에서도 각 지출부처에게 자율권을 부여했기에 부문별로 부수적인 제약을 가","pi":286}]},{"type":"TextLine","bbox":{"x":83.1,"y":900.3,"w":627.4,"h":14.7},"pi":286,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":900.3,"w":634.5,"h":14.7},"text":"할 이유를 별로 느끼지 못하게 될 것이다. 결국 이 제도 하에서는 일부 예외적인 금융성 및 ","pi":286}]},{"type":"TextLine","bbox":{"x":83.1,"y":922.3,"w":627.4,"h":14.7},"pi":286,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":922.3,"w":633.8,"h":14.7},"text":"적립성 기금을 제외하고는 일반회계, 특별회계, 기금이 하나로 통합되려는 압력이 작용하게 ","pi":286}]},{"type":"TextLine","bbox":{"x":83.1,"y":944.4,"w":627.4,"h":14.7},"pi":286,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":944.4,"w":547.0,"h":14.7},"text":"될 것이며 따라서 현재의 복잡한 재정구조가 단순화되고 투명화 될 여지가 크다.","pi":286}]},{"type":"TextLine","bbox":{"x":96.5,"y":973.1,"w":614.1,"h":14.7},"pi":287,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":973.1,"w":614.1,"h":14.7},"text":"","pi":287}]}]}]},{"type":"Footer","bbox":{"x":83.1,"y":1009.1,"w":627.4,"h":56.7},"children":[{"type":"TextLine","bbox":{"x":369.9,"y":1028.6,"w":54.0,"h":16.0},"pi":0,"children":[{"type":"TextRun","bbox":{"x":369.9,"y":1041.9,"w":54.0,"h":13.3},"text":"- 298 -","pi":0}]}]}]}