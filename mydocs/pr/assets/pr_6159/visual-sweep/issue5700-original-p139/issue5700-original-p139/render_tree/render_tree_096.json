ype":"TextRun","bbox":{"x":615.1,"y":888.9,"w":29.0,"h":14.7},"text":"2008","pi":403},{"type":"TextRun","bbox":{"x":644.1,"y":888.9,"w":66.0,"h":14.7},"text":"년에는 내","pi":403}]},{"type":"TextLine","bbox":{"x":83.1,"y":910.9,"w":627.4,"h":14.7},"pi":403,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":910.9,"w":627.0,"h":14.7},"text":"수면과 해수면의 안전관리 체계를 일원화하는 내용의 수상레저안전법을 개정하여, 수상레저","pi":403}]},{"type":"TextLine","bbox":{"x":83.1,"y":933.0,"w":627.4,"h":14.7},"pi":403,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":933.0,"w":628.0,"h":14.7},"text":"안전관리지침을 마련 시·도에 통보하고 내수면 안전관리를 위한 해양경찰과 지자체 간의 긴","pi":403}]},{"type":"TextLine","bbox":{"x":83.1,"y":955.0,"w":627.4,"h":14.7},"pi":403,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":955.0,"w":231.0,"h":14.7},"text":"밀한 협조체제를 유지하게 되었다.","pi":403}]},{"type":"TextLine","bbox":{"x":96.5,"y":983.7,"w":614.1,"h":14.7},"pi":404,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":983.7,"w":614.0,"h":14.7},"text":"이에 따라 내수면으로까지의 해양경찰의 안전관리업무가 확대됨에 따라 대응인력의 증원","pi":404}]},{"type":"TextLine","bbox":{"x":83.1,"y":1005.7,"w":627.4,"h":14.7},"pi":404,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":1005.7,"w":628.0,"h":14.7},"text":"은 필수적이다. 안전사고 발생의 최소화를 위한 다양한 예방활동 및 정책들이 수반되어 추진","pi":404}]},{"type":"TextLine","bbox":{"x":83.1,"y":1027.7,"w":627.4,"h":14.7},"pi":404,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":1027.7,"w":628.0,"h":14.7},"text":"될 것이나 사고발생은 언제 어느 순간에 발생할지는 예측이 어렵기 때문에 예방활동 못지않","pi":404}]}]}]},{"type":"Footer","bbox":{"x":83.1,"y":1009.1,"w":627.4,"h":56.7},"children":[{"type":"TextLine","bbox":{"x":369.9,"y":1028.6,"w":54.0,"h":16.0},"pi":0,"children":[{"type":"TextRun","bbox":{"x":369.9,"y":1041.9,"w":54.0,"h":13.3},"text":"- 310 -","pi":0}]}]}]}