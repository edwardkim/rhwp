n","bbox":{"x":83.1,"y":639.0,"w":634.1,"h":14.7},"text":"화하는 것이 필요하다고 한다. 아울러 일반적인 기준과 체크 리스트를 정한 다음에 구체적인 ","pi":326}]},{"type":"TextLine","bbox":{"x":83.1,"y":661.0,"w":627.4,"h":14.7},"pi":326,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":661.0,"w":576.0,"h":14.7},"text":"개별 사업에 대해 체크 리스트를 정하는 방식으로 전개하는 것이 효율적이라고 한다.","pi":326}]},{"type":"TextLine","bbox":{"x":109.8,"y":692.4,"w":600.7,"h":14.7},"pi":327,"children":[{"type":"TextRun","bbox":{"x":109.8,"y":692.4,"w":24.0,"h":14.7},"text":"(1) ","pi":327},{"type":"TextRun","bbox":{"x":133.8,"y":692.4,"w":132.0,"h":14.7},"text":"사업의 유형화 기준","pi":327}]},{"type":"TextLine","bbox":{"x":96.5,"y":721.1,"w":614.1,"h":14.7},"pi":328,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":721.1,"w":255.0,"h":14.7},"text":"성과관리를 위한 재정사업 자율평가(","pi":328},{"type":"TextRun","bbox":{"x":351.5,"y":721.1,"w":44.0,"h":14.7},"text":"PART)","pi":328},{"type":"TextRun","bbox":{"x":395.5,"y":721.1,"w":162.0,"h":14.7},"text":"에서는 사업의 유형을 ","pi":328},{"type":"TextRun","bbox":{"x":557.5,"y":721.1,"w":43.0,"h":14.7},"text":"SOC, ","pi":328},{"type":"TextRun","bbox":{"x":600.5,"y":721.1,"w":29.0,"h":14.7},"text":"시설","pi":328},{"type":"TextRun","bbox":{"x":629.5,"y":721.1,"w":7.0,"h":14.7},"text":"⋅","pi":328},{"type":"TextRun","bbox":{"x":636.5,"y":721.1,"w":80.2,"h":14.7},"text":"장비, 기타 ","pi":328}]},{"type":"TextLine","bbox":{"x":83.1,"y":743.1,"w":627.4,"h":14.7},"pi":328,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":743.1,"w":70.0,"h":14.7},"text":"직접, 출연","pi":328},{"type":"TextRun","bbox":{"x":153.1,"y":743.1,"w":7.0,"h":14.7},"text":"⋅","pi":328},{"type":"TextRun","bbox":{"x":160.1,"y":743.1,"w":298.0,"h":14.7},"text":"출자, 융자 사업, 민간보조, 지자체 보조 등 ","pi":328},{"type":"TextRun","bbox":{"x":458.1,"y":743.1,"w":7.0,"h":14.7},"text":"7","pi":328},{"type":"TextRun","bbox":{"x":465.1,"y":743.1,"w":195.0,"h":14.7},"text":"개 사업으로 구분하고 있다. ","pi":328}]},{"type":"TextLine","bbox":{"x":96.5,"y":771.8,"w":614.1,"h":14.7},"pi":329,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":771.8,"w":614.0,"h":14.7},"text":"그러나 실제 예산 방지 매뉴얼은 이러한 대분류 보다는 보다는 보다 구체적인 프로그램이","pi":329}]},{"type":"TextLine","bbox":{"x":83.1,"y":793.8,"w":627.4,"h":14.7},"pi":329,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":793.8,"w":628.0,"h":14.7},"text":"나 사업 단위로 세분화될 필요가 있다. 일반론적인 접근 보다는 예산 낭비 대응 센터에 접수","pi":329}]},{"type":"TextLine","bbox":{"x":83.1,"y":815.9,"w":627.4,"h":14.7},"pi":329,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":815.9,"w":633.6,"h":14.7},"text":"된 사업이나 언론이나 시민사회에서 반복적으로 문제가 제기되는 사업을 중심으로 매뉴얼을 ","pi":329}]},{"type":"TextLine","bbox":{"x":83.1,"y":837.9,"w":627.4,"h":14.7},"pi":329,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":837.9,"w":202.0,"h":14.7},"text":"작성할 필요가 있기 때문이다.","pi":329}]},{"type":"TextLine","bbox":{"x":109.8,"y":869.3,"w":600.7,"h":14.7},"pi":330,"children":[{"type":"TextRun","bbox":{"x":109.8,"y":869.3,"w":24.0,"h":14.7},"text":"(2) ","pi":330},{"type":"TextRun","bbox":{"x":133.8,"y":869.3,"w":176.0,"h":14.7},"text":"체크리스트의 일반적 항목","pi":330}]},{"type":"TextLine","bbox":{"x":96.5,"y":897.9,"w":614.1,"h":14.7},"pi":331,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":897.9,"w":621.7,"h":14.7},"text":"매뉴얼은 기획 단계와 집행단계 그리고 평가 단계로 구분하여 작성 가능하다. 그리고 개별 ","pi":331}]},{"type":"TextLine","bbox":{"x":83.1,"y":920.0,"w":627.4,"h":14.7},"pi":331,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":920.0,"w":268.0,"h":14.7},"text":"단계 별로 핵심 점검 사항이 정리된다. ","pi":331},{"type":"TextRun","bbox":{"x":351.1,"y":920.0,"w":38.0,"h":14.7},"text":"PART","pi":331},{"type":"TextRun","bbox":{"x":389.1,"y":920.0,"w":328.1,"h":14.7},"text":"가 재정 운영의 측면에서 개발된 것이라면 체크 ","pi":331}]},{"type":"TextLine","bbox":{"x":83.1,"y":942.0,"w":627.4,"h":14.7},"pi":331,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":942.0,"w":615.0,"h":14.7},"text":"리스트는 사업 부서에서 사업 운영의 효율성을 기하기 위해 작성된다는 점에서 차이가 있다.","pi":331}]},{"type":"TextLine","bbox":{"x":96.5,"y":970.7,"w":614.1,"h":14.7},"pi":332,"children":[{"type":"TextRun","bb