xtRun","bbox":{"x":96.5,"y":823.9,"w":614.0,"h":14.7},"text":"따라서 도입기준에 대한 개선이 무엇보다도 필요하였으며, 이를 위해서는 도입되는 연안구","pi":493}]},{"type":"TextLine","bbox":{"x":83.1,"y":845.9,"w":627.4,"h":14.7},"pi":493,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":845.9,"w":415.0,"h":14.7},"text":"조정의 활용목적에 따른 도입 기준이 마련 될 필요가 있었다.","pi":493}]},{"type":"TextLine","bbox":{"x":96.5,"y":874.6,"w":614.1,"h":14.7},"pi":494,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":874.6,"w":226.0,"h":14.7},"text":"도입기준 개선(안)은 다음과 같다.","pi":494}]},{"type":"TextLine","bbox":{"x":96.5,"y":903.3,"w":614.1,"h":14.7},"pi":495,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":903.3,"w":614.0,"h":14.7},"text":"첫째 고속제트보트는 연안내 해상사고 긴급 대응을 위해 각 파․출장소별로 배치하며, 평","pi":495}]},{"type":"TextLine","bbox":{"x":83.1,"y":925.3,"w":627.4,"h":14.7},"pi":495,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":925.3,"w":481.0,"h":14.7},"text":"시에는 해상순찰 등 민생치안 업무목적으로도 활용이 가능하여야 한다.","pi":495}]},{"type":"TextLine","bbox":{"x":96.5,"y":954.0,"w":614.1,"h":14.7},"pi":496,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":954.0,"w":187.0,"h":14.7},"text":"둘째 수상오토바이는 국내 ","pi":496},{"type":"TextRun","bbox":{"x":283.5,"y":954.0,"w":22.0,"h":14.7},"text":"350","pi":496},{"type":"TextRun","bbox":{"x":305.5,"y":954.0,"w":406.0,"h":14.7},"text":"여개 전국 해수욕장 중에 해양경찰 구조대원 상주 또는 순","pi":496}]},{"type":"TextLine","bbox":{"x":83.1,"y":976.0,"w":627.4,"h":14.7},"pi":496,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":976.0,"w":627.0,"h":14.7},"text":"찰 지역을 기준으로 산정할 필요가 있었는데, 수상오토바이 운용특성상 사계절 활용성이 떨","pi":496}]},{"type":"TextLine","bbox":{"x":83.1,"y":998.0,"w":627.4,"h":14.7},"pi":496,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":998.0,"w":627.0,"h":14.7},"text":"어지나, 기동력은 뛰어난 특성을 가지고 있으므로 수난사고 시 즉시 대응을 목적으로 한 배","pi":496}]},{"type":"TextLine","bbox":{"x":83.1,"y":1020.1,"w":627.4,"h":14.7},"pi":496,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":1020.1,"w":385.0,"h":14.7},"text":"치가 중요하다고 보아 해수욕장 배치를 기준으로 하였다.","pi":496}]}]}