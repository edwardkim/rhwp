4,"h":14.7},"pi":257,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":206.5,"w":634.0,"h":14.7},"text":"으로 인해 버려진 폐목과 로프, 폐그물망 등 선체 운용에 많은 돌발적 상황 등이 발생한다. 따라서 ","pi":257}]},{"type":"TextLine","bbox":{"x":83.1,"y":228.5,"w":627.4,"h":14.7},"pi":257,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":228.5,"w":469.0,"h":14.7},"text":"이런 취약 지역에서도 충분히 임무수행을 하기 위한 장비 선정이 필요하다.","pi":257}]},{"type":"TextLine","bbox":{"x":93.8,"y":266.6,"w":616.7,"h":14.7},"pi":258,"children":[{"type":"TextRun","bbox":{"x":93.8,"y":266.6,"w":98.0,"h":14.7},"text":"다. 운행용이성","pi":258}]},{"type":"TextLine","bbox":{"x":96.5,"y":299.6,"w":614.1,"h":14.7},"pi":259,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":299.6,"w":614.0,"h":14.7},"text":"저수심 환경과 높은 파고에서도 안정적으로 그리고 연안구조정 엔진 및 프로펠러 등이 손","pi":259}]},{"type":"TextLine","bbox":{"x":83.1,"y":321.7,"w":627.4,"h":14.7},"pi":259,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":321.7,"w":290.0,"h":14.7},"text":"상 받지 않을 수 있는 구조가 되어야 한다.","pi":259}]},{"type":"TextLine","bbox":{"x":96.5,"y":350.3,"w":614.1,"h":14.7},"pi":260,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":350.3,"w":614.0,"h":14.7},"text":"또한 연안구조정은 현장 대응업무가 많은 파출장소 등에 배치되는 데, 근무환경상 많은 인","pi":260}]},{"type":"TextLine","bbox":{"x":83.1,"y":372.4,"w":627.4,"h":14.7},"pi":260,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":372.4,"w":627.0,"h":14.7},"text":"력이 근무하지 못하므로 근무자 누구라도 손쉽게 조작이 가능하여 사고대응을 위한 긴급출","pi":260}]},{"type":"TextLine","bbox":{"x":83.1,"y":394.4,"w":627.4,"h":14.7},"pi":260,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":394.4,"w":165.0,"h":14.7},"text":"동을 할 수 있어야 한다.","pi":260}]},{"type":"TextLine","bbox":{"x":96.5,"y":423.1,"w":614.1,"h":14.7},"pi":261,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":423.1,"w":614.1,"h":14.7},"text":"","pi":261}]},{"type":"TextLine","bbox":{"x":83.1,"y":445.1,"w":627.4,"h":192.5},"pi":262,"children":[{"type":"Image","bbox":{"x":244.7,"y":446.0,"w":304.3,"h":162.7},"pi":262,"ci":0,"textWrap":"InFrontOfText"},{"type":"