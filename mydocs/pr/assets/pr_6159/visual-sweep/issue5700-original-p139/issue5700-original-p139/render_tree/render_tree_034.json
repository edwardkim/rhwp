[{"type":"TextRun","bbox":{"x":83.1,"y":569.0,"w":393.0,"h":14.7},"text":"이 디젤보다는 유리하여 가솔린을 장착 하는 경우도 많다.","pi":316}]},{"type":"TextLine","bbox":{"x":96.5,"y":597.7,"w":614.1,"h":14.7},"pi":317,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":597.7,"w":614.0,"h":14.7},"text":"그러나 중형 이상의 선체에 사용되는 가솔린 엔진은 선택에 여유가 없고 고장율이 높아짐","pi":317}]},{"type":"TextLine","bbox":{"x":83.1,"y":619.7,"w":627.4,"h":14.7},"pi":317,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":619.7,"w":530.0,"h":14.7},"text":"을 염두에 둬야한다. 그리고 연료 효율도 디젤엔진이 가솔린 엔진에 비하여 ","pi":317},{"type":"TextRun","bbox":{"x":613.1,"y":619.7,"w":67.0,"h":14.7},"text":"30%-40% ","pi":317},{"type":"TextRun","bbox":{"x":680.1,"y":619.7,"w":36.7,"h":14.7},"text":"높아 ","pi":317}]},{"type":"TextLine","bbox":{"x":83.1,"y":641.7,"w":627.4,"h":14.7},"pi":317,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":641.7,"w":627.0,"h":14.7},"text":"장기 사용시 절감효과도 노릴 수 있다. 하지만 디젤 엔진의 성격상 소음 ,중량, 크기 등이 가","pi":317}]},{"type":"TextLine","bbox":{"x":83.1,"y":663.7,"w":627.4,"h":14.7},"pi":317,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":663.7,"w":627.0,"h":14.7},"text":"솔린엔진에 대하여 불리하니 소음, 크기, 경량화 등으로 특화되고 유관기관에 장착되어 검증","pi":317}]},{"type":"TextLine","bbox":{"x":83.1,"y":685.8,"w":627.4,"h":14.7},"pi":317,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":685.8,"w":297.0,"h":14.7},"text":"된 디젤엔진을 사용하는 것이 좋을 것이다. ","pi":317}]},{"type":"TextLine","bbox":{"x":96.5,"y":714.5,"w":614.1,"h":14.7},"pi":318,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":714.5,"w":614.0,"h":14.7},"text":"고장에 대하여 가솔린 엔진에 비하여 스트레스를 덜 받을수 있으나 주요 장치에 전기장치","pi":318}]},{"type":"TextLine","bbox":{"x":83.1,"y":736.5,"w":627.4,"h":14.7},"pi":318,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":736.5,"w":583.0,"h":14.7},"text":"등을 많이 활용하는 엔진보다는 기계적 장치를 많이 사용하는 엔진이 훨씬 유리하다. ","pi":318}]},{"type":"TextLine","bbox":{"x":96.5,"y":765.2,"w":614.1,"h":14.7},"pi":319,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":765.2,"w":517.0,"h":14.7},"text":"이런 부분에서는 유럽쪽이 디젤 엔진에서는 상당히 앞서 있다고 할수 있다. ","pi":319}]},{"type":"TextLine","bbox":{"x":96.5,"y":793.9,"w":614.1,"h":14.7},"pi":320,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":793.9,"w":334.0,"h":14.7},"text":"특히 환경적인 측면까지 고려한다면 더욱 그렇다.","pi":320}]},{"type":"TextLine","bbox":{"x":96.5,"y":822.6,"w":614.1,"h":14.7},"pi":321,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":822.6,"w":620.8,"h":14.7},"text":"마지막으로 선체 문제의 대부분을 차지하는 핵심 부분임으로 여러 인증을 획득한 신뢰성 ","pi":321}]},{"type":"TextLine","bbox":{"x":83.1,"y":844.6,"w":627.4,"h":14.7},"pi":321,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":844.6,"w":628.0,"h":14.7},"text":"있는 제품 선정이 중요하여 원활한 애프터서비스를 위해 국내 취급점이 있고 정비 네트워크","pi":321}]},{"type":"TextLine","bbox":{"x":83.1,"y":866.6,"w":627.4,"h":14.7},"pi":321,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":866.6,"w":319.0,"h":14.7},"text":"가 갖추어진 제품을 선정하는 것이 바람직하다.","pi":321}]},{"type":"TextLine","bbox":{"x":123.1,"y":902.0,"w":587.4,"h":16.0},"pi":322,"children":[{"type":"TextRun","bbox":{"x":123.1,"y":902.0,"w":587.4,"h":16.0},"text":"","pi":322}]},{"type":"TextLine","bbox":{"x":123.1,"y":944.1,"w":587.4,"h":16.0},"pi":323,"children":[{"type":"TextRun","bbox":{"x":123.1,"y":944.1,"w":587.4,"h":16.0},"text":"","pi":323}]},{"type":"TextLine","bbox":{"x":123.1,"y":986.2,"w":587.4,"h":16.0},"pi":324,"children":[{"type":"TextRun","bbox":{"x":123.1,"y":986.2,"w":587.4,"h":16.0},"text":"","pi":324}]}]}]},{"type":"Footer","bbox":{"x":83.1,"y":1009.1,"w":627.4,"h":56.7},"children":[{"type":"TextLine","bbox":{"x":369.9,"y":1028.6,"w":54.0,"h":16.0},"pi":0,"children":[{"type":"TextRun","bbox":{"x":369.9,"y":1041.9,"w":54.0,"h":13.3},"text":"- 248 -","pi":0}]}]}]}