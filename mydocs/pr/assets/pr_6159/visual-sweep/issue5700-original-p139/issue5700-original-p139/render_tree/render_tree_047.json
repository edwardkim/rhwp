x":83.1,"y":667.6,"w":451.0,"h":14.7},"text":"한 삼개국의 협력은 해상에서의 인명구조에 더욱 기여할 것이다.  ","pi":425}]},{"type":"TextLine","bbox":{"x":93.8,"y":705.7,"w":616.7,"h":14.7},"pi":426,"children":[{"type":"TextRun","bbox":{"x":93.8,"y":705.7,"w":106.0,"h":14.7},"text":"가. 일본의 경우","pi":426}]},{"type":"TextLine","bbox":{"x":96.5,"y":738.7,"w":614.1,"h":14.7},"pi":427,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":738.7,"w":614.0,"h":14.7},"text":"최근, 일본은 한국과의 사이에서 한일표준 해사영어 통신훈련, 한일 수색구조 합동훈련 등","pi":427}]},{"type":"TextLine","bbox":{"x":83.1,"y":760.7,"w":627.4,"h":14.7},"pi":427,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":760.7,"w":634.4,"h":14.7},"text":"을 실시하면서 해상사고에서 협력을 추구하고 있다. 그러나 일본은 한국, 중국, 러시아 등을 ","pi":427}]},{"type":"TextLine","bbox":{"x":83.1,"y":782.8,"w":627.4,"h":14.7},"pi":427,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":782.8,"w":634.0,"h":14.7},"text":"포함한 인접한 주변국과의 사이에서 해양경계를 명확하게 확정하지 못하고 있어서 영유권 ","pi":427}]},{"type":"TextLine","bbox":{"x":83.1,"y":804.8,"w":627.4,"h":14.7},"pi":427,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":804.8,"w":633.8,"h":14.7},"text":"논쟁, 불법조업, 대륙붕 개발, 해양조사 등에서 심각한 갈등의 씨앗을 잉태하고 있다. 이러한 ","pi":427}]},{"type":"TextLine","bbox":{"x":83.1,"y":826.8,"w":627.4,"h":14.7},"pi":427,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":826.8,"w":627.0,"h":14.7},"text":"상황에서 해상에서 안전사고가 발생하면 일본 해상보안청의 연안구조정은 즉각적인 기동성","pi":427}]},{"type":"TextLine","bbox":{"x":83.1,"y":848.9,"w":627.4,"h":14.7},"pi":427,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":848.9,"w":187.0,"h":14.7},"text":"을 가지고 대응해야 한다.  ","pi":427}]},{"type":"TextLine","bbox":{"x":96.5,"y":877.5,"w":614.1,"h":14.7},"pi":428,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":877.5,"w":621.8,"h":14.7},"text":"이러한 기동성과 대응성을 위하여 최근 일본의 해상에서는 다양한 전략들이 추구되면서 ","pi":428}]},{"type":"TextLine","bbox":{"x":83.1,"y":899.6,"w":627.4,"h":14.7},"pi":428,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":899.6,"w":628.0,"h":14.7},"text":"해상환경에 변화가 발생하고 있다. 첫째, 해상보안청은 동일한 주기로 연안구조정을 해당지","pi":428}]},{"type":"TextLine","bbox":{"x":83.1,"y":921.6,"w":627.4,"h":14.7},"pi":428,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":921.6,"w":627.0,"h":14.7},"text":"역에 파견하는 것이 아니라 해상활동이 왕성한 시기나 해역을 신축적으로 고려해서 연안구","pi":428}]},{"type":"TextLine","bbox":{"x":83.1,"y":943.6,"w":627.4,"h":14.7},"pi":428,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":943.6,"w":634.3,"h":14.7},"text":"조정의 업무를 지휘하고 있다. 동시에 수색능력과 고속성 등을 포함한 연안구조정의 기계적 ","pi":428}]},{"type":"TextLine","bbox":{"x":83.1,"y":965.7,"w":627.4,"h":14.7},"pi":428,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":965.7,"w":444.0,"h":14.7},"text":"능력을 최대한도로 활용한 구조체제를 수립하려고 하고 있다.    ","pi":428}]},{"type":"TextLine","bbox":{"x":96.5,"y":994.3,"w":614.1,"h":14.7},"pi":429,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":994.3,"w":614.0,"h":14.7},"text":"둘째, 해양안전을 위하여 해상보안청을 포함한 공공기간이 중요역할을 수행하던 과거의 구","pi":429}]},{"type":"TextLine","bbox":{"x":83.1,"y":1016.4,"w":627.4,"h":14.7},"pi":429,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":1016.4,"w":583.0,"h":14.7},"text":"도를 벗어나서 이제는 공공기관과 민간기관 사이에 긴밀한 협력체제가 구축되고 있다.","pi":429}]}]}]},{"type":"Footer","bbox":{"x":83.1,"y":1009.1,"w":627.4,"h":56.7},"children":[{"type":"TextLine","bbox":{"x":369.9,"y":1028.6,"w":54.0,"h":16.0},"pi":0,"children":[{"type":"TextRun","bbox":{"x":369.9,"y":1041.9,"w":54.0,"h":13.3},"text":"- 261 -","pi":0}]}]}]}