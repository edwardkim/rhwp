{"type":"Page","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5},"children":[{"type":"PageBg","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5}},{"type":"Header","bbox":{"x":83.1,"y":56.7,"w":627.4,"h":56.7}},{"type":"Body","bbox":{"x":83.1,"y":113.4,"w":627.4,"h":895.7},"children":[{"type":"Column","bbox":{"x":83.1,"y":113.4,"w":627.4,"h":895.7},"col":0,"children":[{"type":"TextLine","bbox":{"x":83.1,"y":113.4,"w":627.4,"h":14.7},"pi":404,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":113.4,"w":139.0,"h":14.7},"text":"게 신속대응을 통한 ","pi":404},{"type":"TextRun","bbox":{"x":222.1,"y":113.4,"w":7.0,"h":14.7},"text":"2","pi":404},{"type":"TextRun","bbox":{"x":229.1,"y":113.4,"w":481.0,"h":14.7},"text":"차 사고발생을 최소화 할 수는 대응체계 마련이 무엇보다 필요하며, 이","pi":404}]},{"type":"TextLine","bbox":{"x":83.1,"y":135.4,"w":627.4,"h":14.7},"pi":404,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":135.4,"w":488.0,"h":14.7},"text":"를 위한 수색구조 업무를 담당할 인력의 증원은 필연적이라 할 수 있다.","pi":404}]},{"type":"TextLine","bbox":{"x":93.8,"y":173.4,"w":616.7,"h":14.7},"pi":405,"children":[{"type":"TextRun","bbox":{"x":93.8,"y":173.4,"w":252.0,"h":14.7},"text":"마. 일선 해양경찰서 수색구조계 신설","pi":405}]},{"type":"TextLine","bbox":{"x":96.5,"y":206.5,"w":614.1,"h":14.7},"pi":406,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":206.5,"w":620.9,"h":14.7},"text":"앞서 말했듯이 안전사고는 언제 어디서 발생할 지는 예측할 수 없으며, 안전사고 효과적인 ","pi":406}]},{"type":"TextLine","bbox":{"x":83.1,"y":228.5,"w":627.4,"h":14.7},"pi":406,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":228.5,"w":117.0,"h":14.7},"text":"대응체계 마련은 ","pi":406},{"type":"TextRun","bbox":{"x":200.1,"y":228.5,"w":7.0,"h":14.7},"text":"2","pi":406},{"type":"TextRun","bbox":{"x":207.1,"y":228.5,"w":407.0,"h":14.7},"text":"차 사고로 이어지는 사고범위의 확대를 최소화하는 데 있다.","pi":406}]},{"type":"TextLine","bbox":{"x":96.5,"y":257.2,"w":614.1,"h":14.7},"pi":407,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":257.2,"w":7.0,"h":14.7},"text":"2","pi":407},{"type":"TextRun","bbox":{"x":103.5,"y":257.2,"w":607.0,"h