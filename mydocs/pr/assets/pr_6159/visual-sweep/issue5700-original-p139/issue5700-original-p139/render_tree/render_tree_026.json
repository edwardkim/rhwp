{"type":"Page","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5},"children":[{"type":"PageBg","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5}},{"type":"MasterPage","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5},"children":[{"type":"Table","bbox":{"x":0.0,"y":54.3,"w":642.0,"h":26.5},"rows":1,"cols":2,"pi":0,"ci":0,"children":[{"type":"Cell","bbox":{"x":0.0,"y":54.3,"w":615.5,"h":26.5},"row":0,"col":0,"children":[{"type":"TextLine","bbox":{"x":1.9,"y":60.1,"w":611.7,"h":14.7},"pi":0,"children":[{"type":"TextRun","bbox":{"x":347.6,"y":60.1,"w":22.0,"h":14.7},"text":"제 ","pi":0},{"type":"TextRun","bbox":{"x":369.6,"y":60.1,"w":17.0,"h":14.7},"text":"3 ","pi":0},{"type":"TextRun","bbox":{"x":386.6,"y":60.1,"w":227.0,"h":14.7},"text":"장 최적의 수색구조장비 확보방안","pi":0}]}]},{"type":"Cell","bbox":{"x":615.5,"y":54.3,"w":26.5,"h":26.5},"row":0,"col":1,"children":[{"type":"TextLine","bbox":{"x":624.0,"y":59.5,"w":16.1,"h":16.0},"pi":0,"children":[{"type":"TextRun","bbox":{"x":624.0,"y":59.5,"w":16.1,"h":16.0},"text":"","pi":0}]}]},{"type":"Line","bbox":{"x":0.0,"y":80.7,"w":615.5,"h":0.8}}]}]},{"type":"Header","bbox":{"x":83.1,"y":56.7,"w":627.4,"h":56.7}},{"type":"Body","bbox":{"x":83.1,"y":113.4,"w":627.4,"h":895.7},"children":[{"type":"Column","bbox":{"x":83.1,"y":113.4,"w":627.4,"h":895.7},"col":0,"children":[{"type":"TextLine","bbox":{"x":83.1,"y":140.1,"w":627.4,"h":18.7},"pi":234,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":140.1,"w":35.0,"h":18.7},"text":"3.2 ","pi":234},{"type":"TextRun","bbox":{"x":118.1,"y":140.1,"w":364.0,"h":18.7},"text":"현 운용장비의 구조등 운용상 문제점 분석","pi":234}]},{"type":"TextLine","bbox":{"x":83.1,"y":193.7,"w":627.4,"h":16.0},"pi":235,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":193.7,"w":43.0,"h":16.0},"text":"3.2.1 ","pi":235},{"type":"TextRun","bbox":{"x":126.1,"y":193.7,"w":296.0,"h":16.0},"text":"해양경찰의 연안구조장비 운용상 문제점","pi":235}]},{"type":"TextLine","bbox":{"x":93.8,"y":238.5,"w":616.7,"h":14.7},"pi":236,"children":[{"type":"TextRun","bbox":{"x":93.8,"y":238.5,"w":84.0,"h":14.7},"text":"가. 운용환경","pi":236}]},{"type":"TextLine","bbox":{"x":96.5,"y":271.5,"w":614.1,"h":14.7},"pi":237,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":271.5,"w":620.4,"h":14.7},"text":"현재 국내 해상 조건은 근해에 다량 분포되어 있는 양식장으로 인해 로프, 폐그물, 부유 ","pi":237}]},{"type":"TextLine","bbox":{"x":83.1,"y":293.5,"w":627.4,"h":14.7},"pi":237,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":293.5,"w":635.0,"h":14.7},"text":"쓰레기 등 선박 운항에 장애요소가 많고 이 지역내에서 일어나는 해난 사고에 대하여 대처 ","pi":237}]},{"type":"TextLine","bbox":{"x":83.1,"y":315.6,"w":627.4,"h":14.7},"pi":237,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":315.6,"w":634.7,"h":14.7},"text":"방법이 어렵다. 그리고 특히 서해는 조수간만에 따른 급격한 수심 변화와 해도에 표시되지 ","pi":237}]},{"type":"TextLine","bbox":{"x":83.1,"y":337.6,"w":627.4,"h":14.7},"pi":237,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":337.6,"w":628.0,"h":14.7},"text":"않는 암초등도 운항 요건의 걸림돌이 되며, 연안구조정을 위한 전용 접안시설도 열악한 형편","pi":237}]},{"type":"TextLine","bbox":{"x":83.1,"y":359.6,"w":627.4,"h":14.7},"pi":237,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":359.6,"w":33.0,"h":14.7},"text":"이다.","pi":237}]},{"type":"TextLine","bbox":{"x":93.8,"y":397.7,"w":616.7,"h":14.7},"pi":238,"children":[{"type":"TextRun","bbox":{"x":93.8,"y":397.7,"w":84.0,"h":14.7},"text":"나. 유지보수","pi":238}]},{"type":"TextLine","bbox":{"x":96.5,"y":430.7,"w":614.1,"h":14.7},"pi":239,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":430.7,"w":614.0,"h":14.7},"text":"연안구조정의 경우 소형선박에 해당되어 국내 조선산업이 활성화되지 못한 관계로 주기관","pi":239}]},{"type":"TextLine","bbox":{"x":83.1,"y":452.7,"w":627.4,"h":14.7},"pi":239,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":452.7,"w":627.0,"h":14.7},"text":"과 추진계통은 대부분 수입 제품에 의존 할 수 밖에 없어 장비고장시 해외정비기술자에 의","pi":239}]},{"type":"TextLine","bbox":{"x":83.1,"y":474.8,"w":627.4,"h":14.7},"pi":239,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":474.8,"w":634.4,"h":14.7},"text":"뢰해야 한다. 따라서 신속한 고장정비를 위해 연안구조정 공급자에게 사후관리측면에 대한 ","pi":239}]},{"type":"TextLine","bbox":{"x":83.1,"y":496.8,"w":627.4,"h":14.7},"pi":239,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":496.8,"w":616.0,"h":14.7},"text":"조건부 계약이 필요하며, 정비기술 이전도 가능한 업체와 제품선정이 무엇보다도 중요하다.","pi":239}]},{"type":"TextLine","bbox":{"x":96.5,"y":525.5,"w":614.1,"h":14.7},"pi":240,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":525.5,"w":620.8,"h":14.7},"text":"부득이 해외 생산된 연안구조정을 도입할 경우 수입 공급업체의 신뢰도가 높고 정비기술 ","pi":240}]},{"type":"TextLine","bbox":{"x":83.1,"y":547.5,"w":627.4,"h":14.7},"pi":240,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":547.5,"w":628.0,"h":14.7},"text":"서비스 조직체계가 마련된 제품 선정이 중요하며, 향후 유지관리를 위한 비용부분에 대한 고","pi":240}]},{"type":"TextLine","bbox":{"x":83.1,"y":569.5,"w":627.4,"h":14.7},"pi":240,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":569.5,"w":99.0,"h":14.7},"text":"려도 필요하다.","pi":240}]},{"type":"TextLine","bbox":{"x":93.8,"y":607.6,"w":616.7,"h":14.7},"pi":241,"children":[{"type":"TextRun","bbox":{"x":93.8,"y":607.6,"w":69.0,"h":14.7},"text":"다. 안전성","pi":241}]},{"type":"TextLine","bbox":{"x":96.5,"y":640.6,"w":614.1,"h":14.7},"pi":242,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":640.6,"w":252.0,"h":14.7},"text":"현재 운용되는 연안구조정은 대부분 ","pi":242},{"type":"TextRun","bbox":{"x":348.5,"y":640.6,"w":28.0,"h":14.7},"text":"6m ","pi":242},{"type":"TextRun","bbox":{"x":376.5,"y":640.6,"w":334.0,"h":14.7},"text":"이하의 선체크기로 관리와 운용의 용이성은 있으","pi":242}]},{"type":"TextLine","bbox":{"x":83.1,"y":662.7,"w":627.4,"h":14.7},"pi":242,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":662.7,"w":627.0,"h":14.7},"text":"나 해상기상의 악천후시나 파고가 높을 경우 운용이 어려워 무리한 운용을 할 경우 승조원","pi":242}]},{"type":"TextLine","bbox":{"x":83.1,"y":684.7,"w":627.4,"h":14.7},"pi":242,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":684.7,"w":253.0,"h":14.7},"text":"의 안전도 보장 받기 어렵다. 따라서 ","pi":242},{"type":"TextRun","bbox":{"x":336.1,"y":684.7,"w":28.0,"h":14.7},"text":"9m ","pi":242},{"type":"TextRun","bbox":{"x":364.1,"y":684.7,"w":319.0,"h":14.7},"text":"정도의 선체크기가 바람직 할 것으로 사료된다.","pi":242}]},{"type":"TextLine","bbox":{"x":93.8,"y":722.7,"w":616.7,"h":14.7},"pi":243,"children":[{"type":"TextRun","bbox":{"x":93.8,"y":722.7,"w":84.0,"h":14.7},"text":"라. 운행환경","pi":243}]},{"type":"TextLine","bbox":{"x":96.5,"y":755.8,"w":614.1,"h":14.7},"pi":244,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":755.8,"w":620.8,"h":14.7},"text":"현재 구조정은 대부분 선실이 개방된 형태로 사계절 운용이 사실상 어려우며 승조원들은 ","pi":244}]},{"type":"TextLine","bbox":{"x":83.1,"y":777.8,"w":627.4,"h":14.7},"pi":244,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":777.8,"w":627.0,"h":14.7},"text":"운행시 스트레스를 받게 되어 본연의 임무수행에 집중하기가 어렵다. 우천, 동계, 하계 등 기","pi":244}]},{"type":"TextLine","bbox":{"x":83.1,"y":799.8,"w":627.4,"h":14.7},"pi":244,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":799.8,"w":627.0,"h":14.7},"text":"후 변화에 별 영향을 받지 않도록 밀폐된 선실 구조가 필요하며, 내부 환경도 보다 더 신경","pi":244}]},{"type":"TextLine","bbox":{"x":83.1,"y":821.9,"w":627.4,"h":14.7},"pi":244,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":821.9,"w":92.0,"h":14.7},"text":"을 써야 한다.","pi":244}]},{"type":"TextLine","bbox":{"x":93.8,"y":859.9,"w":616.7,"h":14.7},"pi":245,"children":[{"type":"TextRun","bbox":{"x":93.8,"y":859.9,"w":106.0,"h":14.7},"text":"마. 외관 디자인","pi":245}]},{"type":"TextLine","bbox":{"x":96.5,"y":893.0,"w":614.1,"h":14.7},"pi":246,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":893.0,"w":614.0,"h":14.7},"text":"현재 운용되는 구조정들은 외관 형태가 미려하지 못하고 통일화 되지 못하여 해경의 위용","pi":246}]},{"type":"TextLine","bbox":{"x":83.1,"y":915.0,"w":627.4,"h":14.7},"pi":246,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":915.0,"w":627.0,"h":14.7},"text":"을 알리고 최우수 장비라는 형상화에 크게 도움이 되지 못한다. 제품의 성능 못지않게 우수","pi":246}]},{"type":"TextLine","bbox":{"x":83.1,"y":937.0,"w":627.4,"h":14.7},"pi":246,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":937.0,"w":268.0,"h":14.7},"text":"한 디자인 선정도 신경써야할 부분이다.","pi":246}]},{"type":"TextLine","bbox":{"x":96.5,"y":965.7,"w":614.1,"h":14.7},"pi":247,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":965.7,"w":614.1,"h":14.7},"text":"","pi":247}]}]}]},{"type":"Footer","bbox":{"x":83.1,"y":1009.1,"w":627.4,"h":56.7},"children":[{"type":"TextLine","bbox":{"x":369.9,"y":1028.6,"w":54.0,"h":16.0},"pi":0,"children":[{"type":"TextRun","bbox":{"x":369.9,"y":1041.9,"w":54.0,"h":13.3},"text":"- 240 -","pi":0}]}]}]}