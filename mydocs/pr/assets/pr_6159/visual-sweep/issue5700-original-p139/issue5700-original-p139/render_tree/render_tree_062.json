{"type":"Page","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5},"children":[{"type":"PageBg","bbox":{"x":0.0,"y":0.0,"w":793.7,"h":1122.5}},{"type":"Header","bbox":{"x":83.1,"y":56.7,"w":627.4,"h":56.7}},{"type":"Body","bbox":{"x":83.1,"y":113.4,"w":627.4,"h":895.7},"children":[{"type":"Column","bbox":{"x":83.1,"y":113.4,"w":627.4,"h":895.7},"col":0,"children":[{"type":"TextLine","bbox":{"x":83.1,"y":140.1,"w":627.4,"h":18.7},"pi":34,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":140.1,"w":35.0,"h":18.7},"text":"3.5 ","pi":34},{"type":"TextRun","bbox":{"x":118.1,"y":140.1,"w":317.0,"h":18.7},"text":"신규 도입 연안구조정 기종선정 평가","pi":34}]},{"type":"TextLine","bbox":{"x":83.1,"y":193.7,"w":627.4,"h":16.0},"pi":35,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":193.7,"w":43.0,"h":16.0},"text":"3.5.1 ","pi":35},{"type":"TextRun","bbox":{"x":126.1,"y":193.7,"w":64.0,"h":16.0},"text":"기본방향","pi":35}]},{"type":"TextLine","bbox":{"x":96.5,"y":229.1,"w":614.1,"h":14.7},"pi":36,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":229.1,"w":29.0,"h":14.7},"text":"2007","pi":36},{"type":"TextRun","bbox":{"x":125.5,"y":229.1,"w":265.0,"h":14.7},"text":"년 해양경찰청은 ｢함께가는 희망한국 ","pi":36},{"type":"TextRun","bbox":{"x":390.5,"y":229.1,"w":91.0,"h":14.7},"text":"VISION 2030","pi":36},{"type":"TextRun","bbox":{"x":481.5,"y":229.1,"w":235.9,"h":14.7},"text":"｣ 이라는 ｢혁신적이고 활력 있는 ","pi":36}]},{"type":"TextLine","bbox":{"x":83.1,"y":251.1,"w":627.4,"h":14.7},"pi":36,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":251.1,"w":628.0,"h":14.7},"text":"경제, 안전하고 기회가 보장되는 사회, 안정되고 품격 있는 국가 건설｣ 지원을 위한 해양경","pi":36}]},{"type":"TextLine","bbox":{"x":83.1,"y":273.2,"w":627.4,"h":14.7},"pi":36,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":273.2,"w":628.0,"h":14.7},"text":"찰 중‧장기 비전 제시를 통해 안전하고 깨끗한 희망의 바다 실현을 위한 다양한 정책수립으","pi":36}]},{"type":"TextLine","bbox":{"x":83.1,"y":295.2,"w":627.4,"h":14.7},"pi":36,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":295.2,"w":22.0,"h":14.7},"text":"로 ","pi":36},{"type":"TextRun","bbox":{"x":105.1,"y":295.2,"w":15.0,"h":14.7},"text":"21","pi":36},{"type":"TextRun","bbox":{"x":120.1,"y":295.2,"w":569.0,"h":14.7},"text":"세기 해양주권 수호세력으로서의 역할을 다하기 위해 최선의 노력을 기울이고 있다.","pi":36}]},{"type":"TextLine","bbox":{"x":96.5,"y":323.9,"w":614.1,"h":14.7},"pi":37,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":323.9,"w":614.0,"h":14.7},"text":"또한 삶의 질 향상에 따른 해양레저‧해양관광 등 해양 치안 수요 변화에 대응하여 해양사","pi":37}]},{"type":"TextLine","bbox":{"x":83.1,"y":345.9,"w":627.4,"h":14.7},"pi":37,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":345.9,"w":633.7,"h":14.7},"text":"고 예방과 인명피해 최소화를 위한 수색구조체계 정착 등 안전한 바다만들기에 역점을 두고 ","pi":37}]},{"type":"TextLine","bbox":{"x":83.1,"y":367.9,"w":627.4,"h":14.7},"pi":37,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":367.9,"w":180.0,"h":14.7},"text":"업무를 수행해 오고 있다. ","pi":37},{"type":"TextRun","bbox":{"x":263.1,"y":367.9,"w":447.0,"h":14.7},"text":"그러나 정책수립만으로 다변화되어가는 해양사고 대응에는 한계가 있","pi":37}]},{"type":"TextLine","bbox":{"x":83.1,"y":390.0,"w":627.4,"h":14.7},"pi":37,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":390.0,"w":628.0,"h":14.7},"text":"으며, 열악한 근무환경, 기후변화에 따른 해양사고 발생요소의 변화, 일부 기동성이 떨어지는 노","pi":37}]},{"type":"TextLine","bbox":{"x":83.1,"y":412.0,"w":627.4,"h":14.7},"pi":37,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":412.0,"w":627.0,"h":14.7},"text":"후화된 구조정 과 과학화된 첨단 수색구조 장비체계가 없는 현실에서는 안전한 바다만들기는 요","pi":37}]},{"type":"TextLine","bbox":{"x":83.1,"y":434.0,"w":627.4,"h":14.7},"pi":37,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":434.0,"w":150.0,"h":14.7},"text":"원한 것일 수밖에 없다.","pi":37}]},{"type":"TextLine","bbox":{"x":96.5,"y":462.7,"w":614.1,"h":14.7},"pi":38,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":462.7,"w":614.0,"h":14.7},"text":"또한 과거 수동적인 해양안전관리에서 바다안전을 적극적으로 만들어가는 고객중심의 해","pi":38}]},{"type":"TextLine","bbox":{"x":83.1,"y":484.7,"w":627.4,"h":14.7},"pi":38,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":484.7,"w":517.0,"h":14.7},"text":"양안전망 구축을 위해서는 수색구조 체계의 현대화가 수반되어야 할 것이다.","pi":38}]},{"type":"TextLine","bbox":{"x":96.5,"y":513.4,"w":614.1,"h":14.7},"pi":39,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":513.4,"w":621.2,"h":14.7},"text":"따라서 연안구조정 도입을 위한 업무가 원활하고 객관적이며, 예산절감의 효과도 가져올 ","pi":39}]},{"type":"TextLine","bbox":{"x":83.1,"y":535.5,"w":627.4,"h":14.7},"pi":39,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":535.5,"w":627.0,"h":14.7},"text":"수 있도록 조달구매 방식에 대한 검토를 통해서 효율적이고 체계적인 연안구조정 구매업무","pi":39}]},{"type":"TextLine","bbox":{"x":83.1,"y":557.5,"w":627.4,"h":14.7},"pi":39,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":557.5,"w":158.0,"h":14.7},"text":"가 되도록 하고자 한다.","pi":39}]},{"type":"TextLine","bbox":{"x":96.5,"y":586.2,"w":614.1,"h":14.7},"pi":40,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":586.2,"w":473.0,"h":14.7},"text":"우선 연안구조정 도입을 위해서는 다음과 같은 사항을 고려해야 한다.","pi":40}]},{"type":"TextLine","bbox":{"x":96.5,"y":614.9,"w":614.1,"h":14.7},"pi":41,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":614.9,"w":385.0,"h":14.7},"text":"첫째 해양경찰의 관할해역 특성을 고려한 것이어야 한다.","pi":41}]},{"type":"TextLine","bbox":{"x":96.5,"y":643.6,"w":614.1,"h":14.7},"pi":42,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":643.6,"w":620.5,"h":14.7},"text":"삼면이 바다로 둘러싸인 우리나라는 해역별 해안지형구조 뿐만아니라 기상적인 요소까지 ","pi":42}]},{"type":"TextLine","bbox":{"x":83.1,"y":665.6,"w":627.4,"h":14.7},"pi":42,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":665.6,"w":627.0,"h":14.7},"text":"각기 다른 특성을 가지고 있기 때문에 이를 고려한 구매기준은 무엇보다도 필요하다고 본다.","pi":42}]},{"type":"TextLine","bbox":{"x":96.5,"y":694.3,"w":614.1,"h":14.7},"pi":43,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":694.3,"w":185.0,"h":14.7},"text":"이를테면 동해안의 파고가 ","pi":43},{"type":"TextRun","bbox":{"x":281.5,"y":694.3,"w":20.0,"h":14.7},"text":"3m","pi":43},{"type":"TextRun","bbox":{"x":301.5,"y":694.3,"w":237.0,"h":14.7},"text":"인데 도입된 구조정의 능파능력이 ","pi":43},{"type":"TextRun","bbox":{"x":538.5,"y":694.3,"w":20.0,"h":14.7},"text":"2m","pi":43},{"type":"TextRun","bbox":{"x":558.5,"y":694.3,"w":152.0,"h":14.7},"text":"라고 한다면, 비상출동","pi":43}]},{"type":"TextLine","bbox":{"x":83.1,"y":716.3,"w":627.4,"h":14.7},"pi":43,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":716.3,"w":481.0,"h":14.7},"text":"시 인명구조는커녕 수색구조임무자의 안전도 보장할 수 없기 때문이다.","pi":43}]},{"type":"TextLine","bbox":{"x":96.5,"y":745.0,"w":614.1,"h":14.7},"pi":44,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":745.0,"w":429.0,"h":14.7},"text":"둘째 수색구조업무에 적합한 선체구조와 시설을 갖추어야 한다.","pi":44}]},{"type":"TextLine","bbox":{"x":96.5,"y":773.7,"w":614.1,"h":14.7},"pi":45,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":773.7,"w":621.8,"h":14.7},"text":"외형이 화려하고 내부시설이 첨단구조로 되어 있다고 하여도 해상에서 인명을 구조하는 ","pi":45}]},{"type":"TextLine","bbox":{"x":83.1,"y":795.7,"w":627.4,"h":14.7},"pi":45,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":795.7,"w":628.0,"h":14.7},"text":"임무 특성상 적합한 구조가 아니면 임무수행에 지장을 초래하기 때문이다. 즉 편안하고 첨단","pi":45}]},{"type":"TextLine","bbox":{"x":83.1,"y":817.8,"w":627.4,"h":14.7},"pi":45,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":817.8,"w":634.9,"h":14.7},"text":"소재의 내부시설이라 하더라도 구조된 자의 응급구호 또는 응급환자를 누울 공간도 확보가 ","pi":45}]},{"type":"TextLine","bbox":{"x":83.1,"y":839.8,"w":627.4,"h":14.7},"pi":45,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":839.8,"w":89.0,"h":14.7},"text":"안되는 경우 ","pi":45},{"type":"TextRun","bbox":{"x":172.1,"y":839.8,"w":7.0,"h":14.7},"text":"2","pi":45},{"type":"TextRun","bbox":{"x":179.1,"y":839.8,"w":532.0,"h":14.7},"text":"차 응급사태로 까지 발생될 수 있기 때문에 다양한 상황에 대처할 수 있는 구","pi":45}]},{"type":"TextLine","bbox":{"x":83.1,"y":861.8,"w":627.4,"h":14.7},"pi":45,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":861.8,"w":85.0,"h":14.7},"text":"조여야 한다.","pi":45}]},{"type":"TextLine","bbox":{"x":96.5,"y":890.5,"w":614.1,"h":14.7},"pi":46,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":890.5,"w":444.0,"h":14.7},"text":"셋째 사계절 운행이 가능하고 악천후에도 출동할 수 있어야 한다.","pi":46}]},{"type":"TextLine","bbox":{"x":96.5,"y":919.2,"w":614.1,"h":14.7},"pi":47,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":919.2,"w":620.2,"h":14.7},"text":"육상과 달리 해상은 기상변화에 민감할 수 밖에 없다. 왜냐하면 육상에서는 비가온다거나 ","pi":47}]},{"type":"TextLine","bbox":{"x":83.1,"y":941.2,"w":627.4,"h":14.7},"pi":47,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":941.2,"w":634.9,"h":14.7},"text":"강풍이 불면 잠시 수색구조 업무를 멈추거나 피해있거나 하면 되지만 육상처럼 해상에서는 ","pi":47}]},{"type":"TextLine","bbox":{"x":83.1,"y":963.3,"w":627.4,"h":14.7},"pi":47,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":963.3,"w":514.0,"h":14.7},"text":"의지할 건물도 없으며, 비와 바람에 의해 바닷물의 조류도 변하기 때문이다.","pi":47}]},{"type":"TextLine","bbox":{"x":96.5,"y":991.9,"w":614.1,"h":14.7},"pi":48,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":991.9,"w":614.1,"h":14.7},"text":"","pi":48}]}]}]},{"type":"Footer","bbox":{"x":83.1,"y":1009.1,"w":627.4,"h":56.7},"children":[{"type":"TextLine","bbox":{"x":369.9,"y":1028.6,"w":54.0,"h":16.0},"pi":0,"children":[{"type":"TextRun","bbox":{"x":369.9,"y":1041.9,"w":54.0,"h":13.3},"text":"- 276 -","pi":0}]}]}]}