4.5,"y":357.7,"w":14.0,"h":14.7},"text":"B\"","pi":341},{"type":"TextRun","bbox":{"x":658.5,"y":357.7,"w":52.0,"h":14.7},"text":"의 역회","pi":341}]},{"type":"TextLine","bbox":{"x":83.1,"y":379.7,"w":627.4,"h":14.7},"pi":341,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":379.7,"w":634.3,"h":14.7},"text":"전이 가능하며 펌프의 유형은 선체의 전체에 크기에 비례한 기관실의 공간에 따라 펌프의 ","pi":341}]},{"type":"TextLine","bbox":{"x":83.1,"y":401.8,"w":627.4,"h":14.7},"pi":341,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":401.8,"w":202.0,"h":14.7},"text":"크기도 변화함을 알 수 있다. ","pi":341}]},{"type":"TextLine","bbox":{"x":96.5,"y":430.5,"w":614.1,"h":14.7},"pi":342,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":430.5,"w":614.0,"h":14.7},"text":"부유물질 제거와의 상관관계를 살펴보면 우선 충분한 기관실 공간을 가질 경우에는 변속","pi":342}]},{"type":"TextLine","bbox":{"x":83.1,"y":452.5,"w":627.4,"h":14.7},"pi":342,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":452.5,"w":634.5,"h":14.7},"text":"기를 장착한 펌프는 전․후․중립 등 변속을 관장하는 조종간과 가속을 담당하는 조종간이 ","pi":342}]},{"type":"TextLine","bbox":{"x":83.1,"y":474.5,"w":627.4,"h":14.7},"pi":342,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":474.5,"w":170.0,"h":14.7},"text":"별도로 존재하여 엔진이 ","pi":342},{"type":"TextRun","bbox":{"x":253.1,"y":474.5,"w":7.0,"h":14.7},"text":"1","pi":342},{"type":"TextRun","bbox":{"x":260.1,"y":474.5,"w":118.0,"h":14.7},"text":"개라도 조종간은 ","pi":342},{"type":"TextRun","bbox":{"x":378.1,"y":474.5,"w":7.0,"h":14.7},"text":"2","pi":342},{"type":"TextRun","bbox":{"x":385.1,"y":474.5,"w":325.0,"h":14.7},"text":"개가 되며 중립시 회전력을 제거하므로 물을 흡","pi":342}]},{"type":"TextLine","bbox":{"x":83.1,"y":496.5,"w":627.4,"h":14.7},"pi":342,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":496.5,"w":547.0,"h":14.7},"text":"입하는 흡입력이 전혀 발생하지 않아 중립상태에서는 이물질이 흡입되지 않는다.","pi":342}]},{"type":"TextLine","bbox":{"x":96.5,"y":525.2,"w":614.1,"h":14.7},"pi":343,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":525.2,"w":614.0,"h":14.7},"text":"그리고 후진으로 임펠러를 역회전 할수 있기에 흡입구에 고착된 부유물질을 외부로 배출","pi":343}]}