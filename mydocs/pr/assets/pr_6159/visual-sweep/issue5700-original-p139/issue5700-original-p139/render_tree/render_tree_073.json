":120.5,"y":258.9,"w":88.0,"h":14.7},"text":"일반경쟁입찰","pi":172}]},{"type":"TextLine","bbox":{"x":96.5,"y":287.6,"w":614.1,"h":14.7},"pi":173,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":287.6,"w":621.4,"h":14.7},"text":"입찰공고를 통해 입찰참가를 희망하는 모든 업체를 대상으로 최저가격 입찰자를 낙찰자로 ","pi":173}]},{"type":"TextLine","bbox":{"x":83.1,"y":309.6,"w":627.4,"h":14.7},"pi":173,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":309.6,"w":627.0,"h":14.7},"text":"선정하는 계약방식으로 일정한 자격을 갖춘 업체만이 참여가 가능한 제한부 일반경쟁 입찰","pi":173}]},{"type":"TextLine","bbox":{"x":83.1,"y":331.6,"w":627.4,"h":14.7},"pi":173,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":331.6,"w":129.0,"h":14.7},"text":"방식이라고도 한다.","pi":173}]},{"type":"TextLine","bbox":{"x":96.5,"y":360.3,"w":614.1,"h":14.7},"pi":174,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":360.3,"w":24.0,"h":14.7},"text":"(2) ","pi":174},{"type":"TextRun","bbox":{"x":120.5,"y":360.3,"w":88.0,"h":14.7},"text":"지명경쟁입찰","pi":174}]},{"type":"TextLine","bbox":{"x":96.5,"y":389.0,"w":614.1,"h":14.7},"pi":175,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":389.0,"w":621.4,"h":14.7},"text":"발주자가 미리 경쟁참가 희망자의 자격을 심사하여 유자격업자 명부를 작성하고 발주전에 ","pi":175}]},{"type":"TextLine","bbox":{"x":83.1,"y":411.0,"w":627.4,"h":14.7},"pi":175,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":411.0,"w":318.0,"h":14.7},"text":"발주사업에 만족하는 유자격업자 다수를 선정","pi":175},{"type":"TextRun","bbox":{"x":401.1,"y":411.0,"w":7.0,"h":14.7},"text":"ㆍ","pi":175},{"type":"TextRun","bbox":{"x":408.1,"y":411.0,"w":303.0,"h":14.7},"text":"지명하여 이들을 대상으로 경쟁입찰을 실시","pi":175}]},{"type":"TextLine","bbox":{"x":83.1,"y":433.1,"w":627.4,"h":14.7},"pi":175,"children":[{"type":"TextRun","bbox":{"x":83.1,"y":433.1,"w":367.0,"h":14.7},"text":"하며, 최저가격 입찰자를 낙찰자로 하는 계약방식이다.","pi":175}]},{"type":"TextLine","bbox":{"x":96.5,"y":461.8,"w":614.1,"h":14.7},"pi":176,"children":[{"type":"TextRun","bbox":{"x":96.5,"y":461.8,"w":614.0,"h":14.7},"text":"지명경쟁입찰에서도 발주공고 시 기술제안서를 요구하여 제출한 업체 중에서 지명하고 지","pi":176}]},{"type"