(version 1)
(allow default)
(deny file-read* (subpath "/Library/Fonts") (subpath "/Users/tsjang/Library/Fonts") (subpath "/Users/tsjang/rhwp/ttfs") (subpath "/Users/tsjang/rhwp/output/pr-review/native-webfont-cache"))
(allow file-read* (subpath "/Users/tsjang/rhwp/ttfs/opensource"))
(deny mach-lookup (global-name "com.apple.fonts") (global-name "com.apple.fonts.atsbridge"))
(allow file-read* (subpath "/Users/tsjang/rhwp/ttfs/redistributable"))
