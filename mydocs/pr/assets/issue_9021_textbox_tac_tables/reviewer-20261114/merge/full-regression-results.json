[
  {
    "name": "full-nextest",
    "command": [
      "cargo",
      "nextest",
      "run",
      "--locked",
      "--cargo-profile",
      "release-test",
      "--tests",
      "--test-threads",
      "6",
      "--no-fail-fast"
    ],
    "exit": 0
  },
  {
