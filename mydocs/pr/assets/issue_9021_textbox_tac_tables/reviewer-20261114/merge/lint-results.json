[
  {
    "name": "fmt",
    "command": [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ],
    "exit": 0
  },
  {
    "name": "native-clippy",
    "command": [
      "cargo",
      "clippy",
      "--locked",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "name": "wasm-clippy",
    "command": [
      "cargo",
      "clippy",
      "--locked",
      "-p",
      "rhwp",
      "--lib",
      "--target",
      "wasm32-unknown-unknown",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "name": "workspace-build",
    "command": [
      "cargo",
      "build",
      "--locked",
      "--workspace"
    ],
    "exit": 0
  },
  {
    "name": "workspace-clippy",
    "command": [
      "cargo",
      "clippy",
      "--locked",
      "--workspace",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit": 0
  },
  {
    "name": "suite-check",
    "command": [
      "node",
      "scripts/rust-test-suite-manifest.mjs",
      "--check",
      "--base-ref",
      "88170fd75f9d0ce156fe49d79aeabea9bb3a4bcc"
    ],
    "exit": 0
  }
]
