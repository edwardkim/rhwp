+/// 쪽 끝 문단이 본문 하단 밖으로 흘려도 되는 폭 [#3798].
+///
+/// 쪽 마지막 문단의 적합 판정은 말미 줄간격을 뺀 높이(`height_for_fit`)로 한다
+/// [Task #359]. 한글도 쪽 하단을 조금 넘겨 채우므로 방향은 맞지만, 트림에 한도가
+/// 없어 rhwp 는 말미 줄간격 **전량**(실측 최대 33.7px)을 흘려보낸다. 그래서
+/// 한글이 다음 쪽으로 넘긴 문단을 현재 쪽에 얹는다.
+///
+/// 한도는 92셋 통제셋이 허용하는 가장 조인 값이다 — 5.0 에서 통제셋 1건이 깨지고
+/// 5.5 이상은 92/92 로 평탄하다. 이득은 한도가 작을수록 매끄럽게 커진다
+/// (PI 해소 12/13/7 @ 8/6/12px). #2137 의 TAC 개체 40px 스필 한도와 같은 관용구다.
+const PAGE_END_SPILL_LIMIT_PX: f64 = 6.0;
+
+/// 쪽 끝 문단의 적합 판정 높이.
+///
+/// 한도는 **한 줄 문단에만** 건다. 한 줄 문단은 선택이 이분법(이 쪽이냐 다음 쪽이냐)
+/// 이라 스필 폭이 곧 답이다. 여러 줄 문단에서 적합 높이는 **어디서 쪼갤지**를 정하는
+/// 다른 질문이고, 거기에 한도를 걸면 통째로 넘어갈 문단을 줄 단위로 쪼개 쪽을 늘린다
+/// (`2022년 국립국어원 업무계획.hwp` pi=39: 두 줄 63.7px 이 4·5쪽으로 갈려 35→36쪽).
 fn paragraph_page_end_fit_height(
     total_height: f64,
     height_for_fit: f64,
     require_full_advance: bool,
+    single_line: bool,
+    text_only: bool,
 ) -> f64 {
     if require_full_advance {
-        total_height.max(height_for_fit)
-    } else {
-        height_for_fit
+        return total_height.max(height_for_fit);
     }
+    if !single_line {
+        return height_for_fit;
+    }
+    // 글월만 있는 문단에만 건다. 빈 문단은 넘치는 것이 잉크가 아니라 간격뿐이고,
+    // 개체를 담은 문단의 말미 간격은 개체 높이가 부풀린 값이라 스필 폭으로 읽으면 안
+    // 된다(148719004: 빈 문단 pi=173 과 그림 문단 pi=348/713/714 의 말미 간격이
+    // 52~88px — 한도를 걸면 넷 다 밀려 54->55쪽).
+    if !text_only {
+        return height_for_fit;
+    }
+    let limit = std::env::var("RHWP_EXP_TRIMCAP")
+        .ok()
+        .and_then(|v| v.parse::<f64>().ok())
+        .unwrap_or(PAGE_END_SPILL_LIMIT_PX);
+    total_height.min(height_for_fit.max(total_height - limit))
 }
 
