<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RhwpStudioDist Condition="'$(RhwpStudioDist)' == ''">$(MSBuildThisFileDirectory)../../rhwp-studio/dist-desktop</RhwpStudioDist>
    <RhwpStudioDistPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(RhwpStudioDist)'))</RhwpStudioDistPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <Compile Include="../../bindings/csharp/RhwpNative.cs" Link="RhwpNative.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(RhwpNativeDll)' != ''">
    <Content Include="$(RhwpNativeDll)" Link="rhwp_native_ffi.dll"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(RhwpStudioDistPath)/studio/index.html')">
    <Content Include="$(RhwpStudioDistPath)/**/*"
             Link="Studio/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Target Name="RequireRhwpStudioForPublish" BeforeTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(RhwpStudioDistPath)/bundle.json') Or !Exists('$(RhwpStudioDistPath)/studio/index.html')"
           Text="Build the offline Studio bundle first. See apps/WinUI/README.md or pass -p:RhwpStudioDist=&lt;bundle directory&gt;." />
  </Target>
  <Target Name="RequireRhwpStudioForBuild" BeforeTargets="PrepareForBuild"
          Condition="'$(RequireRhwpStudio)' == 'true'">
    <CallTarget Targets="RequireRhwpStudioForPublish" />
  </Target>
</Project>
