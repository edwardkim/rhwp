{
  "id": "SR35",
  "tier": 2,
  "title": "HWPX 표본 PDF 백엔드",
  "input": "samples/hwpx_sample2.hwpx",
  "instructions": "HWPX 표본을 PDF 로 내보내 out.pdf 를 제출하고, 사용한 백엔드를 answer.json 에 {\"backend\": \"...\"} 로 적어라. 기본은 svg 경로이며, 박제하지 말고 봉투를 읽어라. 힌트: rhwp export-pdf --json 의 backend.",
  "submit": {
    "kind": "artifact",
    "files": [
      "out.pdf",
      "answer.json"
    ]
  },
  "checks": [
    {
      "name": "PDF 산출",
      "op": "file_exists",
      "file": "out.pdf",
      "minBytes": 256
    },
    {
      "name": "원본과 다름 (무편집 복사 거부 — 판별력)",
      "op": "differs_from_input",
      "file": "out.pdf"
    },
    {
      "name": "PDF 형식",
      "op": "value_eq",
      "value": "pdf",
      "path": "format",
      "cmd": [
        "export-pdf",
        "{input}",
        "-o",
        "{file:out.pdf}",
        "--json"
      ]
    },
    {
      "name": "PDF 백엔드",
      "op": "answer_eq",
      "answer": "backend",
      "path": "backend",
      "cmd": [
        "export-pdf",
        "{input}",
        "-o",
        "{file:out.pdf}",
        "--json"
      ]
    }
  ]
}
