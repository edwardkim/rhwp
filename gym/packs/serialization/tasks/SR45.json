{
  "id": "SR45",
  "tier": 3,
  "title": "표 문서 DocLang 손실 계수",
  "input": "samples/table-001.hwp",
  "instructions": "표 문서를 DocLang 으로 내보내고 손실 건수를 answer.json 에 {\"loss\": N} 으로 제출하라. 힌트: rhwp export-doclang --json 의 lossCount. 손실이 0이 아닐 수 있다 — 변환 성공과 무손실은 다른 축이다.",
  "submit": {
    "kind": "answer",
    "files": [
      "answer.json"
    ]
  },
  "checks": [
    {
      "name": "손실 건수",
      "op": "answer_eq",
      "answer": "loss",
      "path": "lossCount",
      "cmd": [
        "export-doclang",
        "{input}",
        "-o",
        "{file:out.doclang}",
        "--json"
      ]
    }
  ],
  "axis": "변환"
}
