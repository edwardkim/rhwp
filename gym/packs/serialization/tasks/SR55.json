{
  "id": "SR55",
  "tier": 2,
  "title": "HWPX 원본 info 형식과 쪽수",
  "input": "samples/hwpx_sample2.hwpx",
  "instructions": "HWPX 원본의 쪽수를 answer.json 에 {\"pages\": N} 으로 제출하라. rhwp 는 HWP 와 HWPX 를 같은 IR 로 읽는다. 힌트: rhwp info --json 의 pageCount.",
  "submit": {
    "kind": "answer",
    "files": [
      "answer.json"
    ]
  },
  "checks": [
    {
      "name": "쪽수",
      "op": "answer_eq",
      "answer": "pages",
      "path": "pageCount",
      "cmd": [
        "info",
        "{input}",
        "--json"
      ]
    },
    {
      "name": "형식 표기",
      "op": "value_eq",
      "value": "hwpx",
      "path": "format",
      "cmd": [
        "info",
        "{input}",
        "--json"
      ]
    }
  ],
  "axis": "조사"
}
