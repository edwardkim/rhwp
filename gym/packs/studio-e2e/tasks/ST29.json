{
  "id": "ST29",
  "tier": 2,
  "title": "묶은가로막대 HWP CSV 추출",
  "input": "samples/chart/가로막대형/묶은가로막대형.hwp",
  "instructions": "차트 1 의 숫자 시트를 chart.csv 로 제출하라. 가로막대도 데이터 시트 모양은 같다. 축 방향과 CSV 방향을 혼동하지 마라. 원본 HWP/HWPX 를 복사하거나 머리 행만 있는 빈 표를 내지 마라. 힌트: rhwp chart-to-csv --chart 1 -o chart.csv.",
  "submit": {
    "kind": "artifact",
    "files": [
      "chart.csv"
    ]
  },
  "checks": [
    {
      "name": "CSV 산출 존재",
      "op": "file_exists",
      "file": "chart.csv",
      "minBytes": 8
    },
    {
      "name": "라이브 CSV 전체 일치",
      "op": "text_file_envelope_eq",
      "file": "chart.csv",
      "path": "charts[0].csv",
      "cmd": [
        "chart-to-csv",
        "{input}",
        "--json"
      ]
    }
  ],
  "axis": "추출"
}
