{
  "id": "ST07",
  "tier": 3,
  "title": "둘째 계열 첫 값 편집 (묶은세로막대 HWPX)",
  "input": "samples/chart/세로막대형/묶은세로막대형.hwpx",
  "instructions": "차트 1의 (계열 1, 값 0) 원본 2.4 을 '88.1' 로 바꿔 out.hwpx 로 저장하라. 원본 크기(계열 수·값 개수·계열명·카테고리 라벨)는 그대로 두어야 한다. HWPX 쌍에 ST02 와 같은 칸을 적용한다. zip 파트와 중첩 CFB 를 함께 쓰는 계약이다. 한 칸만 바꾸고 나머지 숫자는 원본 CSV 와 같아야 한다. 무편집 복사는 거절된다. 힌트: chart-to-csv 로 뽑아 그 칸만 고치고 csv-to-chart 로 되넣어라(-o out.hwpx).",
  "submit": {
    "kind": "artifact",
    "files": [
      "out.hwpx"
    ]
  },
  "checks": [
    {
      "name": "산출물 존재",
      "op": "file_exists",
      "file": "out.hwpx",
      "minBytes": 1
    },
    {
      "name": "원본과 다름 (무편집 복사 거부)",
      "op": "differs_from_input",
      "file": "out.hwpx"
    },
    {
      "name": "지목 칸이 이미 88.1 (센티넬 재적용이 무변경)",
      "op": "value_eq",
      "path": "changedCount",
      "value": 0,
      "cmd": [
        "csv-to-chart",
        "{file:out.hwpx}",
        "--csv",
        "gym/packs/studio-e2e/assets/ST07-edit.csv",
        "--chart",
        "1",
        "--dry-run",
        "--json"
      ]
    }
  ],
  "axis": "편집"
}
