{
  "id": "BO15",
  "tier": 3,
  "title": "메일머지 — --verify + --name-field myMsg01",
  "input": "samples/hwpx/form-01.hwpx",
  "instructions": "CSV 2행을 병합해 파일 이름은 myMsg01 값으로 붙이고, 행마다 --verify 를 켜라. 산출은 out/VerifyNameAlpha.hwpx·out/VerifyNameBeta.hwpx. 힌트: rhwp batch fill --form samples/hwpx/form-01.hwpx --data gym/packs/batch-ops/assets/BO15-data.csv --out-dir out --name-field myMsg01 --verify --json.",
  "submit": {
    "kind": "artifact",
    "files": [
      "out/VerifyNameAlpha.hwpx",
      "out/VerifyNameBeta.hwpx"
    ]
  },
  "checks": [
    {
      "name": "1부 산출 존재",
      "op": "file_exists",
      "file": "out/VerifyNameAlpha.hwpx",
      "minBytes": 1
    },
    {
      "name": "마지막 산출 존재 (단건이 아니라 대량)",
      "op": "file_exists",
      "file": "out/VerifyNameBeta.hwpx",
      "minBytes": 1
    },
    {
      "name": "원본 서식과 다름 (무편집 복사 거부)",
      "op": "differs_from_input",
      "file": "out/VerifyNameAlpha.hwpx"
    },
    {
      "name": "VerifyNameAlpha 값이 그 문서에 들어감",
      "op": "value_ge",
      "path": "matchCount",
      "value": 1,
      "cmd": [
        "search",
        "{file:out/VerifyNameAlpha.hwpx}",
        "--json",
        "--",
        "VerifyNameAlpha"
      ]
    },
    {
      "name": "VerifyNameBeta 값이 그 문서에 들어감",
      "op": "value_ge",
      "path": "matchCount",
      "value": 1,
      "cmd": [
        "search",
        "{file:out/VerifyNameBeta.hwpx}",
        "--json",
        "--",
        "VerifyNameBeta"
      ]
    }
  ]
}
