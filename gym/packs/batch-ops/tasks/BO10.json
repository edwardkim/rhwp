{
  "id": "BO10",
  "tier": 3,
  "title": "메일머지 — HWPX 서식 + JSONL",
  "input": "samples/hwpx/form-01.hwpx",
  "instructions": "BO03 의 반대 조합이다. HWPX 서식에 JSONL 2행을 병합해 out/0001.hwpx·out/0002.hwpx 를 만들어라. 힌트: rhwp batch fill --form samples/hwpx/form-01.hwpx --data gym/packs/batch-ops/assets/BO10-data.jsonl --out-dir out --json.",
  "submit": {
    "kind": "artifact",
    "files": [
      "out/0001.hwpx",
      "out/0002.hwpx"
    ]
  },
  "checks": [
    {
      "name": "1부 산출 존재",
      "op": "file_exists",
      "file": "out/0001.hwpx",
      "minBytes": 1
    },
    {
      "name": "마지막 산출 존재 (단건이 아니라 대량)",
      "op": "file_exists",
      "file": "out/0002.hwpx",
      "minBytes": 1
    },
    {
      "name": "원본 서식과 다름 (무편집 복사 거부)",
      "op": "differs_from_input",
      "file": "out/0001.hwpx"
    },
    {
      "name": "1행 JSONL 값이 1부에 들어감",
      "op": "value_ge",
      "path": "matchCount",
      "value": 1,
      "cmd": [
        "search",
        "{file:out/0001.hwpx}",
        "--json",
        "--",
        "HwpxJsonlOne"
      ]
    },
    {
      "name": "2행 JSONL 값이 2부에 들어감",
      "op": "value_ge",
      "path": "matchCount",
      "value": 1,
      "cmd": [
        "search",
        "{file:out/0002.hwpx}",
        "--json",
        "--",
        "HwpxJsonlTwo"
      ]
    }
  ]
}
