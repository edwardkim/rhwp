{
  "id": "BO05",
  "tier": 3,
  "title": "메일머지 — --verify 자기검증 켠 3부",
  "input": "samples/hwpx/form-01.hwpx",
  "instructions": "BO01 과 같은 3행 CSV 로 문서 3부를 만들되, 행마다 저장 직후 자기검증을 켜라. 순번 이름(0001.hwpx·0002.hwpx·0003.hwpx)이어야 하고 각 문서에 그 행의 값이 들어가야 한다. 힌트: rhwp batch fill --form samples/hwpx/form-01.hwpx --data gym/packs/batch-ops/assets/BO01-data.csv --out-dir out --verify --json.",
  "submit": {
    "kind": "artifact",
    "files": [
      "out/0001.hwpx",
      "out/0002.hwpx",
      "out/0003.hwpx"
    ]
  },
  "checks": [
    {
      "name": "1부 산출 존재",
      "op": "file_exists",
      "file": "out/0001.hwpx",
      "minBytes": 1
    },
    {
      "name": "산출 존재",
      "op": "file_exists",
      "file": "out/0002.hwpx",
      "minBytes": 1
    },
    {
      "name": "마지막 산출 존재 (단건이 아니라 대량)",
      "op": "file_exists",
      "file": "out/0003.hwpx",
      "minBytes": 1
    },
    {
      "name": "원본 서식과 다름 (무편집 복사 거부)",
      "op": "differs_from_input",
      "file": "out/0001.hwpx"
    },
    {
      "name": "1행 병합값이 1부에 들어감",
      "op": "value_ge",
      "path": "matchCount",
      "value": 1,
      "cmd": [
        "search",
        "{file:out/0001.hwpx}",
        "--json",
        "--",
        "계약서"
      ]
    },
    {
      "name": "3행 병합값이 3부에 들어감",
      "op": "value_ge",
      "path": "matchCount",
      "value": 1,
      "cmd": [
        "search",
        "{file:out/0003.hwpx}",
        "--json",
        "--",
        "신규"
      ]
    }
  ]
}
