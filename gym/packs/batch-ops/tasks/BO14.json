      "name": "1부 산출 존재",
      "op": "file_exists",
      "file": "out/0001.hwpx",
      "minBytes": 1
    },
    {
      "name": "2부 산출 존재",
      "op": "file_exists",
      "file": "out/0002.hwpx",
      "minBytes": 1
    },
    {
      "name": "3부 산출 존재",
      "op": "file_exists",
      "file": "out/0003.hwpx",
      "minBytes": 1
    },
    {
      "name": "마지막 산출 존재 (단건이 아니라 대량)",
      "op": "file_exists",
      "file": "out/0004.hwpx",
      "minBytes": 1
    },
    {
      "name": "원본 서식과 다름 (무편집 복사 거부)",
      "op": "differs_from_input",
      "file": "out/0001.hwpx"
    },
    {
      "name": "1행 값이 1부에 들어감",
      "op": "value_ge",
      "path": "matchCount",
      "value": 1,
      "cmd": [
        "search",
        "{file:out/0001.hwpx}",
        "--json",
        "--",
        "QuadMergeOne"
      ]
    },
    {
      "name": "4행 값이 4부에 들어감",
