{
  "id": "AU09",
  "tier": 3,
  "title": "감사 보고 발급",
  "input": "samples/table-001.hwp",
  "instructions": "작업 캡슐 폴더(capsules/)에 대한 **감사 보고서**를 report.json 으로 발급해 제출하라. 채점기는 보고서를 다시 만들어 계보 절의 수치를 대조한다. 힌트: rhwp audit-report.",
  "submit": {
    "kind": "artifact",
    "files": [
      "capsules/work.capsule.json",
      "report.json"
    ]
  },
  "checks": [
    {
      "name": "보고서 산출",
      "op": "file_exists",
      "file": "report.json",
      "minBytes": 64
    },
    {
      "name": "계보 유효 머리 1건",
      "op": "value_eq",
      "value": 1,
      "path": "lineage.valid",
      "cmd": [
        "audit-report",
        "{file:capsules}",
        "-o",
        "{file:report.json}",
        "--json"
      ]
    }
  ],
  "axis": "자동화"
}
