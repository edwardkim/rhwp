{
  "id": "XC03",
  "steps": [
    {
      "run": [
        "replay",
        "--plan-json",
        "{\"planVersion\": \"1.0\", \"input\": \"samples/table-001.hwp\", \"output\": \"out.hwp\", \"steps\": [{\"action\": \"set_cell\", \"table\": 0, \"row\": 0, \"col\": 0, \"text\": \"정산완주\"}]}",
        "--capsule",
        "{sub:caps/work.capsule.json}",
        "--json"
      ]
    },
    {
      "write_json": {
        "to": "{sub:wo.json}",
        "body": {
          "schemaVersion": "1.0",
          "kind": "workorder",
          "workorderId": "settle-wo",
          "acceptancePolicy": {
            "schemaVersion": "1.0",
            "kind": "admissionPolicy",
            "default": "deny",
            "rules": [
              {
                "id": "R1-재현",
                "require": {
                  "reproduced": {
                    "eq": true
                  }
                }
              }
            ]
          },
          "unitPrice": {
            "amount": "1000",
            "currency": "KRW",
            "per": "capsule"
          }
        }
      }
    },
    {
      "write_json": {
        "to": "{sub:gate.json}",
        "body": {
          "schemaVersion": "1.0",
          "verdict": "allow",
          "violations": []
        }
      }
    },
    {
      "run": [
        "settle",
        "propose",
        "--workorder",
        "{sub:wo.json}",
        "--capsule",
        "{sub:caps/work.capsule.json}",
        "--gate-envelope",
        "{sub:gate.json}",
        "-o",
        "{sub:claim.json}",
        "--json"
      ]
    },
    {
      "run": [
        "settle",
        "record",
        "{sub:claim.json}",
        "--ledger",
        "{sub:ledger.ndjson}",
        "--verdict",
        "accepted",
        "--json"
      ]
    }
  ]
}
