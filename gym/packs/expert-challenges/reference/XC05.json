{
  "id": "XC05",
  "steps": [
    {
      "run": [
        "keygen",
        "--key-id",
        "gym-audit",
        "--out",
        "{sub:agent.key.json}",
        "--json"
      ]
    },
    {
      "run": [
        "replay",
        "--plan-json",
        "{\"planVersion\": \"1.0\", \"input\": \"samples/table-001.hwp\", \"output\": \"out.hwp\", \"steps\": [{\"action\": \"set_cell\", \"table\": 0, \"row\": 0, \"col\": 0, \"text\": \"감사표준\"}]}",
        "--capsule",
        "{sub:caps/work.capsule.json}",
        "--sign-key",
        "{sub:agent.key.json}",
        "--json"
      ]
    },
    {
      "keyring_from": {
        "key": "{sub:agent.key.json}",
        "out": "{sub:keyring.json}",
        "keyId": "gym-audit"
      }
    },
    {
      "run": [
        "anchor",
        "add",
        "{sub:caps/work.capsule.json}",
        "--log",
        "{sub:anchor.ndjson}",
        "--json"
      ]
    },
    {
      "run": [
        "audit-report",
        "{sub:caps}",
        "-o",
        "{sub:report.json}",
        "--deep",
        "--keyring",
        "{sub:keyring.json}",
        "--anchor-log",
        "{sub:anchor.ndjson}",
        "--json"
      ]
    }
  ]
}
