{
  "id": "CD41",
  "tier": 3,
  "title": "4쪽 시험지 둘째 쪽 추출",
  "input": "samples/exam-kor-4p.hwp",
  "instructions": "입력의 **2–2쪽**만 뽑아낸 page2.hwp 를 제출하라. 추출물은 다시 조판되므로 요청한 범위의 쪽 수와 결과 쪽 수가 항상 같지는 않다 — 단일 쪽 추출이면 결과 쪽수는 1이어야 한다. 힌트: rhwp extract-pages <입력> <출력> --from N --to M. **1 기준**이다.",
  "submit": {
    "kind": "artifact",
    "files": [
      "page2.hwp"
    ]
  },
  "checks": [
    {
      "name": "추출물 실재",
      "op": "file_exists",
      "file": "page2.hwp",
      "minBytes": 1024
    },
    {
      "name": "한 쪽 문서",
      "op": "value_eq",
      "value": 1,
      "path": "pageCount",
      "cmd": [
        "info",
        "{file:page2.hwp}",
        "--json"
      ]
    },
    {
      "name": "원본과 다름",
      "op": "differs_from_input",
      "file": "page2.hwp"
    }
  ]
}
