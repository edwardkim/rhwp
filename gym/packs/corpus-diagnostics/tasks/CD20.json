{
  "id": "CD20",
  "tier": 2,
  "title": "문단 문서 IR 자기대조",
  "input": "samples/para-001.hwp",
  "instructions": "같은 파일을 IR 로 자기 비교해 동일 여부를 answer.json 에 {\"identical\": true|false} 로 제출하라. 자기 자신과는 같아야 정상이다. 힌트: rhwp ir-diff A A.",
  "submit": {
    "kind": "answer",
    "files": [
      "answer.json"
    ]
  },
  "checks": [
    {
      "name": "IR 동일 판정",
      "op": "answer_eq",
      "answer": "identical",
      "path": "identical",
      "cmd": [
        "ir-diff",
        "{input}",
        "{input}",
        "--json"
      ],
      "expect_exits": [
        0,
        3
      ]
    },
    {
      "name": "자기 자신과 동일",
      "op": "value_eq",
      "value": true,
      "path": "identical",
      "cmd": [
        "ir-diff",
        "{input}",
        "{input}",
        "--json"
      ],
      "expect_exits": [
        0,
        3
      ]
    }
  ],
  "axis": "검증"
}
