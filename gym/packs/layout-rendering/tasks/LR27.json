{
  "id": "LR27",
  "tier": 2,
  "title": "표 문서 쪽·표 이중 기대",
  "input": "samples/table-001.hwp",
  "instructions": "입력이 **1쪽 이상이고 표가 1개 이상**임을 한 번에 검증한 판정과 통과 수를 answer.json 에 {\"verdict\": \"...\", \"passed\": N} 으로 제출하라. LR08 은 17쪽급 다쪽 문서, 이 과제는 table-001 이다. 힌트: rhwp verify --expect-min-pages --expect-min-tables.",
  "submit": {
    "kind": "answer",
    "files": [
      "answer.json"
    ]
  },
  "checks": [
    {
      "name": "판정",
      "op": "answer_eq",
      "answer": "verdict",
      "path": "verdict",
      "cmd": [
        "verify",
        "{input}",
        "--expect-min-pages",
        "1",
        "--expect-min-tables",
        "1",
        "--json"
      ],
      "expect_exits": [
        0,
        3
      ]
    },
    {
      "name": "통과 기대 수",
      "op": "answer_eq",
      "answer": "passed",
      "path": "passCount",
      "cmd": [
        "verify",
        "{input}",
        "--expect-min-pages",
        "1",
        "--expect-min-tables",
        "1",
        "--json"
      ],
      "expect_exits": [
        0,
        3
      ]
    }
  ],
  "axis": "검증"
}
