{
  "id": "LR45",
  "tier": 2,
  "title": "영문 표본 형식 자기검증",
  "input": "samples/basic/english.hwp",
  "instructions": "입력이 **hwp5** 형식임을 검증한 판정을 answer.json 에 {\"verdict\": \"...\"} 으로 제출하라. 힌트: rhwp verify --expect-format.",
  "submit": {
    "kind": "answer",
    "files": [
      "answer.json"
    ]
  },
  "checks": [
    {
      "name": "형식 판정",
      "op": "answer_eq",
      "answer": "verdict",
      "path": "verdict",
      "cmd": [
        "verify",
        "{input}",
        "--expect-format",
        "hwp5",
        "--json"
      ],
      "expect_exits": [
        0,
        3
      ]
    }
  ],
  "axis": "검증"
}
