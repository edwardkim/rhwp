{
  "id": "LR25",
  "tier": 2,
  "title": "표 문서 최소 1표 자기검증",
  "input": "samples/table-001.hwp",
  "instructions": "입력이 **표 1개 이상**임을 검증한 판정을 answer.json 에 {\"verdict\": \"...\"} 으로 제출하라. 힌트: rhwp verify --expect-min-tables 1.",
  "submit": {
    "kind": "answer",
    "files": [
      "answer.json"
    ]
  },
  "checks": [
    {
      "name": "판정",
      "op": "answer_eq",
      "answer": "verdict",
      "path": "verdict",
      "cmd": [
        "verify",
        "{input}",
        "--expect-min-tables",
        "1",
        "--json"
      ],
      "expect_exits": [
        0,
        3
      ]
    }
  ],
  "axis": "검증"
}
