{
  "id": "LR20",
  "tier": 2,
  "title": "HWPX 서식 형식 자기검증",
  "input": "samples/hwpx/form-01.hwpx",
  "instructions": "입력이 **hwpx** 형식임을 검증한 판정을 answer.json 에 {\"verdict\": \"...\"} 으로 제출하라. hwp5 기대를 그대로 쓰면 틀린다. 힌트: rhwp verify --expect-format hwpx.",
  "submit": {
    "kind": "answer",
    "files": [
      "answer.json"
    ]
  },
  "checks": [
    {
      "name": "형식 판정",
      "op": "answer_eq",
      "answer": "verdict",
      "path": "verdict",
      "cmd": [
        "verify",
        "{input}",
        "--expect-format",
        "hwpx",
        "--json"
      ],
      "expect_exits": [
        0,
        3
      ]
    }
  ],
  "axis": "검증"
}
