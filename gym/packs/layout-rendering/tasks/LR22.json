{
  "id": "LR22",
  "tier": 2,
  "title": "표 문서 최소 1쪽 자기검증",
  "input": "samples/table-001.hwp",
  "instructions": "입력이 **1쪽 이상**임을 검증한 판정을 answer.json 에 {\"verdict\": \"...\"} 으로 제출하라. LR06 의 100쪽 기대와 달리 이 기대는 보통 통과한다. 힌트: rhwp verify --expect-min-pages.",
  "submit": {
    "kind": "answer",
    "files": [
      "answer.json"
    ]
  },
  "checks": [
    {
      "name": "판정",
      "op": "answer_eq",
      "answer": "verdict",
      "path": "verdict",
      "cmd": [
        "verify",
        "{input}",
        "--expect-min-pages",
        "1",
        "--json"
      ],
      "expect_exits": [
        0,
        3
      ]
    }
  ],
  "axis": "검증"
}
