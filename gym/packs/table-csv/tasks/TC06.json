{
  "id": "TC06",
  "tier": 2,
  "title": "표 CSV 추출 — BOM 붙인 table-001",
  "input": "samples/table-001.hwp",
  "instructions": "이 문서 표 0 을 UTF-8 BOM 을 붙여 CSV 로 뽑아 bom.csv 로 제출하라. (0,0) 은 '구 분' 이어야 한다. 힌트: rhwp table-to-csv <문서> --table 0 --bom -o bom.csv.",
  "submit": {
    "kind": "artifact",
    "files": [
      "bom.csv"
    ]
  },
  "checks": [
    {
      "name": "CSV 산출",
      "op": "file_exists",
      "file": "bom.csv",
      "minBytes": 8
    },
    {
      "name": "원본과 다름(무편집 복사 거부)",
      "op": "differs_from_input",
      "file": "bom.csv"
    },
    {
      "name": "UTF-8 BOM",
      "op": "utf8_bom",
      "file": "bom.csv"
    },
    {
      "name": "표0 (0,0) 이 구 분",
      "op": "csv_cell_eq",
      "file": "bom.csv",
      "row": 0,
      "col": 0,
      "value": "구 분"
    }
  ]
}
