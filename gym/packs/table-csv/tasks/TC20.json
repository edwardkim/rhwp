    {
      "name": "원본과 다름(무편집 거부)",
      "op": "differs_from_input",
      "file": "out.hwp"
    },
    {
      "name": "2010년 수입이 이미 55(센티넬 재적용 무변경)",
      "op": "value_eq",
      "path": "changedCount",
      "value": 0,
      "cmd": [
        "csv-to-table",
        "{file:out.hwp}",
        "--table",
        "0",
        "--csv",
        "gym/packs/table-csv/assets/TC20-edit.csv",
        "--dry-run",
        "--json"
      ]
    }
  ]
