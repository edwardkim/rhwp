{
  "id": "TC02",
  "tier": 2,
  "title": "표 CSV 추출 — 격자 값 대조",
  "input": "samples/hwpx/basic-table-01.hwpx",
  "instructions": "이 문서 표 0 을 CSV 로 뽑아 table.csv 로 제출하라. 채점은 좌표 칸을 대조한다 — (0,0) 은 1, (1,2) 는 7 이어야 한다. 힌트: rhwp table-to-csv <문서> --table 0 -o table.csv.",
  "submit": {
    "kind": "artifact",
    "files": [
      "table.csv"
    ]
  },
  "checks": [
    {
      "name": "CSV 산출",
      "op": "file_exists",
      "file": "table.csv",
      "minBytes": 8
    },
    {
      "name": "원본과 다름(무편집 복사 거부)",
      "op": "differs_from_input",
      "file": "table.csv"
    },
    {
      "name": "표0 (0,0) 이 1",
      "op": "csv_cell_eq",
      "file": "table.csv",
      "row": 0,
      "col": 0,
      "value": 1
    },
    {
      "name": "표0 (1,2) 이 7",
      "op": "csv_cell_eq",
      "file": "table.csv",
      "row": 1,
      "col": 2,
      "value": 7
    }
  ]
}
