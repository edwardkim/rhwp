{
  "id": "TE48",
  "tier": 3,
  "title": "삽입 후 첫 일치 쪽",
  "input": "samples/para-001.hwp",
  "instructions": "입력의 구역 0 · 문단 0 · 오프셋 0 에 '짐표지TE48' 을 넣은 ins48.hwp 를 제출하라. 좌표는 전부 0 기준이며 search 주소와 같다. 채점은 그 표지가 정확히 1건인지 재검색한다. 힌트: rhwp edit insert-text --section 0 --para 0 --offset 0. 첫 일치 쪽 번호(0 기준)를 answer.json 에 {\"page\": N} 으로 적어라. search 의 page 는 0 기준이다.",
  "submit": {
    "kind": "artifact",
    "files": [
      "ins48.hwp",
      "answer.json"
    ]
  },
  "checks": [
    {
      "name": "삽입 표지 1건",
      "op": "value_eq",
      "value": 1,
      "path": "matchCount",
      "cmd": [
        "search",
        "{file:ins48.hwp}",
        "--json",
        "--",
        "짐표지TE48"
      ]
    },
    {
      "name": "원본과 다름",
      "op": "differs_from_input",
      "file": "ins48.hwp"
    },
    {
      "name": "첫 일치 쪽",
      "op": "answer_eq",
      "answer": "page",
      "path": "matches[0].page",
      "cmd": [
        "search",
        "{file:ins48.hwp}",
        "--json",
        "--",
        "짐표지TE48"
      ]
    }
  ]
}
