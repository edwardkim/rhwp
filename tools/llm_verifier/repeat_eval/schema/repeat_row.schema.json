{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhwp.local/llm_verifier/repeat_eval/repeat_row.schema.json",
  "title": "V-repeat evaluation row",
  "description": "One (artifact, k, check, votes, variance, final) record. Not a Best-of-N ranking and not a criteria split.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "claim",
    "kind",
    "recordId",
    "uniquenessKey",
    "artifact",
    "k",
    "check",
    "trials",
    "votes",
    "variance",
    "finalValue"
  ],
  "properties": {
    "schemaVersion": { "const": "v-repeat.1.0" },
    "claim": { "const": "V-repeat" },
    "kind": { "const": "repeatEvaluation" },
    "recordId": { "type": "string", "minLength": 1 },
    "uniquenessKey": { "type": "string", "minLength": 3 },
    "artifact": {
      "type": "object",
      "required": ["artifactId", "command", "sample", "intendedExit"],
      "properties": {
        "artifactId": { "type": "string", "minLength": 1 },
        "command": { "type": "string" },
        "sample": { "type": "string" },
        "argv": { "type": "array", "items": { "type": "string" } },
        "intendedExit": { "type": "integer", "minimum": 0, "maximum": 4 },
        "intended": { "type": "object" }
      }
    },
    "k": { "type": "integer", "minimum": 2, "maximum": 64 },
    "check": {
      "type": "object",
      "required": ["name", "kind", "valueKind"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "enum": ["exitClass", "envelopeField", "passFail"] },
        "valueKind": { "enum": ["exit", "bool", "u64", "text", "passFail"] },
        "path": { "type": "string" }
      }
    },
    "trials": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "trial.schema.json" }
    },
    "votes": {
      "type": "object",
      "required": ["counts", "plurality", "majorityCount", "isTie", "majorityFrac"],
      "properties": {
        "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
        "majority": { "type": ["string", "null"] },
        "plurality": { "type": "string" },
        "majorityCount": { "type": "integer" },
        "isTie": { "type": "boolean" },
        "majorityFrac": { "type": "number" }
      }
    },
    "variance": {
      "type": "object",
      "required": ["n", "distinct", "disagreement"],
      "properties": {
        "n": { "type": "integer" },
        "distinct": { "type": "integer" },
        "disagreement": { "type": "number" },
        "sampleVariance": { "type": ["number", "null"] },
        "mean": { "type": ["number", "null"] },
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] }
      }
    },
    "finalValue": { "$ref": "reduce_report.schema.json#/$defs/finalValue" }
  }
}
