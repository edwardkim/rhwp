{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhwp.local/llm_verifier/repeat_eval/reduce_report.schema.json",
  "title": "V-repeat reduce report",
  "description": "Majority or mean of K mechanical checks. Not a candidate ranking.",
  "type": "object",
  "required": ["artifactId", "k", "check", "votes", "variance", "finalValue"],
  "properties": {
    "artifactId": { "type": "string" },
    "k": { "type": "integer", "minimum": 2 },
    "check": { "type": "string" },
    "votes": { "type": "object" },
    "variance": { "type": "object" },
    "finalValue": { "$ref": "#/$defs/finalValue" }
  },
  "$defs": {
    "finalValue": {
      "type": "object",
      "required": ["reduce", "value", "tie", "pass"],
      "properties": {
        "reduce": { "enum": ["majority", "mean"] },
        "value": { "type": "string" },
        "tie": { "type": "boolean" },
        "pass": { "type": "boolean" },
        "numeric": { "type": ["number", "null"] }
      }
    }
  }
}
