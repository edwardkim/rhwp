{
  "producer": "tools/oracle_public/page_smoke.py",
  "consumed_as": "data",
  "rewritten": false,
  "schemaVersion": 1,
  "kind": "pageSmokeReport",
  "pairKind": "pageSmokePairs",
  "rowVerdicts": ["MATCH", "MISMATCH", "ERROR"],
  "rowFields": [
    "doc",
    "pdf",
    "stem",
    "rhwpPages",
    "pdfPages",
    "delta",
    "verdict",
    "note",
    "repro"
  ],
  "summaryKeys": ["pairs", "match", "mismatch", "error", "unpaired"],
  "signals": {
    "page_count_match": "row.verdict == MATCH",
    "cheap_ok_false": "row.verdict == ERROR",
    "independent_mismatch": "row.verdict == MISMATCH"
  }
}
