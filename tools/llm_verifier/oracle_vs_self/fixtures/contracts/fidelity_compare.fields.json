{
  "producer": "tools/fidelity_compare/fidelity_compare.py",
  "consumed_as": "data",
  "rewritten": false,
  "requiresHangulPdf": true,
  "outputs": {
    "page-count-ledger.tsv": {
      "columns": ["measure", "pages", "delta_from_reference", "scope", "note"],
      "measures": ["reference_pdf", "rhwp_svg", "rhwp_render_tree"],
      "note": "page-count difference is a candidate, not a global-break fix"
    },
    "report.tsv": "pixel diff% ranking; candidate, not a final bug",
    "text-report.tsv": "character multiset missing/excess; candidate",
    "provenance.tsv": "source / reference-pdf / reference-grade",
    "run-state.tsv": "requested/completed/missing; missing ⇒ nonzero exit"
  },
  "signals": {
    "cannot_open_without_reference_pdf": true,
    "pixel_and_text_remain_candidates_even_when_ORACLE_TRUSTED": true
  }
}
