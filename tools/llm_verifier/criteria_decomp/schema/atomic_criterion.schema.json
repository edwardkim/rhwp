{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhwp.local/schema/v-decomp.atomic-criterion.json",
  "title": "V-decomp atomic criterion",
  "description": "한 원자 기준. 총점이 아니라 기존 rhwp 봉투 필드 하나에 결속한다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["criterionId", "task", "envelopeField", "expected"],
  "properties": {
    "criterionId": { "type": "string", "minLength": 1 },
    "task": { "type": "string" },
    "envelopeField": { "type": "string", "minLength": 1 },
    "command": { "type": "string" },
    "expected": { "$ref": "envelope_atom.schema.json" }
  }
}
