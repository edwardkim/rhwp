{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rhwp.llm_verifier.untrusted_sandbox.sandbox_case.v1",
  "title": "V-nonce sandbox case",
  "type": "object",
  "required": [
    "case_id",
    "excerpt",
    "nonce",
    "slot",
    "leaked_into_criteria",
    "expected_block"
  ],
  "properties": {
    "case_id": { "type": "string" },
    "excerpt": { "type": "string", "description": "Document-derived text from an untrusted field" },
    "nonce": { "type": "string", "description": "Boundary nonce; empty/static/collision must block wrap" },
    "slot": {
      "type": "string",
      "enum": [
        "criteria",
        "system_prompt",
        "tool_arg_path",
        "tool_name",
        "shell_command",
        "url_body",
        "run_plan",
        "authorization",
        "user_display",
        "llm_data_block"
      ]
    },
    "leaked_into_criteria": { "type": "boolean" },
    "expected_block": { "type": "boolean" },
    "field_path": { "type": "string" },
    "command": { "type": "string" },
    "source_label": { "type": "string" },
    "source_label_kind": {
      "type": "string",
      "enum": ["caller_path", "handle", "document_title"]
    },
    "wrap_state": { "type": "string" },
    "nonce_kind": { "type": "string" },
    "untrusted_content": { "type": "boolean" },
    "fail_kinds": { "type": "string" },
    "sample": { "type": "string" }
  },
  "additionalProperties": false
}
