{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhwp.local/schema/v-step/check_observation.schema.json",
  "title": "CheckObservation",
  "description": "기존 rhwp 검사 한 건. 새 CLI 없음.",
  "type": "object",
  "additionalProperties": false,
  "required": ["check", "exitClass", "pass", "failSignals"],
  "properties": {
    "check": {
      "type": "string",
      "enum": ["verify", "layout-anomaly", "pageCount", "fill-verify"]
    },
    "argv": {
      "type": "array",
      "items": { "type": "string" }
    },
    "exitClass": { "type": "integer", "enum": [0, 1, 2, 3, 4] },
    "pass": { "type": "boolean" },
    "failSignals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "envelope": {
      "type": ["object", "null"]
    },
    "fields": { "type": "object" }
  }
}
