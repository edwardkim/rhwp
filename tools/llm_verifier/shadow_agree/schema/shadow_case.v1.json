{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/edwardkim/rhwp/tools/llm_verifier/shadow_agree/schema/shadow_case.v1.json",
  "title": "V-shadow decision case",
  "description": "Two different existing mechanical commands must both pass. Issue #5510.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "check_a",
    "check_b",
    "a_pass",
    "b_pass",
    "expected_joint",
    "expected_verdict_class"
  ],
  "properties": {
    "case_id": { "type": "string", "minLength": 1 },
    "check_a": { "type": "string", "minLength": 1 },
    "check_b": { "type": "string", "minLength": 1 },
    "a_pass": { "type": "boolean" },
    "b_pass": { "type": "boolean" },
    "expected_joint": { "type": "boolean" },
    "expected_verdict_class": {
      "type": "string",
      "enum": [
        "JOINT_PASS",
        "SHADOW_A_ONLY",
        "SHADOW_B_ONLY",
        "JOINT_BOTH_FAIL",
        "SAME_CHECK_NOT_SHADOW"
      ]
    },
    "sample": { "type": "string" },
    "source_format": { "type": "string", "enum": ["hwp", "hwpx", ""] },
    "family": { "type": "string" },
    "agency": { "type": "string" },
    "year": { "type": "string" },
    "page_a": { "type": "integer", "minimum": 0 },
    "page_b": { "type": "integer", "minimum": 0 },
    "command_a": { "type": "string" },
    "command_b": { "type": "string" },
    "field_a": { "type": "string" },
    "field_b": { "type": "string" },
    "observed_a": { "type": "string" },
    "observed_b": { "type": "string" },
    "honest_claim": { "type": "string" },
    "contract_source": { "type": "string" },
    "not_abstain": { "type": "boolean" },
    "not_repeat": { "type": "boolean" }
  }
}
