{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhwp.local/llm_verifier/abstain/contradiction_case.v1.json",
  "title": "V-abstain contradiction case",
  "type": "object",
  "required": ["case_id", "command", "exit", "expected"],
  "additionalProperties": true,
  "properties": {
    "case_id": { "type": "string" },
    "command": {
      "type": "string",
      "enum": [
        "info",
        "verify",
        "ir-diff",
        "layout-anomaly",
        "replay",
        "fill-fields",
        "render-diff"
      ]
    },
    "exit": { "type": "integer", "enum": [0, 1, 2, 3, 4] },
    "expected": { "type": "string", "enum": ["abstain", "pass", "fail"] },
    "contradiction_id": { "type": "string" }
  }
}
