{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhwp.dev/schema/llm-verifier/coord-bind.v-bind.1.0.json",
  "title": "DocumentCoordsBind",
  "description": "Closed coordinate key set copied from rhwp search/extract-data envelopes. Invented keys (line, column, pdfPage, humanPage, offset) are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "section": { "type": "integer", "minimum": 0 },
    "paragraph": { "type": "integer", "minimum": 0 },
    "page": { "type": "integer", "minimum": 0, "description": "0-based page from the envelope. Missing key means not laid out; do not invent 1-based page." },
    "charOffset": { "type": "integer", "minimum": 0 },
    "length": { "type": "integer", "minimum": 0 },
    "cell": {
      "type": "object",
      "properties": {
        "row": { "type": "integer", "minimum": 0 },
        "col": { "type": "integer", "minimum": 0 }
      }
    },
    "textbox": { "type": "object" }
  }
}
