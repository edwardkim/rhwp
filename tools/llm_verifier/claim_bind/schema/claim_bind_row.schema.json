{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhwp.dev/schema/llm-verifier/claim-bind-row.v-bind.1.0.json",
  "title": "ClaimBindRow",
  "description": "LLM-as-verifier axis 3 fixture row: claim_text, coords_present, field_set, pass/fail. Coordinates are copied from existing search/extract-data envelopes only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rowId",
    "claimText",
    "coordsPresent",
    "fieldSet",
    "envelopeKind",
    "verdict"
  ],
  "properties": {
    "rowId": { "type": "string", "pattern": "^CB-[0-9]{6}$" },
    "claimText": { "type": "string" },
    "coordsPresent": { "type": "boolean" },
    "fieldSet": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "section",
          "paragraph",
          "page",
          "charOffset",
          "length",
          "cell",
          "textbox"
        ]
      },
      "uniqueItems": true
    },
    "envelopeKind": {
      "type": "string",
      "enum": ["search", "extract-data"]
    },
    "verdict": { "type": "string", "enum": ["pass", "fail"] },
    "failKind": {
      "type": ["string", "null"],
      "enum": [
        "unbound",
        "incomplete_coords",
        "invented_key",
        "empty_claim",
        "envelope_mismatch",
        "unknown_envelope_kind",
        null
      ]
    },
    "file": { "type": "string" },
    "quote": { "type": "string" },
    "dataKind": { "type": ["string", "null"], "enum": ["date", "amount", null] },
    "section": { "type": ["integer", "null"], "minimum": 0 },
    "paragraph": { "type": ["integer", "null"], "minimum": 0 },
    "page": { "type": ["integer", "null"], "minimum": 0 },
    "charOffset": { "type": ["integer", "null"], "minimum": 0 },
    "length": { "type": ["integer", "null"], "minimum": 0 },
    "cell": { "type": ["object", "null"] },
    "textbox": { "type": ["object", "null"] },
    "inventedKeys": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
