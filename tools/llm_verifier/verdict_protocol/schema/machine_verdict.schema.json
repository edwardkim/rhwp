{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhwp.local/schema/v-proto/machine_verdict.schema.json",
  "title": "ProtocolDecision",
  "description": "분류기 출력. 산문 등급이 아니라 닫힌 열거와 필드 근거.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exitClass",
    "exitName",
    "machineVerdict",
    "consistent",
    "hasEnvelope",
    "command",
    "judgment",
    "failSignals",
    "ruleId"
  ],
  "properties": {
    "exitClass": { "type": "integer", "enum": [0, 1, 2, 3, 4] },
    "exitName": {
      "type": "string",
      "enum": ["ok", "io", "usage", "judgment", "page_verify"]
    },
    "machineVerdict": {
      "type": "string",
      "enum": [
        "pass",
        "io_fail",
        "usage_fail",
        "judgment_fail",
        "page_verify_fail",
        "inconsistent"
      ]
    },
    "consistent": { "type": "boolean" },
    "hasEnvelope": { "type": "boolean" },
    "command": {
      "type": "string",
      "enum": [
        "info",
        "verify",
        "ir-diff",
        "layout-anomaly",
        "replay",
        "fill-fields",
        "render-diff"
      ]
    },
    "judgment": { "$ref": "judgment_fields.schema.json" },
    "failSignals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ruleId": { "type": "string" }
  }
}
