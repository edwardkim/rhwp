{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhwp.local/schema/v-proto/judgment_fields.schema.json",
  "title": "Extracted rhwp judgment fields",
  "description": "지식지도 §2-2 판정 필드만. 이름은 기존 봉투와 같다.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "identical": { "type": ["boolean", "null"] },
    "hasSignal": { "type": ["boolean", "null"] },
    "reproduced": {
      "description": "replay bool|null, audit number",
      "oneOf": [
        { "type": "boolean" },
        { "type": "integer", "minimum": 0 },
        { "type": "null" }
      ]
    },
    "findingCount": { "type": ["integer", "null"], "minimum": 0 },
    "verify": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "identical": { "type": ["boolean", "null"] },
        "diffCount": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "failCount": { "type": ["integer", "null"], "minimum": 0 },
    "passCount": { "type": ["integer", "null"], "minimum": 0 },
    "verdict": { "type": ["string", "null"] },
    "regression": { "type": ["boolean", "null"] },
    "status": { "type": ["string", "null"] },
    "clean": { "type": ["boolean", "null"] },
    "signalCount": { "type": ["integer", "null"], "minimum": 0 },
    "valid": { "type": ["boolean", "null"] },
    "diffCount": { "type": ["integer", "null"], "minimum": 0 },
    "strict": { "type": ["boolean", "null"] },
    "overflowCount": { "type": ["integer", "null"], "minimum": 0 },
    "overlapCount": { "type": ["integer", "null"], "minimum": 0 },
    "emptyPageCount": { "type": ["integer", "null"], "minimum": 0 },
    "pageCountMismatch": { "type": ["boolean", "null"] },
    "overPages": { "type": ["integer", "null"], "minimum": 0 }
  }
}
