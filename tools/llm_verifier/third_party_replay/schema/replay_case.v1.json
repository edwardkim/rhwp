{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhwp.local/llm_verifier/third_party_replay/replay_case.v1.json",
  "title": "V-replay third-party labor case",
  "type": "object",
  "required": ["plan", "expect_sha", "reproduced", "tool_version", "verdict"],
  "properties": {
    "case_id": { "type": "string" },
    "plan": { "type": "string", "description": "Plan text bytes; planSha256 target" },
    "expect_sha": {
      "type": "string",
      "description": "rhwp replay --expect-output-sha256 / expectedOutputSha256"
    },
    "reproduced": {
      "description": "Envelope reproduced: true/false/null (attest)",
      "anyOf": [{ "type": "boolean" }, { "type": "string" }, { "type": "null" }]
    },
    "tool_version": { "type": "string", "description": "receipt.toolVersion" },
    "verdict": {
      "type": "string",
      "enum": [
        "LABOR_ACCEPTED",
        "LABOR_REJECTED",
        "ATTEST_NOT_THIRD_PARTY",
        "PROSE_NOT_EVIDENCE",
        "NO_EXPECT_SHA",
        "INVALID_EXPECT_SHA",
        "TOOL_VERSION_MISSING",
        "TOOL_VERSION_MISMATCH",
        "NO_PLAN"
      ]
    },
    "mode": { "type": "string", "enum": ["verify", "attest", "absent"] },
    "source": { "type": "string", "enum": ["replay", "capsule", "prose"] }
  },
  "additionalProperties": true
}
