{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rhwp.form_fill.path_contract.v1",
  "title": "existing CLI argv contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "argv",
    "exit"
  ],
  "properties": {
    "existingCliOnly": {
      "const": true
    },
    "argv": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exit": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3
      ]
    }
  }
}
