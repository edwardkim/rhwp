{
  "id": "roundtrip_plain",
  "sample": "samples/hwp_table_test.hwp",
  "steps": [
    {
      "id": "scan",
      "command": [
        "rhwp",
        "export-tables",
        "samples/hwp_table_test.hwp",
        "--json"
      ],
      "expectExit": 0
    },
    {
      "id": "extract",
      "command": [
        "rhwp",
        "table-to-csv",
        "samples/hwp_table_test.hwp",
        "--table",
        "0",
        "-o",
        "table0.csv",
        "--json"
      ],
      "expectExit": 0
    },
    {
      "id": "dry-run",
      "command": [
        "rhwp",
        "csv-to-table",
        "samples/hwp_table_test.hwp",
        "--csv",
        "R-recipe02-edited.csv",
        "--table",
        "0",
        "--dry-run",
        "--json",
        "-o",
        "out/R-recipe02-edited.hwp"
      ],
      "expectExit": 0,
      "forbidFieldsPresent": [
        "output"
      ],
      "expect": {
        "changedCount": 9,
        "dryRun": true
      }
    },
    {
      "id": "write-verify",
      "command": [
        "rhwp",
        "csv-to-table",
        "samples/hwp_table_test.hwp",
        "--csv",
        "V-recipe02-verify-ok.csv",
        "--table",
        "0",
        "--json",
        "-o",
        "out/V-recipe02-verify-ok.hwp",
        "--verify"
      ],
      "expectExit": 0,
      "expect": {
        "changedCount": 9,
        "verify.identical": true
      }
    }
  ]
}
