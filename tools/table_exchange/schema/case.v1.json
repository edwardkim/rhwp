{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rhwp.table_exchange.case.v1",
  "type": "object",
  "required": [
    "caseId",
    "family",
    "command",
    "expectExit",
    "writes",
    "envelope"
  ],
  "properties": {
    "caseId": {
      "type": "string"
    },
    "family": {
      "enum": [
        "dimension",
        "covered",
        "dry-run",
        "verify",
        "export-tables",
        "table-to-csv"
      ]
    },
    "command": {
      "enum": [
        "export-tables",
        "table-to-csv",
        "csv-to-table"
      ]
    },
    "expectExit": {
      "enum": [
        0,
        1,
        2,
        3
      ]
    },
    "writes": {
      "type": "boolean"
    }
  }
}
