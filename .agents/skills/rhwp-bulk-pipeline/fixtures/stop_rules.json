{
  "schemaVersion": "1.0",
  "issue": 5311,
  "skill": "rhwp-bulk-pipeline",
  "notGym": true,
  "noNewCli": true,
  "rules": [
    {
      "id": "B01",
      "when": "목록이 비었거나 경로가 디렉터리",
      "action": "find/Get-ChildItem 부터. 본작업 금지",
      "notGym": true
    },
    {
      "id": "B02",
      "when": "info 전건 error",
      "action": "작업 디렉터리·상대경로 확인",
      "notGym": true
    },
    {
      "id": "B03",
      "when": "batch 에 --password 계열",
      "action": "exit 2. 단건 명령으로 분리",
      "notGym": true
    },
    {
      "id": "B04",
      "when": "질문이 규모/형식뿐",
      "action": "info 에서 정지",
      "notGym": true
    },
    {
      "id": "B05",
      "when": "export-text error 행",
      "action": "jq 로 실패만 재시도",
      "notGym": true
    },
    {
      "id": "B06",
      "when": "export-structure --mode 오타",
      "action": "exit 2. auto|outline|clause",
      "notGym": true
    },
    {
      "id": "B07",
      "when": "tableCount 0",
      "action": "실패 아님. 표 없는 문서",
      "notGym": true
    },
    {
      "id": "B08",
      "when": "fieldCount 0",
      "action": "누름틀 없음. table-exchange 후보",
      "notGym": true
    },
    {
      "id": "B09",
      "when": "search --query 없음",
      "action": "exit 2. 입력 미소비",
      "notGym": true
    },
    {
      "id": "B10",
      "when": "extract-data truncated",
      "action": "문서마다 한도. counts 는 절단 전",
      "notGym": true
    },
    {
      "id": "B11",
      "when": "convert 이름 충돌",
      "action": "exit 2, 한 파일도 안 씀",
      "notGym": true
    },
    {
      "id": "B12",
      "when": "fill 에 stdin 목록",
      "action": "--form + --data 로 다시",
      "notGym": true
    },
    {
      "id": "B13",
      "when": "N ≠ 성공+실패",
      "action": "파이프 중간(head/grep) 의심",
      "notGym": true
    },
    {
      "id": "B14",
      "when": "exit 1 인데 실패 행 안 보임",
      "action": "stderr 요약을 stdout 과 섞지 말 것",
      "notGym": true
    },
    {
      "id": "B15",
      "when": "verify IR 차이",
      "action": "exit 3. 산출은 남음",
      "notGym": true
    },
    {
      "id": "B16",
      "when": "verify-pages 불일치",
      "action": "exit 4 (error 없을 때)",
      "notGym": true
    },
    {
      "id": "B17",
      "when": "질문이 이미 답",
      "action": "다음 축으로 내려가지 않음",
      "notGym": true
    },
    {
      "id": "B18",
      "when": "--out-dir 가 - 로 시작",
      "action": "./-결과 로 명시",
      "notGym": true
    }
  ]
}
