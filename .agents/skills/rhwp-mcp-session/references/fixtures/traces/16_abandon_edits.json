{
  "id": "16_abandon_edits",
  "title": "저장하지 않고 닫으면 인메모리 누적은 사라진다. 이것이 계약이다.",
  "kind": "session",
  "lifecycle": "hwp_open → doc_* → hwp_close",
  "absolute_paths": true,
  "single_write_point": "hwp_doc_save",
  "steps": [
    {
      "seq": 1,
      "tool": "hwp_open",
      "arguments": {
        "path": "C:/abs/서식.hwp"
      },
      "expect_layer": "ok",
      "read_fields": [
        "docId"
      ],
      "notes": ""
    },
    {
      "seq": 2,
      "tool": "hwp_doc_replace_text",
      "arguments": {
        "docId": "doc-1",
        "find": "임시",
        "replace": "폐기"
      },
      "expect_layer": "envelope",
      "read_fields": [
        "replacedCount"
      ],
      "notes": ""
    },
    {
      "seq": 3,
      "tool": "hwp_close",
      "arguments": {
        "docId": "doc-1"
      },
      "expect_layer": "ok",
      "read_fields": [
        "closed"
      ],
      "notes": ""
    }
  ]
}
