{
  "id": "07_workspace_open",
  "title": "워크스페이스 id 로 연다. --workspace 기동 전제.",
  "kind": "session",
  "lifecycle": "hwp_open → doc_* → hwp_close",
  "absolute_paths": true,
  "single_write_point": "hwp_doc_save",
  "steps": [
    {
      "seq": 1,
      "tool": "hwp_ws_list",
      "arguments": {},
      "expect_layer": "ok",
      "read_fields": [
        "entries"
      ],
      "notes": ""
    },
    {
      "seq": 2,
      "tool": "hwp_ws_open",
      "arguments": {
        "id": "w1"
      },
      "expect_layer": "ok",
      "read_fields": [
        "docId"
      ],
      "notes": ""
    },
    {
      "seq": 3,
      "tool": "hwp_doc_tree",
      "arguments": {
        "docId": "doc-1"
      },
      "expect_layer": "ok",
      "read_fields": [
        "nodes"
      ],
      "notes": ""
    },
    {
      "seq": 4,
      "tool": "hwp_close",
      "arguments": {
        "docId": "doc-1"
      },
      "expect_layer": "ok",
      "read_fields": [
        "closed"
      ],
      "notes": ""
    }
  ]
}
