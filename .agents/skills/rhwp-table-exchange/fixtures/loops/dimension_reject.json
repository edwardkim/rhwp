{
  "id": "dimension_reject",
  "sample": "samples/table-001.hwp",
  "steps": [
    {
      "id": "scan",
      "command": [
        "rhwp",
        "export-tables",
        "samples/table-001.hwp",
        "--json"
      ],
      "expectExit": 0,
      "readFields": [
        "tables[0].rows",
        "tables[0].cols"
      ],
      "expect": {
        "rows": 19,
        "cols": 9
      }
    },
    {
      "id": "dry-run-bad",
      "command": [
        "rhwp",
        "csv-to-table",
        "samples/table-001.hwp",
        "--csv",
        "out/bad.csv",
        "--table",
        "0",
        "--dry-run",
        "--json"
      ],
      "expectExit": 2,
      "readFields": [
        "invalid",
        "changedCount"
      ],
      "expect": {
        "changedCount": 0
      },
      "expectReasons": [
        "rowCountMismatch",
        "colCountMismatch"
      ]
    }
  ]
}
