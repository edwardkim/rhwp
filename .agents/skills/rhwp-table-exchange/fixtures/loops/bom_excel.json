{
  "id": "bom_excel",
  "steps": [
    {
      "id": "extract-plain",
      "command": [
        "rhwp",
        "table-to-csv",
        "문서.hwp",
        "--table",
        "0",
        "-o",
        "t.csv",
        "--json"
      ],
      "expect": {
        "bom": false
      }
    },
    {
      "id": "extract-bom",
      "command": [
        "rhwp",
        "table-to-csv",
        "문서.hwp",
        "--table",
        "0",
        "-o",
        "t.csv",
        "--bom",
        "--json"
      ],
      "expect": {
        "bom": true,
        "envelopeCsvHasBom": false,
        "fileHasBom": true
      }
    }
  ]
}
