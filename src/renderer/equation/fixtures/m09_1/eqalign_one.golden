    rows: [
        (
            Row(
                [
                    Text(
                        "a",
                    ),
                    Symbol(
                        "+",
                    ),
                    Text(
                        "b",
                    ),
                ],
            ),
            Row(
                [
                    Symbol(
                        "=",
                    ),
                    Text(
                        "c",
                    ),
                ],
            ),
        ),
    ],
}

