# M09-1 equation golden — current-engine lock
command: EQALIGN
script: EQALIGN{x &= 1 # y &= 2}

=== ast ===
EqAlign {
    rows: [
        (
            Text(
                "x",
            ),
            Row(
                [
                    Symbol(
                        "=",
                    ),
                    Number(
                        "1",
                    ),
                ],
            ),
        ),
        (
            Text(
                "y",
            ),
            Row(
                [
                    Symbol(
                        "=",
                    ),
                    Number(
                        "2",
                    ),
                ],
            ),
        ),
    ],
}

=== layout ===
