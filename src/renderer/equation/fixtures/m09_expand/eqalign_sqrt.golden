# M09-g equation golden — current-engine lock (variant/exception/unimplemented honesty)
command: EQALIGN
script: EQALIGN{SQRT x &= 2 # SQRT y &= 3}
honesty: implemented-variant

=== ast ===
EqAlign {
    rows: [
        (
            Sqrt {
                index: None,
                body: Text(
                    "x",
                ),
            },
            Row(
                [
                    Symbol(
                        "=",
                    ),
                    Number(
                        "2",
                    ),
                ],
            ),
        ),
        (
            Sqrt {
                index: None,
                body: Text(
                    "y",
                ),
            },
            Row(
                [
                    Symbol(
                        "=",
                    ),
                    Number(
                        "3",
                    ),
                ],
            ),
        ),
    ],
}

