# M09-g equation golden — current-engine lock (variant/exception/unimplemented honesty)
command: OVER
script: EQALIGN{1 OVER 2 &= 3 OVER 6}
honesty: implemented-variant

=== ast ===
EqAlign {
    rows: [
        (
            Fraction {
                numer: Number(
                    "1",
                ),
                denom: Number(
                    "2",
                ),
            },
            Row(
                [
                    Symbol(
                        "=",
                    ),
                    Fraction {
                        numer: Number(
                            "3",
                        ),
                        denom: Number(
                            "6",
                        ),
                    },
                ],
            ),
        ),
    ],
}

