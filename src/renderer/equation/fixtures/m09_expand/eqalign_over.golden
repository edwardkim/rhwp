# M09-g equation golden — current-engine lock (variant/exception/unimplemented honesty)
command: EQALIGN
script: EQALIGN{a OVER b &= c OVER d}
honesty: implemented-variant

=== ast ===
EqAlign {
    rows: [
        (
            Fraction {
                numer: Text(
                    "a",
                ),
                denom: Text(
                    "b",
                ),
            },
            Row(
                [
                    Symbol(
                        "=",
                    ),
                    Fraction {
                        numer: Text(
                            "c",
                        ),
                        denom: Text(
                            "d",
                        ),
                    },
                ],
            ),
        ),
    ],
}

